/datum/game_test/room_test/gs13_native_coated_pill_release/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.notransform = TRUE // Keep unrelated mob Life ticks out of this timer fixture.
	var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	var/obj/item/reagent_containers/pill/pill = allocate(/obj/item/reagent_containers/pill)
	pill.reagents.add_reagent("gs13_ingestion_probe", 10, list("tag" = 42))
	subject.put_in_active_hand(pill)
	TEST_ASSERT_EQUAL(pill.gs13_layers_remaining, 3, "Ordinary native pills receive the pinned source default coating")
	TEST_ASSERT(pill.apply(subject, subject), "Actual native pill consumption accepts the coated physical item")
	TEST_ASSERT_NOT(QDELETED(pill), "A coated pill remains physical until its dose is released")
	TEST_ASSERT_NULL(subject.get_active_hand(), "Actual native consumption clears the former held slot")
	TEST_ASSERT(pill in stomach.gs13_stomach_contents, "The real stomach retains the coated pill")
	TEST_ASSERT_EQUAL(stomach.reagents.total_volume, 0, "Coated medication cannot release before digestion")
	TEST_ASSERT_EQUAL(subject.gs13_test_oral_exposure, 0, "A coating delays actual oral reagent effects")
	stomach.on_life()
	TEST_ASSERT_EQUAL(pill.gs13_layers_remaining, 1, "The real native life callback advances coating by two seconds")
	TEST_ASSERT_NOTNULL(pill.gs13_coating_timer, "A fractional final native tick uses the source guarded timer")
	sleep(1.2 SECONDS)
	TEST_ASSERT(QDELETED(pill), "The native timer cleans up a fully released pill")
	TEST_ASSERT_EQUAL(stomach.reagents.total_volume, 10, "The complete dose enters its actual oral stomach compartment")
	TEST_ASSERT_EQUAL(subject.reagents.total_volume, 0, "Coating release does not inject medicine directly into the blood")
	TEST_ASSERT_EQUAL(subject.gs13_test_oral_exposure, 10, "The actual accepted dose applies its oral effect exactly once")
	stomach.digest_gs13_reagents(2)
	var/datum/reagent/received = subject.reagents.has_reagent("gs13_ingestion_probe")
	TEST_ASSERT_NOTNULL(received, "Ordinary native stomach absorption follows coating release")
	TEST_ASSERT_EQUAL(received.data["tag"], 42, "The delayed dose retains its original reagent data")
	TEST_ASSERT_EQUAL(subject.gs13_test_oral_exposure, 10, "Absorption cannot repeat the oral exposure")

/datum/game_test/room_test/gs13_coated_pill_transplant_and_capacity/Run()
	var/mob/living/carbon/human/donor = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human)
	donor.notransform = TRUE
	recipient.notransform = TRUE
	var/obj/item/organ/internal/gs13_stomach/stomach = donor.get_organ_slot(GS13_ORGAN_STOMACH)
	var/obj/item/reagent_containers/pill/pill = allocate(/obj/item/reagent_containers/pill)
	pill.gs13_layers_remaining = 4
	pill.reagents.add_reagent("gs13_ingestion_probe", 10)
	donor.put_in_active_hand(pill)
	TEST_ASSERT(pill.apply(donor, donor), "A real donor first swallows its physical coated pill")
	stomach.process_gs13_stomach_items(2)
	TEST_ASSERT_EQUAL(pill.gs13_layers_remaining, 2, "The native item callback advances only actual elapsed digestion")
	stomach.remove(donor)
	stomach.forceMove(get_turf(donor))
	stomach.process_gs13_stomach_items(2)
	TEST_ASSERT_EQUAL(pill.gs13_layers_remaining, 2, "An extracted organ cannot digest its retained medication")
	var/obj/item/organ/internal/gs13_stomach/replaced = recipient.get_organ_slot(GS13_ORGAN_STOMACH)
	stomach.insert(recipient)
	replaced.forceMove(get_turf(recipient))
	recipient.death()
	stomach.process_gs13_stomach_items(2)
	TEST_ASSERT_EQUAL(pill.gs13_layers_remaining, 2, "A dead owner cannot advance the coating")
	recipient.update_revive()
	recipient.notransform = TRUE
	stomach.reagents.maximum_volume = 5
	stomach.process_gs13_stomach_items(2)
	TEST_ASSERT_EQUAL(stomach.reagents.total_volume, 5, "A transplanted pill releases only the new owner's actual free capacity")
	TEST_ASSERT_EQUAL(pill.reagents.total_volume, 5, "Backpressure preserves all unaccepted medicine in the actual pill")
	TEST_ASSERT_EQUAL(recipient.gs13_test_oral_exposure, 5, "Only the accepted partial dose reacts on the receiving body")
	stomach.process_gs13_stomach_items(2)
	TEST_ASSERT_EQUAL(pill.reagents.total_volume, 5, "A full stomach cannot consume or discard the retained remainder")
	TEST_ASSERT_EQUAL(recipient.gs13_test_oral_exposure, 5, "Capacity rejection cannot repeat medication exposure")
	stomach.reagents.clear_reagents()
	stomach.process_gs13_stomach_items(2)
	TEST_ASSERT(QDELETED(pill), "Restored capacity allows the exact remainder to finish normally")
	TEST_ASSERT_EQUAL(recipient.gs13_test_oral_exposure, 10, "Both accepted fractions total exactly one original dose")
	TEST_ASSERT_EQUAL(donor.gs13_test_oral_exposure, 0, "A physical transplant cannot medicate its former owner")

/datum/game_test/room_test/gs13_coated_pill_stale_timer/Run()
	var/mob/living/carbon/human/donor = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human)
	donor.notransform = TRUE
	recipient.notransform = TRUE
	var/obj/item/organ/internal/gs13_stomach/stomach = donor.get_organ_slot(GS13_ORGAN_STOMACH)
	var/obj/item/reagent_containers/pill/pill = allocate(/obj/item/reagent_containers/pill)
	pill.reagents.add_reagent("gs13_ingestion_probe", 10)
	donor.put_in_active_hand(pill)
	pill.apply(donor, donor)
	stomach.process_gs13_stomach_items(2)
	stomach.remove(donor)
	stomach.forceMove(get_turf(donor))
	sleep(1.2 SECONDS)
	TEST_ASSERT_NOT(QDELETED(pill), "A stale delayed callback preserves medication in an extracted organ")
	TEST_ASSERT_EQUAL(pill.loc, stomach, "The timer cannot move its recovered physical pill")
	TEST_ASSERT_EQUAL(pill.reagents.total_volume, 10, "The former owner's callback cannot spend the dose")
	TEST_ASSERT_EQUAL(donor.gs13_test_oral_exposure, 0, "The old body cannot receive a delayed oral reaction")
	var/obj/item/organ/internal/gs13_stomach/replaced = recipient.get_organ_slot(GS13_ORGAN_STOMACH)
	stomach.insert(recipient)
	replaced.forceMove(get_turf(recipient))
	stomach.process_gs13_stomach_items(2)
	TEST_ASSERT(QDELETED(pill), "A real transplant can resume its remaining coating and release")
	TEST_ASSERT_EQUAL(recipient.gs13_test_oral_exposure, 10, "Only the current physical recipient receives the preserved dose")

/datum/game_test/room_test/gs13_native_chem_master_coating/Run()
	var/obj/machinery/chem_master/machine = allocate(/obj/machinery/chem_master)
	var/obj/machinery/chem_master/peer = allocate(/obj/machinery/chem_master)
	var/mob/living/carbon/human/chemist = allocate(/mob/living/carbon/human)
	var/datum/chemical_production_mode/pills/mode = machine.production_modes["pills"]
	var/datum/chemical_production_mode/pills/peer_mode = peer.production_modes["pills"]
	TEST_ASSERT_EQUAL(mode.gs13_coating_duration, 3, "Normal native ChemMaster pill production starts at the source three-second coating")
	TEST_ASSERT(machine.set_gs13_pill_coating(99), "The actual native coating control accepts bounded numeric duration")
	TEST_ASSERT_EQUAL(mode.gs13_coating_duration, 30, "Printed coatings use the source thirty-second maximum")
	TEST_ASSERT(machine.set_gs13_pill_coating(-1), "The native coating control supports immediate release")
	TEST_ASSERT_EQUAL(mode.gs13_coating_duration, 0, "Negative requested delay clamps to uncoated medicine")
	TEST_ASSERT(machine.set_gs13_pill_coating("12"), "Native numeric input can select a custom source coating")
	for(var/invalid in list(INFINITY, "invalid", list(12)))
		TEST_ASSERT_NOT(machine.set_gs13_pill_coating(invalid), "Malformed UI duration cannot change actual machine production")
	TEST_ASSERT_EQUAL(mode.gs13_coating_duration, 12, "Invalid input preserves the previous production choice")
	TEST_ASSERT_EQUAL(peer_mode.gs13_coating_duration, 3, "Separate native machines cannot share mutable coating configuration")
	var/list/ui = machine.ui_data(chemist)
	TEST_ASSERT_EQUAL(ui["production_data"]["pills"]["coating_duration"], 12, "The actual native ChemMaster UI reports its current coating choice")
	var/obj/item/storage/pill_bottle/bottle = allocate(/obj/item/storage/pill_bottle)
	machine.reagents.add_reagent("gs13_ingestion_probe", 20)
	mode.set_items_amount = 2
	mode.synthesize(chemist, get_turf(machine), machine.reagents, bottle)
	TEST_ASSERT_EQUAL(length(bottle.contents), 2, "Ordinary native synthesis produces both requested pills into a real pill bottle")
	for(var/obj/item/reagent_containers/pill/pill in bottle)
		TEST_ASSERT_EQUAL(pill.gs13_layers_remaining, 12, "Every normally synthesized pill receives its selected coating")
		TEST_ASSERT_EQUAL(pill.reagents.total_volume, 10, "Coating does not consume or multiply the native per-pill dose")
		var/obj/item/reagent_containers/pill/restored = json_to_object(json_encode(pill.serialize()), get_turf(machine))
		LAZYADD(allocated, restored)
		TEST_ASSERT_EQUAL(restored.gs13_layers_remaining, 12, "Native item JSON preserves its own coating setting")
