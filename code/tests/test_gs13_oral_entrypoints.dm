/datum/reagent/gs13_ingestion_probe/timed
	id = "gs13_ingestion_timer_probe"
	metabolization_rate = 0

/datum/reagent/gs13_ingestion_probe/disconnect
	id = "gs13_ingestion_disconnect_probe"

/datum/reagent/gs13_ingestion_probe/disconnect/reaction_mob(mob/living/subject, method, volume)
	..()
	if(method == REAGENT_INGEST)
		var/obj/machinery/iv_drip/feeding_tube/tube = data?["tube"]
		tube?.detach_iv()

/datum/game_test/room_test/gs13_native_oral_food/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.nutrition = 100
	var/datum/reagents/stomach = gs13_ingested_reagents(subject)
	stomach.maximum_volume = 3
	var/obj/item/food/meal = allocate(/obj/item/food)
	meal.bitesize = 3
	meal.reagents.add_reagent("gs13_ingestion_probe", 6)
	subject.put_in_active_hand(meal)
	meal.interact_with_atom(subject, subject, list())
	TEST_ASSERT_EQUAL(stomach.total_volume, 3, "The native food interaction delivers its bite into the stomach")
	TEST_ASSERT_EQUAL(subject.reagents.total_volume, 0, "Native eating does not immediately inject its food")
	TEST_ASSERT_EQUAL(meal.bitecount, 1, "Accepted intake invokes its food callback exactly once")
	meal.reagents.chem_temp = 400
	meal.interact_with_atom(subject, subject, list())
	TEST_ASSERT_EQUAL(meal.reagents.total_volume, 3, "A full stomach leaves the unaccepted food intact")
	TEST_ASSERT_EQUAL(meal.bitecount, 1, "A rejected bite cannot invoke a food callback")
	TEST_ASSERT_EQUAL(subject.getFireLoss(), 0, "Rejected hot food cannot apply chemical exposure")

/datum/game_test/room_test/gs13_native_oral_drink/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/datum/reagents/stomach = gs13_ingested_reagents(subject)
	stomach.maximum_volume = 7
	var/obj/item/reagent_containers/drinks/drink = allocate(/obj/item/reagent_containers/drinks)
	drink.reagents.add_reagent("gs13_ingestion_probe", 25)
	subject.put_in_active_hand(drink)
	TEST_ASSERT(subject.drink(drink, subject, 5), "The native drink path accepts a normal sip")
	TEST_ASSERT(subject.drink(drink, subject, 25), "A larger sip is clamped to remaining stomach space")
	TEST_ASSERT_EQUAL(stomach.total_volume, 7, "The actual stomach holds both accepted sips")
	TEST_ASSERT_EQUAL(subject.gs13_test_oral_exposure, 7, "Native drinking reacts only the accepted dose, including local drinks")
	TEST_ASSERT_EQUAL(drink.reagents.total_volume, 18, "Remaining drink volume is conserved")
	TEST_ASSERT_NOT(subject.drink(drink, subject, 25), "A full stomach stops ordinary drinking and chugging")
	TEST_ASSERT_EQUAL(subject.reagents.total_volume, 0, "Sips wait for digestion rather than bypassing the compartment")

/datum/game_test/room_test/gs13_native_oral_pill/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/datum/reagents/stomach = gs13_ingested_reagents(subject)
	stomach.maximum_volume = 5
	var/obj/item/reagent_containers/pill/pill = allocate(/obj/item/reagent_containers/pill)
	pill.reagents.add_reagent("gs13_ingestion_probe", 10)
	subject.put_in_active_hand(pill)
	TEST_ASSERT_NOT(pill.apply(subject, subject), "A pill requires space for its entire dose")
	TEST_ASSERT_NOT(QDELETED(pill), "A refused pill stays available")
	TEST_ASSERT_EQUAL(subject.gs13_test_oral_exposure, 0, "A refused pill cannot react on the body")
	stomach.maximum_volume = 20
	TEST_ASSERT(pill.apply(subject, subject), "A fitting pill goes through the actual native apply path")
	TEST_ASSERT(QDELETED(pill), "A fully swallowed pill receives native cleanup")
	TEST_ASSERT_EQUAL(stomach.total_volume, 10, "The swallowed pill starts in the stomach")
	TEST_ASSERT_EQUAL(subject.reagents.total_volume, 0, "Oral medication waits for absorption")

/datum/game_test/room_test/gs13_native_oral_condiment/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/datum/reagents/stomach = gs13_ingested_reagents(subject)
	var/obj/item/reagent_containers/condiment/condiment = allocate(/obj/item/reagent_containers/condiment)
	condiment.reagents.clear_reagents()
	condiment.reagents.add_reagent("gs13_ingestion_probe", 20)
	subject.put_in_active_hand(condiment)
	condiment.mob_act(subject, subject)
	TEST_ASSERT_EQUAL(stomach.total_volume, 10, "Native condiment consumption uses the oral route")
	TEST_ASSERT_EQUAL(condiment.reagents.total_volume, 10, "Only the native ten-unit dose leaves its container")
	TEST_ASSERT_EQUAL(subject.reagents.total_volume, 0, "Condiments do not bypass digestion")

/datum/game_test/room_test/gs13_native_oral_glass_timer/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/datum/reagents/stomach = gs13_ingested_reagents(subject)
	stomach.maximum_volume = 3
	var/obj/item/reagent_containers/glass/beaker/beaker = allocate(/obj/item/reagent_containers/glass/beaker)
	beaker.reagents.add_reagent("gs13_ingestion_timer_probe", 10)
	subject.put_in_active_hand(beaker)
	beaker.mob_act(subject, subject)
	sleep(1 SECONDS)
	TEST_ASSERT_EQUAL(stomach.total_volume, 3, "The real delayed glass-gulp callback resolves current oral capacity")
	TEST_ASSERT_EQUAL(subject.gs13_test_oral_exposure, 3, "Delayed gulp exposure uses only the dose that fits")
	TEST_ASSERT_EQUAL(beaker.reagents.total_volume, 7, "The delayed callback preserves unaccepted supply")
	stomach.clear_reagents()
	beaker.mob_act(subject, subject)
	subject.drop_item_to_ground(beaker)
	sleep(1 SECONDS)
	TEST_ASSERT_EQUAL(stomach.total_volume, 0, "Dropping the source before its callback cancels the queued gulp")
	TEST_ASSERT_EQUAL(subject.gs13_test_oral_exposure, 3, "Canceled delayed intake cannot apply chemical effects")

/datum/game_test/room_test/gs13_native_oral_machine/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/datum/reagents/stomach = gs13_ingested_reagents(subject)
	var/obj/machinery/iv_drip/feeding_tube/tube = allocate(/obj/machinery/iv_drip/feeding_tube, get_turf(subject))
	tube.get_reagents().add_reagent("gs13_ingestion_probe", 30)
	TEST_ASSERT(tube.attach_iv(subject, subject), "The actual feeding-machine connection succeeds")
	tube.process(2)
	TEST_ASSERT_EQUAL(stomach.total_volume, 10, "The oral machine feeds the actual stomach")
	TEST_ASSERT_EQUAL(subject.reagents.total_volume, 0, "The oral machine is distinct from a medical IV")
	var/datum/reagents/supply = tube.get_reagents()
	TEST_ASSERT_EQUAL(supply.total_volume, 20, "Machine intake conserves supply")
	qdel(subject.get_organ_slot(GS13_ORGAN_STOMACH))
	tube.process(2)
	TEST_ASSERT_NULL(tube.connected_target, "Loss of the actual digestive organ stops the oral connection")
	TEST_ASSERT_EQUAL(supply.total_volume, 20, "An absent stomach cannot silently reroute machine feeding into the blood")

/datum/game_test/room_test/gs13_native_injection_stays_blood/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/datum/reagents/stomach = gs13_ingested_reagents(subject)
