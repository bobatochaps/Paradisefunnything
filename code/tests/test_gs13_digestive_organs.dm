/datum/game_test/room_test/gs13_stomach_species_and_slots/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	TEST_ASSERT_NOTNULL(stomach, "The ordinary native human layout supplies a physical stomach")
	TEST_ASSERT(stomach.icon_state in icon_states(stomach.icon), "The stomach uses its unchanged source artwork")
	var/obj/item/organ/external/chest = subject.get_organ(BODY_ZONE_CHEST)
	TEST_ASSERT(stomach in chest.internal_organs, "Native surgery can find the stomach in the chest")
	var/obj/item/organ/internal/cyberimp/chest/nutriment/turbo/pump = allocate(/obj/item/organ/internal/cyberimp/chest/nutriment/turbo)
	pump.insert(subject)
	TEST_ASSERT_EQUAL(subject.get_organ_slot("stomach"), pump, "The existing native nutriment implant keeps its slot")
	TEST_ASSERT_EQUAL(subject.get_organ_slot(GS13_ORGAN_STOMACH), stomach, "The implant does not replace physical digestive anatomy")
	for(var/species_path in list(/datum/species/skrell, /datum/species/diona, /datum/species/monkey))
		subject.set_species(species_path)
		TEST_ASSERT_NOTNULL(subject.get_organ_slot(GS13_ORGAN_STOMACH), "Existing organic digestive layouts retain a stomach through native species changes")
	for(var/species_path in list(/datum/species/machine, /datum/species/golem, /datum/species/shadow))
		subject.set_species(species_path)
		TEST_ASSERT_NULL(subject.get_organ_slot(GS13_ORGAN_STOMACH), "Reduced and synthetic native layouts do not acquire an invented organic stomach")

/datum/game_test/room_test/gs13_stomach_lifecycle/Run()
	var/mob/living/carbon/human/donor = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/gs13_stomach/stomach = donor.get_organ_slot(GS13_ORGAN_STOMACH)
	stomach.receive_damage(30, TRUE)
	stomach.remove(donor)
	stomach.forceMove(get_turf(donor))
	TEST_ASSERT_NULL(donor.get_organ_slot(GS13_ORGAN_STOMACH), "Extraction clears the donor's digestive slot")
	TEST_ASSERT_NULL(stomach.owner, "A removed stomach has no retained owner")
	var/obj/item/organ/internal/gs13_stomach/replaced = recipient.get_organ_slot(GS13_ORGAN_STOMACH)
	stomach.insert(recipient)
	TEST_ASSERT_EQUAL(stomach.owner, recipient, "Native transplantation changes ownership")
	TEST_ASSERT_EQUAL(stomach.damage, 30, "Transplantation preserves the actual organ injury")
	TEST_ASSERT_NULL(replaced.owner, "Replacement detaches the previous organ")
	replaced.forceMove(get_turf(recipient))
	recipient.death()
	recipient.update_revive()
	TEST_ASSERT_EQUAL(recipient.get_organ_slot(GS13_ORGAN_STOMACH), stomach, "Death and revival keep the body's actual stomach")
	qdel(stomach)
	TEST_ASSERT_NULL(recipient.get_organ_slot(GS13_ORGAN_STOMACH), "Deleting the organ clears its slot")
	var/obj/item/organ/external/chest = recipient.get_organ(BODY_ZONE_CHEST)
	TEST_ASSERT_NOT(stomach in chest.internal_organs, "Deletion removes the native parent-organ reference")

/datum/game_test/room_test/gs13_stomach_native_treatment/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	stomach.receive_damage(30, TRUE)
	var/mob/living/carbon/human/surgeon = allocate(/mob/living/carbon/human, get_turf(subject))
	var/obj/item/stack/medical/bruise_pack/advanced/membrane = allocate(/obj/item/stack/medical/bruise_pack/advanced)
	var/datum/surgery_step/internal/manipulate_organs/mend/treatment = new
	TEST_ASSERT(stomach in treatment.get_organ_list(BODY_ZONE_CHEST, subject, subject.get_organ(BODY_ZONE_CHEST)), "The ordinary surgery selector includes the new organ")
	treatment.end_step(surgeon, subject, BODY_ZONE_CHEST, membrane)
	TEST_ASSERT_EQUAL(stomach.damage, 0, "The actual native organ-mending step repairs burst injury")
	qdel(treatment)
	stomach.receive_damage(100, TRUE)
	TEST_ASSERT(stomach.status & ORGAN_DEAD, "Critical fullness trauma can destroy the stomach")
	stomach.rejuvenate()
	TEST_ASSERT_EQUAL(stomach.damage, 0, "Native rejuvenation repairs the damaged organ")
	TEST_ASSERT_NOT(stomach.status & ORGAN_DEAD, "Native rejuvenation also restores a destroyed organ's function")

/datum/game_test/room_test/gs13_stomach_fullness_burst/Run()
	for(var/mode in list("Injure", "Critical"))
		var/mob/living/carbon/human/subject = gs13_burst_subject(GS13_BURST_GLUTTON)
		subject.gs13_preferences["glutton_bursting_type"] = mode
		subject.gs13_preferences["glutton_fatness_before_burst"] = 0
		subject.gs13_preferences["glutton_fullness_before_burst"] = 300
		subject.nutrition = 1080
		var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
		var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
		var/token = gs13_confirm_glutton(controller)
		controller.finish_preparation(token)
		TEST_ASSERT(controller.complete_burst(token), "An over-full body resolves its confirmed native burst")
		TEST_ASSERT_EQUAL(stomach.damage, mode == "Injure" ? 30 : 100, "Fullness trauma follows the source thirty/hundred stomach damage")
		TEST_ASSERT_EQUAL(subject.get_organ_slot(GS13_ORGAN_STOMACH), stomach, "Burst recovery does not replace the injured organ")

/datum/game_test/room_test/gs13_stomach_burst_boundaries/Run()
	for(var/scenario in list("exact", "fat", "safe", "missing"))
		var/mob/living/carbon/human/subject = gs13_burst_subject(GS13_BURST_GLUTTON)
		subject.gs13_preferences["glutton_bursting_type"] = scenario == "safe" ? "Safe" : "Injure"
		subject.gs13_preferences["glutton_fullness_before_burst"] = 300
		subject.nutrition = scenario == "exact" ? 1050 : (scenario == "fat" ? 500 : 1080)
		var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
		if(scenario == "missing")
			qdel(stomach)
		var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
		var/token = gs13_confirm_glutton(controller)
		controller.finish_preparation(token)
		TEST_ASSERT(controller.complete_burst(token), "Exact/full/fat/safe and missing-organ cases resolve through the real burst path")
		if(scenario == "missing")
			TEST_ASSERT_NULL(subject.get_organ_slot(GS13_ORGAN_STOMACH), "Bursting cannot invent a surgically absent stomach")
		else
			TEST_ASSERT_EQUAL(stomach.damage, 0, "Only strictly over-full injury modes damage a stomach")

/datum/game_test/room_test/gs13_stomach_food_response/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	subject.nutrition = 500
	subject.reagents.add_reagent("nutriment", 100)
	stomach.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, 500, "An undamaged stomach leaves ordinary food handling unchanged")
	stomach.receive_damage(30, TRUE)
	stomach.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, 470, "A large pending food dose provokes the source injury response through native vomiting")
	subject.reagents.del_reagent("nutriment")
	stomach.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, 470, "An empty body holder cannot provoke food-triggered vomiting")
	subject.reagents.add_reagent("nutriment", 100)
	subject.death()
	stomach.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, 470, "A dead body's retained food cannot trigger live digestive effects")
	stomach.remove(subject)
	stomach.forceMove(get_turf(subject))
	stomach.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, 470, "An extracted organ cannot affect its former owner")
