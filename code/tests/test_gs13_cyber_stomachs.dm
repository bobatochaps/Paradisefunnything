/datum/game_test/room_test/gs13_cyber_stomach_native_metabolism/Run()
	var/list/variants = list(/obj/item/organ/internal/gs13_stomach/cybernetic = list(50, 1.2), /obj/item/organ/internal/gs13_stomach/cybernetic/tier2 = list(150, 1.9), /obj/item/organ/internal/gs13_stomach/cybernetic/tier3 = list(200, 2.5))
	for(var/organ_type in variants)
		var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
		var/obj/item/organ/internal/gs13_stomach/replaced = subject.get_organ_slot(GS13_ORGAN_STOMACH)
		var/obj/item/organ/internal/gs13_stomach/cybernetic/stomach = allocate(organ_type)
		stomach.insert(subject)
		replaced.forceMove(get_turf(subject))
		TEST_ASSERT(stomach.is_robotic(), "Each real source prosthesis participates in the native electronic-organ lifecycle")
		TEST_ASSERT_EQUAL(stomach.max_damage, variants[organ_type][1], "The actual prosthesis retains its source maximum health")
		TEST_ASSERT(stomach.icon_state in icon_states(stomach.icon), "Each prosthesis uses its unchanged source icon state")
		var/obj/item/reagent_containers/glass/beaker/supply = allocate(/obj/item/reagent_containers/glass/beaker)
		supply.reagents.add_reagent("gs13_ingestion_probe", 10)
		TEST_ASSERT_EQUAL(supply.reagents.gs13_ingest(subject, 10), 10, "A normally transplanted prosthesis receives actual native oral intake")
		TEST_ASSERT_EQUAL(subject.reagents.total_volume, 0, "Prosthetic intake still uses the separate physical digestive compartment")
		TEST_ASSERT(abs(stomach.digest_gs13_reagents(2) - variants[organ_type][2]) < 0.001, "Each native prosthesis actually absorbs at its distinct source rate")
		TEST_ASSERT(abs(stomach.reagents.total_volume + subject.reagents.total_volume - 10) < 0.001, "Electronic digestion conserves the accepted original dose")
		stomach.receive_damage(10, TRUE)
		TEST_ASSERT_EQUAL(stomach.heal_gs13_tissue(2), 0, "Organic tissue recovery cannot repair a native prosthesis")
		stomach.emp_act(EMP_HEAVY)
		TEST_ASSERT(stomach.damage > 10, "The source prosthesis remains subject to actual native electronic-organ EMP injury")
		var/obj/item/stack/nanopaste/paste = allocate(/obj/item/stack/nanopaste)
		stomach.item_interaction(subject, paste, list())
		TEST_ASSERT_EQUAL(stomach.damage, 0, "The actual native nanopaste interaction repairs its electronic tissue")
		TEST_ASSERT(stomach.is_robotic(), "Native repair cannot turn a prosthesis into an organic organ")

/datum/game_test/room_test/gs13_cyber_stomach_native_research/Run()
	var/datum/research/research = allocate(/datum/research)
	var/list/ids = list("gs13_cybernetic_stomach", "gs13_cybernetic_stomach_tier2", "gs13_cybernetic_stomach_tier3")
	for(var/id in ids)
		TEST_ASSERT_NOT(research.known_designs[id], "Ordinary initialization cannot bypass the native prosthetic-organ research requirements")
	for(var/id in research.known_tech)
		var/datum/tech/technology = research.known_tech[id]
		technology.level = 6
	research.RefreshResearch()
	var/obj/machinery/r_n_d/protolathe/lathe = allocate(/obj/machinery/r_n_d/protolathe)
	var/obj/machinery/computer/rdconsole/console = allocate(/obj/machinery/computer/rdconsole)
	for(var/material in list(MAT_METAL, MAT_GLASS, MAT_SILVER))
		lathe.materials.insert_amount(2000, material)
	for(var/id in ids)
		var/datum/design/design = research.known_designs[id]
		TEST_ASSERT_NOTNULL(design, "Actual native research unlocks each of the three source prosthetic-organ tiers")
		TEST_ASSERT((design.build_type & PROTOLATHE) && (design.build_type & MECHFAB), "The design participates in the ordinary native medical fabrication catalogs")
		TEST_ASSERT("Medical" in design.category, "The organ appears in the real native Medical production category")
		TEST_ASSERT(lathe.materials.has_materials(design.materials), "Ordinary native sheet materials satisfy the actual prosthetic design")
		lathe.materials.use_amount(design.materials)
		console.finish_machine("gs13_test", 1, TRUE, lathe, design, design.materials)
		var/obj/item/organ/internal/gs13_stomach/cybernetic/produced
		for(var/obj/item/organ/internal/gs13_stomach/cybernetic/candidate in lathe.loc)
			if(candidate.type == design.build_path)
				produced = candidate
				break
		TEST_ASSERT_NOTNULL(produced, "The actual native R&D production callback constructs its selected physical organ")
		LAZYADD(allocated, produced)
		TEST_ASSERT(produced.is_robotic(), "Ordinary production creates a functional native prosthesis")
	TEST_ASSERT_EQUAL(lathe.materials.amount(MAT_METAL), 500, "All three native designs consume their required metal exactly once")
	TEST_ASSERT_EQUAL(lathe.materials.amount(MAT_GLASS), 500, "All three native designs consume their required glass exactly once")
	TEST_ASSERT_EQUAL(lathe.materials.amount(MAT_SILVER), 1500, "Only the source highest tier consumes its additional silver")
