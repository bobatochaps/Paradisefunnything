/datum/game_test/room_test/proc/gs13_classic_pair_subject()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/datum/character_save/character = allocate(/datum/character_save)
	character.gs13_preferences = gs13_sanitize_preferences(list("custom_anatomy" = TRUE, "anatomy_breasts" = TRUE, "anatomy_body_sprites" = TRUE, "breasts_style" = "Classic", "breasts_size" = 2))
	character.apply_gs13_preferences(subject)
	return subject

/datum/game_test/room_test/gs13_classic_pair_creation_and_dna/Run()
	var/list/defaults = gs13_default_preferences()
	TEST_ASSERT_EQUAL(defaults["breasts_style"], "Smooth", "Older characters keep the existing compatible paired sheet")
	var/list/saved = gs13_sanitize_preferences(json_encode(list("breasts_style" = "Classic")))
	TEST_ASSERT_EQUAL(saved["breasts_style"], "Classic", "The actual character JSON path retains the source accessory style")
	for(var/bad_style in list("invalid", TRUE, list("Classic")))
		var/list/clean = gs13_sanitize_preferences(list("breasts_style" = bad_style))
		TEST_ASSERT_EQUAL(clean["breasts_style"], "Smooth", "Malformed style cannot select undefined source artwork")
	var/mob/living/carbon/human/subject = gs13_classic_pair_subject()
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/breasts = subject.get_organ_slot(GS13_ORGAN_BREASTS)
	TEST_ASSERT_EQUAL(breasts.gs13_visual_style, "Classic", "Actual native character creation configures the physical donor organ")
	TEST_ASSERT_EQUAL(subject.dna.gs13_anatomy["breasts_style"], "Classic", "Creation DNA retains the accessory choice")
	TEST_ASSERT_NOT("anatomy_body_sprites" in subject.dna.gs13_anatomy, "A new physical style cannot acquire the body's separate visual permission")
	var/datum/dna/copied = subject.dna.Clone()
	LAZYADD(allocated, copied)
	copied.gs13_anatomy["breasts_style"] = "Smooth"
	TEST_ASSERT_EQUAL(subject.dna.gs13_anatomy["breasts_style"], "Classic", "Native DNA clones keep independent accessory snapshots")
	var/list/data = subject.dna.serialize()
	data["gs13_anatomy"] = json_decode(json_encode(data["gs13_anatomy"]))
	var/datum/dna/restored = allocate(/datum/dna)
	restored.deserialize(data)
	TEST_ASSERT_EQUAL(restored.gs13_anatomy["breasts_style"], "Classic", "Native DNA serialization restores its own source style")

/datum/game_test/room_test/gs13_classic_pair_native_rendering/Run()
	var/mob/living/carbon/human/subject = gs13_classic_pair_subject()
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/breasts = subject.get_organ_slot(GS13_ORGAN_BREASTS)
	for(var/size in list(0.5, 2, 9, 18, 80))
		breasts.gs13_base_size = size
		breasts.update_size_from_weight(0)
		subject.update_gs13_weight_appearance(TRUE)
		var/frame = FLOOR(min(size, 18), 1)
		TEST_ASSERT("m_breasts_pair_gs_[frame]_FRONT" in gs13_weight_panel_states(subject), "Every actual classic size selects its bounded original source front artwork")
		TEST_ASSERT_NOT("m_breasts_pair_gs_smooth_[frame]_FRONT" in gs13_weight_panel_states(subject), "A physical classic organ cannot silently select the default smooth sheet")
		TEST_ASSERT_EQUAL(breasts.gs13_size, size, "The source artwork ceiling cannot rewrite physical organ size")
		for(var/mutable_appearance/part as anything in subject.overlays_standing[GS13_WEIGHT_BODY_LAYER])
			TEST_ASSERT(icon_exists(part.icon, part.icon_state), "Every selected classic front/back state exists in the unchanged source sheet")
		if(size == 2 || size == 9 || size == 18)
			gs13_render_weight_preview(subject, "anatomy_classic_pair_[size]")
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey)
	subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT)
	TEST_ASSERT("breasts_impossible" in gs13_weight_panel_states(subject), "Classic anatomy uses the source's same numeric modular-uniform contract")
	TEST_ASSERT_NOT("m_breasts_pair_gs_18_FRONT" in gs13_weight_panel_states(subject), "Ordinary native uniform coverage hides the actual classic body sheet")
	gs13_render_weight_preview(subject, "anatomy_classic_uniform")
	TEST_ASSERT(uniform.roll_undersuit(subject), "The real native uniform action exposes the current classic anatomy")
	TEST_ASSERT("m_breasts_pair_gs_18_FRONT" in gs13_weight_panel_states(subject), "Rolling reveals the actual physical accessory style")
	gs13_render_weight_preview(subject, "anatomy_classic_uniform_rolled")
	breasts.gs13_visual_style = "Smooth"
	subject.update_gs13_weight_appearance()
	TEST_ASSERT("m_breasts_pair_gs_smooth_18_FRONT" in gs13_weight_panel_states(subject), "The native cache includes the actual organ style even at unchanged size")

/datum/game_test/room_test/gs13_classic_pair_physical_ownership/Run()
	var/mob/living/carbon/human/donor = gs13_classic_pair_subject()
	var/mob/living/carbon/human/recipient = gs13_fluid_subject()
	recipient.gs13_preferences["anatomy_body_sprites"] = TRUE
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/breasts = donor.get_organ_slot(GS13_ORGAN_BREASTS)
	breasts.internal_fluid_datum = /datum/reagent/consumable/starshine/blue
	breasts.reagents.add_reagent("water", 10)
	breasts.remove(donor)
	breasts.forceMove(get_turf(donor))
	TEST_ASSERT_NULL(donor.overlays_standing[GS13_WEIGHT_BODY_LAYER], "Extraction releases the former body's owned classic appearance")
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/replaced = recipient.get_organ_slot(GS13_ORGAN_BREASTS)
	breasts.insert(recipient)
	replaced.forceMove(get_turf(recipient))
	TEST_ASSERT_EQUAL(recipient.gs13_preferences["breasts_style"], "Smooth", "A physical transplant cannot replace the receiving character's future birth preference")
	TEST_ASSERT("m_breasts_pair_gs_2_FRONT" in gs13_weight_panel_states(recipient), "A real native transplant renders its own donor style independently of the recipient's policy")
	var/datum/character_save/character = allocate(/datum/character_save)
	character.gs13_preferences = recipient.gs13_preferences.Copy()
	character.gs13_preferences["breasts_style"] = "Classic"
	character.apply_gs13_preferences(recipient, FALSE)
	character.gs13_preferences["breasts_style"] = "Smooth"
	character.apply_gs13_preferences(recipient, FALSE)
	TEST_ASSERT_EQUAL(recipient.get_organ_slot(GS13_ORGAN_BREASTS), breasts, "A next-spawn style edit cannot rebuild the live physical organ")
	TEST_ASSERT_EQUAL(breasts.gs13_visual_style, "Classic", "A future birth choice cannot overwrite actual transplant appearance")
	TEST_ASSERT_EQUAL(breasts.fluid_id(), "starshine_blue", "Style editing preserves the actual organ's persistent chemical production state")
	TEST_ASSERT_EQUAL(breasts.reagents.get_reagent_amount("water"), 10, "Style editing preserves actual retained fluid")
	recipient.death()
	recipient.update_revive()
	TEST_ASSERT_EQUAL(recipient.get_organ_slot(GS13_ORGAN_BREASTS), breasts, "Native revival preserves the same physical classic organ")
	TEST_ASSERT("m_breasts_pair_gs_2_FRONT" in gs13_weight_panel_states(recipient), "Revival retains the body's independent visual permission and physical style")
	qdel(breasts)
	TEST_ASSERT_NULL(recipient.overlays_standing[GS13_WEIGHT_BODY_LAYER], "Actual native organ deletion releases the complete classic appearance")
