/datum/game_test/room_test/proc/gs13_burst_subject(kind = GS13_BURST_BLUEBERRY)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	if(kind == GS13_BURST_BLUEBERRY)
		subject.gs13_preferences["blueberry_inflation"] = TRUE
		subject.gs13_preferences["blueberry_max_before_burst"] = 50
		subject.gs13_preferences["see_bursting"] = TRUE
		subject.gs13_preferences["automatic_bursting"] = TRUE
		subject.reagents.add_reagent("blueberry_juice", 100)
	else
		subject.gs13_preferences["glutton_fatness_before_burst"] = 1000
		subject.gs13_preferences["glutton_bursting_type"] = "Safe"
		subject.gs13_preferences["glutton_see_bursting"] = TRUE
		subject.adjust_fatness(1200, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.handle_gs13_bursting(0)
	return subject

// Supply the result of the in-game confirmation dialog to the real callback.
/datum/game_test/room_test/proc/gs13_confirm_glutton(datum/component/gs13_bursting/controller)
	controller.pending_kind = GS13_BURST_GLUTTON
	controller.pending_state = "prompt"
	var/token = ++controller.generation
	controller.begin_preparation(GS13_BURST_GLUTTON, token)
	return token

/datum/game_test/room_test/gs13_burst_preferences/Run()
	var/list/defaults = gs13_default_preferences()
	TEST_ASSERT(defaults["safe_bursting"], "Blueberry bursting defaults to survival")
	TEST_ASSERT_NOT(defaults["see_bursting"] || defaults["automatic_bursting"], "Viewing and automatic bursting default to disabled")
	TEST_ASSERT_EQUAL(defaults["glutton_bursting_type"], "Disabled", "Old characters cannot acquire a glutton outcome implicitly")
	var/list/settings = gs13_sanitize_preferences(json_encode(list("blueberry_max_before_burst" = 123.5, "blueberry_lives" = 2.8, "glutton_bursting_type" = "Critical", "safe_bursting" = FALSE)))
	TEST_ASSERT_EQUAL(settings["blueberry_max_before_burst"], 123.5, "Juice capacity survives the character JSON path")
	TEST_ASSERT_EQUAL(settings["blueberry_lives"], 2, "Life allowances use whole counts")
	TEST_ASSERT_EQUAL(settings["glutton_bursting_type"], "Critical", "The selected outcome survives the character JSON path")
	TEST_ASSERT_NOT(settings["safe_bursting"], "An explicit survival setting is preserved")
	settings = gs13_sanitize_preferences(list("glutton_bursting_type" = "unknown", "blueberry_lives" = -1, "blueberry_max_before_burst" = INFINITY))
	TEST_ASSERT_EQUAL(settings["glutton_bursting_type"], "Disabled", "Invalid outcomes remain disabled")
	TEST_ASSERT_EQUAL(settings["blueberry_lives"], 0, "Negative life allowances are rejected")
	TEST_ASSERT_EQUAL(settings["blueberry_max_before_burst"], 0, "Infinite capacities cannot enter body state")

/datum/game_test/room_test/gs13_blueberry_capacity/Run()
	TEST_ASSERT_EQUAL(gs13_blueberry_capacity_stage(0), 0, "An empty dose has no capacity stage")
	TEST_ASSERT_EQUAL(gs13_blueberry_capacity_stage(0.4), 1, "The first source interval includes its upper boundary")
	TEST_ASSERT_EQUAL(gs13_blueberry_capacity_stage(0.4001), 2, "Capacity advances above forty percent")
	TEST_ASSERT_EQUAL(gs13_blueberry_capacity_stage(0.7), 2, "The second interval includes seventy percent")
	TEST_ASSERT_EQUAL(gs13_blueberry_capacity_stage(0.9), 3, "The third interval includes ninety percent")
	TEST_ASSERT_EQUAL(gs13_blueberry_capacity_stage(0.9001), 4, "The final interval starts above ninety percent")
	var/mob/living/carbon/human/subject = gs13_burst_subject()
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	TEST_ASSERT_EQUAL(controller.blueberry_ratio, 2, "Capacity uses actual juice volume, independently of apparent weight caps")
	subject.max_weight = 101
	subject.calculate_fatness()
	TEST_ASSERT_EQUAL(controller.blueberry_ratio, 2, "Concealing or capping apparent weight cannot alter retained fluid pressure")
	subject.reagents.remove_reagent("blueberry_juice", 50)
	TEST_ASSERT_NOT(controller.can_burst(GS13_BURST_BLUEBERRY), "The blueberry source requires strictly more than its capacity")

/datum/game_test/room_test/gs13_glutton_capacity/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject(GS13_BURST_GLUTTON)
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	subject.fatness_real = 600
	subject.calculate_fatness()
	TEST_ASSERT(abs(controller.fatness_ratio) < 0.001, "Fat feedback starts at sixty percent of the selected threshold")
	subject.adjust_fatness(200, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT(abs(controller.fatness_ratio - 0.5) < 0.001, "The source fatness interval is normalized consistently")
	subject.adjust_fatness(200, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT(controller.can_burst(GS13_BURST_GLUTTON), "Glutton bursting includes its exact configured fatness boundary")
	subject.gs13_preferences["glutton_fatness_before_burst"] = 0
	subject.gs13_preferences["glutton_fullness_before_burst"] = 300
	subject.nutrition = 1050
	controller.on_changed()
	TEST_ASSERT_EQUAL(subject.bursting_capacity_fullness, 1, "Fullness capacity is measured above the source's 750 baseline")
	TEST_ASSERT_EQUAL(subject.bursting_capacity_fatness, -1, "A disabled capacity retains the source sentinel")
	TEST_ASSERT(controller.can_burst(GS13_BURST_GLUTTON), "Fullness can trigger independently of fatness")

/datum/game_test/room_test/gs13_blueberry_safe_burst/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject()
	subject.adjust_fatness(500, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.adjust_perma(30, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	TEST_ASSERT(controller.request_burst(GS13_BURST_BLUEBERRY), "An opted-in automatic burst starts a countdown")
	var/token = controller.generation
	TEST_ASSERT_EQUAL(controller.pending_state, "preparing", "The burst does not resolve before its countdown")
	TEST_ASSERT(controller.finish_preparation(token), "The confirmed native callback resolves a safe burst")
	TEST_ASSERT_NOT(QDELETED(subject), "Safe bursting preserves the body")
	TEST_ASSERT_EQUAL(subject.times_blueberry_bursted, 1, "A successful safe burst uses exactly one life count")
	TEST_ASSERT_EQUAL(subject.fatness, 530, "Safe bursting removes only juice-derived mass")
	TEST_ASSERT_NULL(subject.color, "Safe bursting restores the underlying body color")
	var/obj/effect/decal/cleanable/gs13_juice/puddle = locate() in get_turf(subject)
	TEST_ASSERT_NOTNULL(puddle, "Bursting leaves the original source juice decal")
	TEST_ASSERT_EQUAL(puddle.reagents.get_reagent_amount("blueberry_juice"), 100, "The expelled dose is conserved on the floor")
	TEST_ASSERT_NOT(controller.finish_preparation(token), "The completed callback cannot apply twice")
	TEST_ASSERT_NOT(controller.request_burst(GS13_BURST_BLUEBERRY), "A completed burst respects its cooldown and empty dose")

/datum/game_test/room_test/gs13_blueberry_safe_lives/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject()
	subject.gs13_preferences["safe_bursting"] = FALSE
	subject.gs13_preferences["blueberry_lives"] = 1
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	TEST_ASSERT(subject.gs13_blueberry_burst_is_safe(), "The configured allowance protects its first burst")
	controller.request_burst(GS13_BURST_BLUEBERRY)
	controller.finish_preparation(controller.generation)
	TEST_ASSERT_EQUAL(subject.times_blueberry_bursted, 1, "A finite safe allowance increments the body's counter")
	TEST_ASSERT_NOT(subject.gs13_blueberry_burst_is_safe(), "An exhausted allowance cannot protect another burst")
	subject.times_blueberry_bursted = 3
	TEST_ASSERT_NOT(subject.gs13_blueberry_burst_is_safe(), "A negative remaining allowance cannot become truthy extra lives")
	subject.gs13_preferences["safe_bursting"] = TRUE
	TEST_ASSERT(subject.gs13_blueberry_burst_is_safe(), "Always-survive mode remains independent of the finite allowance")

/datum/game_test/room_test/gs13_burst_recovery_cancels/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject()
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	controller.request_burst(GS13_BURST_BLUEBERRY)
	var/token = controller.generation
	subject.reagents.remove_reagent("blueberry_juice", 60)
	TEST_ASSERT_NULL(controller.pending_kind, "Draining below capacity cancels the pending effect immediately")
	TEST_ASSERT_NULL(controller.pending_timer, "Recovery cancels the owned timer")
	TEST_ASSERT_NOT(controller.finish_preparation(token), "An old callback cannot burst a recovered body")
	TEST_ASSERT_EQUAL(subject.reagents.get_reagent_amount("blueberry_juice"), 40, "A canceled callback cannot discard the remaining juice")
	TEST_ASSERT_EQUAL(subject.times_blueberry_bursted, 0, "Canceled bursts do not use the safe allowance")

/datum/game_test/room_test/gs13_burst_preference_changes/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject()
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	controller.request_burst(GS13_BURST_BLUEBERRY)
	var/token = controller.generation
	subject.gs13_preferences["safe_bursting"] = FALSE
	subject.refresh_gs13_bursting()
	TEST_ASSERT_NULL(controller.pending_kind, "Changing the accepted outcome cancels the earlier confirmation")
	TEST_ASSERT_NOT(controller.finish_preparation(token), "A previously safe confirmation cannot execute a newly fatal setting")
	TEST_ASSERT_NOT(QDELETED(subject), "The canceled outcome change preserves the body")
	subject.gs13_preferences["blueberry_max_before_burst"] = 0
	subject.handle_gs13_bursting(0)
	TEST_ASSERT(QDELETED(controller), "Disabling the final threshold releases capacity state")
	TEST_ASSERT_EQUAL(subject.bursting_capacity_percentage, -1, "Released capacity state resets the source sentinel")
	TEST_ASSERT_EQUAL(subject.reagents.get_reagent_amount("blueberry_juice"), 100, "Disabling bursting does not disable the independent transformation")

/datum/game_test/room_test/gs13_burst_context_interruptions/Run()
	for(var/event in list("move", "logout", "death", "field"))
		var/mob/living/carbon/human/subject = gs13_burst_subject()
		var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
		controller.request_burst(GS13_BURST_BLUEBERRY)
		var/token = controller.generation
		switch(event)
			if("move")
				subject.forceMove(get_step(get_turf(subject), EAST))
			if("logout")
				SEND_SIGNAL(subject, COMSIG_MOB_LOGOUT)
			if("death")
				subject.death()
			if("field")
				ADD_TRAIT(subject, TRAIT_NO_BURST, "independent")
		TEST_ASSERT_NULL(controller.pending_kind, "Movement, disconnect, death, and field activation cancel preparation")
		TEST_ASSERT_NOT(controller.finish_preparation(token), "Interrupted timers cannot subsequently execute")
		TEST_ASSERT_EQUAL(subject.times_blueberry_bursted, 0, "Interruptions preserve the safe burst count")

/datum/game_test/room_test/gs13_burst_viewpoint_preferences/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject()
	var/mob/living/carbon/human/viewer = allocate(/mob/living/carbon/human, get_turf(subject))
	TEST_ASSERT_NOT(subject.gs13_burst_viewpoint_allows(viewer, GS13_BURST_BLUEBERRY), "A visible viewer defaults to disallowing blueberry bursts")
	viewer.gs13_preferences["see_bursting"] = TRUE
	TEST_ASSERT(subject.gs13_burst_viewpoint_allows(viewer, GS13_BURST_BLUEBERRY), "A viewer's explicit blueberry opt-in is recognized")
	TEST_ASSERT_NOT(subject.gs13_burst_viewpoint_allows(viewer, GS13_BURST_GLUTTON), "The two viewing preferences remain independent")
	viewer.moveToNullspace()
	TEST_ASSERT(subject.gs13_burst_viewpoint_allows(viewer, GS13_BURST_GLUTTON), "A viewpoint with no visible location cannot block a distant effect")
	subject.gs13_preferences["see_bursting"] = FALSE
	TEST_ASSERT_NOT(subject.gs13_burst_viewers_allow(GS13_BURST_BLUEBERRY), "The subject's own viewing setting is always respected")

/datum/game_test/room_test/gs13_glutton_safe_burst/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject(GS13_BURST_GLUTTON)
	subject.adjust_perma(200, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.nutrition = 1200
	subject.gs13_preferences["glutton_fullness_before_burst"] = 300
	subject.reagents.add_reagent("salglu_solution", 5)
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	var/token = gs13_confirm_glutton(controller)
	TEST_ASSERT(controller.finish_preparation(token), "The confirmed preparation enters the source swelling stage")
	TEST_ASSERT(subject.gs13_burst_swell, "The swelling stage owns an explicit native render multiplier")
	TEST_ASSERT(controller.complete_burst(token), "A safe glutton burst resolves through the native callback")
	TEST_ASSERT_EQUAL(subject.fatness, 450, "Regular then permanent fat are reduced to the source buffer target")
	TEST_ASSERT_EQUAL(subject.fatness_perma, 200, "Permanent fat is preserved when ordinary fat supplies the full reduction")
	TEST_ASSERT_EQUAL(subject.reagents.total_volume, 0, "The single native reagent holder is cleared through proper deletion")
	TEST_ASSERT(subject.get_fullness() < FULLNESS_LEVEL_BLOATED, "Safe bursting clears overeating without retriggering")
	TEST_ASSERT_EQUAL(subject.getBruteLoss(), 0, "Safe mode adds no burst trauma")
	TEST_ASSERT_NOT(subject.gs13_burst_swell, "Completion removes the owned render multiplier")

/datum/game_test/room_test/gs13_glutton_injury_modes/Run()
	for(var/mode in list("Injure", "Critical"))
		var/mob/living/carbon/human/subject = gs13_burst_subject(GS13_BURST_GLUTTON)
		subject.gs13_preferences["glutton_bursting_type"] = mode
		var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
		var/token = gs13_confirm_glutton(controller)
		controller.finish_preparation(token)
		TEST_ASSERT(controller.complete_burst(token), "Both injury choices resolve through the native body damage system")
		TEST_ASSERT(subject.getBruteLoss() >= (mode == "Injure" ? 60 : 150), "Chest and over-capacity limb trauma follow the selected source outcome")
		TEST_ASSERT_NOT(QDELETED(subject), "Injury modes retain a medical body")

/datum/game_test/room_test/gs13_burst_resize_cleanup/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject(GS13_BURST_GLUTTON)
	subject.resize = 0.8
	subject.update_transform()
	sleep(3)
	subject.set_gs13_body_size(1.5)
	sleep(3)
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	var/token = gs13_confirm_glutton(controller)
	controller.finish_preparation(token)
	sleep(3)
	TEST_ASSERT(abs(subject.gs13_render_size() - 1.2) < 0.001, "Temporary swelling is excluded from the base render-size contract")
	subject.set_gs13_body_size(2)
	sleep(3)
	controller.cancel_pending()
	sleep(3)
	TEST_ASSERT(abs(subject.gs13_render_size() - 1.6) < 0.001, "Cancellation preserves native shrinking and a body-size edit made during swelling")
	var/matrix/appearance_transform = subject.transform
	TEST_ASSERT(abs(appearance_transform.a - 1.6) < 0.001 && abs(appearance_transform.e - 1.6) < 0.001, "No burst axis multiplier remains after recovery")

/datum/game_test/room_test/gs13_burst_lying_cleanup/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject(GS13_BURST_GLUTTON)
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	var/token = gs13_confirm_glutton(controller)
	controller.finish_preparation(token)
	sleep(3)
	subject.set_body_position(LYING_DOWN)
	subject.set_lying_angle(90)
	sleep(3)
	TEST_ASSERT_EQUAL(subject.gs13_burst_scale_x, 1.1, "The burst multiplier follows the body's native lying orientation")
	TEST_ASSERT_EQUAL(subject.gs13_burst_scale_y, 1.8, "The long axis rotates with the body")
	controller.cancel_pending()
	sleep(3)
	TEST_ASSERT(abs(subject.gs13_render_size() - 1) < 0.001, "Recovery preserves the rotated body's original scale")
	TEST_ASSERT_EQUAL(subject.lying_angle, 90, "Recovery does not overwrite a native lying change")

/datum/game_test/room_test/gs13_burst_stun_ownership/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject(GS13_BURST_GLUTTON)
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	var/token = gs13_confirm_glutton(controller)
	controller.finish_preparation(token)
	subject.Stun(50 SECONDS)
	controller.cancel_pending()
	TEST_ASSERT_NULL(subject.has_status_effect(/datum/status_effect/incapacitating/stun/gs13_burst), "Cancellation removes only the adapter's stun status")
	TEST_ASSERT(subject.IsStunned(), "A separately sourced native stun survives cancellation")
	TEST_ASSERT_NOT(subject.gs13_burst_swell, "Canceling an independently stunned body still removes swelling")

/datum/game_test/room_test/gs13_blueberry_leak_conservation/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject()
	TEST_ASSERT_EQUAL(subject.spill_gs13_blueberry_juice(2), 2, "A source-sized leak removes its actual transferred volume")
	TEST_ASSERT_EQUAL(subject.reagents.get_reagent_amount("blueberry_juice"), 98, "Leakage conserves the remaining body dose")
	var/obj/effect/decal/cleanable/gs13_juice/puddle = locate() in get_turf(subject)
	TEST_ASSERT_EQUAL(puddle.reagents.get_reagent_amount("blueberry_juice"), 2, "The native cleanable puddle holds the leaked reagent")
	subject.spill_gs13_blueberry_juice(2)
	TEST_ASSERT_EQUAL(puddle.reagents.get_reagent_amount("blueberry_juice"), 4, "Repeated leaks reuse and fill the same floor decal")
	TEST_ASSERT_EQUAL(subject.reagents.get_reagent_amount("blueberry_juice"), 96, "Repeated leakage does not create reagent volume")
	subject.spill_gs13_blueberry_juice(0, TRUE)
	TEST_ASSERT_EQUAL(subject.reagents.get_reagent_amount("blueberry_juice"), 96, "The source cosmetic streak does not remove additional juice")
	TEST_ASSERT(puddle.icon_state in icon_states(puddle.icon), "The native puddle uses a valid original source state")

/datum/game_test/room_test/gs13_burst_fatal_cleanup/Run()
	for(var/kind in list(GS13_BURST_BLUEBERRY, GS13_BURST_GLUTTON))
		var/mob/living/carbon/human/subject = gs13_burst_subject(kind)
		var/turf/drop = get_turf(subject)
		var/mob/living/carbon/human/occupant = allocate(/mob/living/carbon/human)
		occupant.forceMove(subject)
		var/obj/item/storage/backpack/bag = allocate(/obj/item/storage/backpack)
		subject.equip_to_slot_if_possible(bag, ITEM_SLOT_BACK)
		var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
		if(kind == GS13_BURST_BLUEBERRY)
			subject.gs13_preferences["safe_bursting"] = FALSE
			controller.request_burst(kind)
		else
			subject.gs13_preferences["glutton_bursting_type"] = "Fatal"
			gs13_confirm_glutton(controller)
		var/token = controller.generation
		controller.finish_preparation(token)
		if(kind == GS13_BURST_GLUTTON)
			controller.complete_burst(token)
		TEST_ASSERT(QDELETED(subject), "An explicitly selected fatal outcome removes the source body")
		TEST_ASSERT(QDELETED(controller), "Fatal removal releases the pending controller and timer")
		TEST_ASSERT_NOT(QDELETED(bag), "Fatal removal preserves carried equipment")
		TEST_ASSERT_EQUAL(bag.loc, drop, "Equipment is dropped at the body's former location")
		TEST_ASSERT_NOT(QDELETED(occupant), "Fatal removal preserves contained mobs")
		TEST_ASSERT_EQUAL(get_turf(occupant), drop, "Contained mobs are released to the body location")

/datum/game_test/room_test/gs13_burst_native_timer/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject()
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	TEST_ASSERT(controller.request_burst(GS13_BURST_BLUEBERRY), "The real timer path accepts an automatic safe burst")
	TEST_ASSERT_EQUAL(subject.times_blueberry_bursted, 0, "The native timer does not execute early")
	sleep(8 SECONDS)
	TEST_ASSERT_EQUAL(subject.times_blueberry_bursted, 1, "The native seven-second timer resolves exactly once")
	TEST_ASSERT_NOT(subject.reagents.has_reagent("blueberry_juice"), "The timed effect expels the dose")
	TEST_ASSERT_NULL(controller.pending_kind, "The real timer clears its pending state")

/datum/game_test/room_test/gs13_antiburst_field_lifecycle/Run()
	var/mob/living/carbon/human/subject = gs13_burst_subject()
	var/obj/item/clothing/neck/human_petcollar/locked/antiburst/collar = allocate(/obj/item/clothing/neck/human_petcollar/locked/antiburst)
	TEST_ASSERT(subject.equip_to_slot_if_possible(collar, ITEM_SLOT_NECK), "The native neck slot accepts the stabilizing collar")
	var/datum/component/gs13_bursting/controller = subject.GetComponent(/datum/component/gs13_bursting)
	controller.request_burst(GS13_BURST_BLUEBERRY)
	collar.toggle_field()
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_NO_BURST, collar.UID()), "An active worn collar owns its immunity source")
	TEST_ASSERT_NULL(controller.pending_kind, "Engaging the field cancels an already pending burst")
	TEST_ASSERT_NOT(controller.can_burst(GS13_BURST_BLUEBERRY), "The active field prevents another burst")
	ADD_TRAIT(subject, TRAIT_NO_BURST, "independent")
	subject.drop_item_to_ground(collar, force = TRUE)
	TEST_ASSERT_NOT(HAS_TRAIT_FROM(subject, TRAIT_NO_BURST, collar.UID()), "Dropping a powered collar clears its former wearer's source")
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_NO_BURST, "independent"), "Field cleanup preserves independent protection")
	REMOVE_TRAIT(subject, TRAIT_NO_BURST, "independent")
	TEST_ASSERT(subject.equip_to_slot_if_possible(collar, ITEM_SLOT_NECK), "A still-powered collar can be re-equipped")
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_NO_BURST, collar.UID()), "Re-equipping rebinds the active field")
	qdel(collar)
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_NO_BURST), "Deleting the collar clears its owned field")

/datum/game_test/room_test/gs13_antiburst_native_radio/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/clothing/neck/human_petcollar/locked/antiburst/collar = allocate(/obj/item/clothing/neck/human_petcollar/locked/antiburst)
	subject.equip_to_slot_if_possible(collar, ITEM_SLOT_NECK)
	var/obj/item/assembly/signaler/remote = allocate(/obj/item/assembly/signaler, get_turf(subject))
	remote.frequency = ELECTROPACK_FREQ
	remote.code = 3
	remote.signal()
	TEST_ASSERT_NOT(collar.field_active, "An incorrect native signal code cannot toggle the field")
	remote.code = 2
	remote.signal()
	TEST_ASSERT(collar.field_active && HAS_TRAIT(subject, TRAIT_NO_BURST), "A matching native signal toggles the worn field")
	remote.signal()
	TEST_ASSERT_NOT(collar.field_active || HAS_TRAIT(subject, TRAIT_NO_BURST), "A second matching signal disengages the field")
	var/obj/item/assembly/signaler/gs13_antiburst/receiver = collar.integrated_signaler
	qdel(collar)
	TEST_ASSERT(QDELETED(receiver), "Collar deletion releases the native receiver")
	TEST_ASSERT_NOT(receiver in GLOB.remote_signalers, "Deleted receivers leave the global signaler registry")

/datum/game_test/room_test/gs13_antiburst_controls_and_research/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/other = allocate(/mob/living/carbon/human, get_turf(user))
	var/obj/item/clothing/neck/human_petcollar/locked/antiburst/collar = allocate(/obj/item/clothing/neck/human_petcollar/locked/antiburst)
	user.put_in_active_hand(collar)
	TEST_ASSERT_NOT(collar.apply_field_control("power", list(), other), "Another actor cannot use a carried collar's controls")
	TEST_ASSERT(collar.apply_field_control("freq", list("freq" = 159.9), user), "The holder can configure a native free-range frequency")
	TEST_ASSERT_EQUAL(collar.integrated_signaler.frequency, 1599, "The UI converts kilohertz exactly once")
	TEST_ASSERT(collar.apply_field_control("code", list("code" = 500), user), "The holder can configure a bounded code")
	TEST_ASSERT_EQUAL(collar.integrated_signaler.code, 100, "Codes cannot exceed native limits")
	TEST_ASSERT_NOT(collar.apply_field_control("freq", list("freq" = INFINITY), user), "Invalid numeric control payloads are rejected")
	TEST_ASSERT(collar.apply_field_control("reset", list("reset" = "freq"), user), "Frequency reset uses the source default")
	TEST_ASSERT_EQUAL(collar.integrated_signaler.frequency, ELECTROPACK_FREQ, "Reset restores the default electropack frequency")
	var/datum/design/gs13_antiburst_collar/design = allocate(/datum/design/gs13_antiburst_collar)
	TEST_ASSERT_EQUAL(design.build_path, collar.type, "Native protolathe research supplies the functional collar")
	TEST_ASSERT_EQUAL(design.materials[MAT_BLUESPACE], 500, "Research retains the source material proportions")
	TEST_ASSERT(isicon(collar.icon) && isicon(collar.worn_icon) && isicon(collar.lefthand_file) && isicon(collar.righthand_file), "The original GAGS layers have native object, worn, and hand adapters")
