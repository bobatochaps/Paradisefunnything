/datum/game_test/room_test/gs13_modular_costume_loadout/Run()
	var/datum/gear/gear = GLOB.gear_datums[/datum/gear/uniform/suit/gs13_costume/bunny_suit]
	TEST_ASSERT_NOTNULL(gear, "The source costume is normally available in native character setup")
	TEST_ASSERT_EQUAL(gear.cost, 1, "The costume retains ordinary source-family uniform cost")
	var/list/colors = list("#ff0000", "#00ff00", "#0000ff", "#ffff00", "#ff00ff", "#00ffff")
	var/list/metadata = list()
	var/list/keys = list()
	for(var/datum/gear_tweak/gs13_uniform_color/tweak in gear.gear_tweaks)
		keys |= "[tweak]"
		metadata["[tweak]"] = colors[tweak.channel]
	TEST_ASSERT_EQUAL(length(keys), 6, "Each of the six source colors has a distinct persistent native control")
	var/obj/item/clothing/under/gs13_dual_tone/bunny_suit/uniform = gear.spawn_item(get_turf(bottom_left), json_decode(json_encode(metadata)))
	LAZYADD(allocated, uniform)
	TEST_ASSERT_EQUAL(json_encode(uniform.gs13_uniform_colors), json_encode(colors), "Actual native loadout spawning restores all six colors independently")
	var/icon/item_icon = icon(uniform.icon, uniform.icon_state)
	var/fabric = item_icon.GetPixel(12, 12)
	TEST_ASSERT(color2R(fabric) > 0 && color2G(fabric) == 0 && color2B(fabric) == 0, "The first garment color uses source mask two rather than the separate skin mask")
	TEST_ASSERT_EQUAL(copytext(item_icon.GetPixel(13, 18), 1, 8), "#00ff00", "The source second color reaches its actual inventory pixels")
	TEST_ASSERT_EQUAL(copytext(item_icon.GetPixel(9, 16), 1, 8), "#0000ff", "The source third color retains its independent mask")
	TEST_ASSERT_EQUAL(copytext(item_icon.GetPixel(16, 15), 1, 8), "#ffff00", "The fourth color cannot be mistaken for the shirt family's skin mask")
	TEST_ASSERT_EQUAL(copytext(item_icon.GetPixel(14, 19), 1, 8), "#ff00ff", "The fifth color is rendered independently")
	var/list/data = uniform.serialize()
	var/obj/item/clothing/under/gs13_dual_tone/bunny_suit/restored = json_to_object(json_encode(data), get_turf(bottom_left))
	LAZYADD(allocated, restored)
	TEST_ASSERT_EQUAL(json_encode(restored.gs13_uniform_colors), json_encode(colors), "The actual native item JSON path preserves the whole six-channel palette")
	TEST_ASSERT(restored.set_gs13_uniform_color(6, "#123456"), "A live sixth-channel edit is supported")
	TEST_ASSERT_EQUAL(uniform.gs13_uniform_colors[6], "#00ffff", "Different physical items cannot share mutable colors")
	TEST_ASSERT_EQUAL(data["gs13_uniform_colors"][6], "#00ffff", "Later edits cannot alter a native saved snapshot")
	TEST_ASSERT_NOT(restored.set_gs13_uniform_color(7, "#ffffff"), "Unknown color channels are rejected")
	TEST_ASSERT_NOT(restored.set_gs13_uniform_color(1, "#ffffff00"), "Player colors cannot make source masks transparent")

/datum/game_test/room_test/gs13_modular_costume_appearance/Run()
	var/mob/living/carbon/human/subject = gs13_fluid_subject()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.gs13_preferences["anatomy_body_sprites"] = TRUE
	subject.fatness_real = FATNESS_LEVEL_OBESE
	subject.calculate_fatness()
	var/obj/item/clothing/under/gs13_dual_tone/bunny_suit/uniform = allocate(/obj/item/clothing/under/gs13_dual_tone/bunny_suit)
	var/list/colors = list("#3366cc", "#224466", "#aa2244", "#eebb22", "#663399", "#00ffff")
	for(var/channel in 1 to 6)
		uniform.set_gs13_uniform_color(channel, colors[channel])
	TEST_ASSERT(subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT), "The normally acquired source costume uses native equipment")
	var/list/states = gs13_weight_panel_states(subject)
	TEST_ASSERT("butt_4-7" in states, "The sixth garment color maps to the source's seventh hip mask")
	TEST_ASSERT("breasts_6-1" in states, "The source breast cutout uses the separate current-skin mask")
	TEST_ASSERT_NOT("m_breasts_pair_gs_smooth_6_FRONT" in states, "Native coverage prevents full bare anatomy over the costume")
	var/detail = gs13_clothing_panel_pixel(subject, "butt_4-7", 9, 13, EAST)
	TEST_ASSERT_NOTNULL(detail, "The source sixth-color detail is actually visible in its native side direction")
	TEST_ASSERT(color2R(detail) == 0 && color2G(detail) > 0 && color2B(detail) > 0, "The sixth palette color reaches the original side-detail pixels")
	gs13_render_weight_preview(subject, "costume_modular_4")
	subject.gs13_preferences["weight_belly_base"] = 5
	subject.gs13_preferences["weight_belly_custom_color"] = TRUE
	subject.gs13_preferences["weight_belly_color"] = "#ff0000"
	subject.update_gs13_weight_appearance(TRUE)
	var/skin = gs13_clothing_panel_pixel(subject, "belly_soft_9_SOUTH-1", 12, 23)
	TEST_ASSERT_NOTNULL(skin, "The expanded costume has actual source cutout pixels")
	TEST_ASSERT(color2R(skin) > 0 && color2G(skin) == 0 && color2B(skin) == 0, "The separate first mask follows current body color, independently of garment channel one")
	subject.gs13_preferences["weight_belly_color"] = "#aa6633"
	subject.update_gs13_weight_appearance(TRUE)
	gs13_render_weight_preview(subject, "costume_cutout_9")
	for(var/mutable_appearance/part as anything in subject.overlays_standing[GS13_WEIGHT_BODY_LAYER])
		TEST_ASSERT(icon_exists(part.icon, part.icon_state), "Every selected original or indexed native costume state exists")
	TEST_ASSERT_NOT(uniform.roll_undersuit(subject), "The native action safely refuses the original sheet's absent rolled base")
	var/obj/item/clothing/suit/space/cover = allocate(/obj/item/clothing/suit/space)
	subject.equip_to_slot_if_possible(cover, ITEM_SLOT_OUTER_SUIT)
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "Real native outer coverage hides every source costume layer")
	subject.drop_item_to_ground(cover)
	TEST_ASSERT("butt_4-7" in gs13_weight_panel_states(subject), "Removing coverage restores the current source detail palette")
	subject.drop_item_to_ground(uniform)
	TEST_ASSERT_NOT("butt_4-7" in gs13_weight_panel_states(subject), "Native costume removal clears all of its owned detail masks")
	TEST_ASSERT("m_breasts_pair_gs_smooth_6_FRONT" in gs13_weight_panel_states(subject), "The same actual anatomy is revealed after costume removal")

/datum/game_test/room_test/gs13_modular_costume_vending/Run()
	var/obj/machinery/economy/vending/clothing/vendor = allocate(/obj/machinery/economy/vending/clothing)
	var/datum/data/vending_product/from_path/product
	for(var/datum/data/vending_product/from_path/record as anything in vendor.product_records)
		if(record.product_path == /obj/item/clothing/under/gs13_dual_tone/bunny_suit)
			product = record
	TEST_ASSERT_NOTNULL(product, "The source costume has an ordinary ClothesMate acquisition path")
	TEST_ASSERT_EQUAL(product.amount, 5, "The actual native catalog keeps the source five-costume stock")
	TEST_ASSERT(product.price > 0, "Ordinary native uniform pricing applies to the additional costume")
	var/obj/item/clothing/under/gs13_dual_tone/bunny_suit/uniform = product.vend(get_turf(bottom_left))
	LAZYADD(allocated, uniform)
	TEST_ASSERT(istype(uniform), "Actual native vending creates the intended six-channel costume")
	TEST_ASSERT_EQUAL(length(uniform.gs13_uniform_colors), 6, "The vend contains all six source colors")
	TEST_ASSERT_EQUAL(product.amount, 4, "A real vend consumes exactly one costume")
	var/obj/item/vending_refill/refill = allocate(vendor.refill_canister)
	TEST_ASSERT_EQUAL(vendor.restock(refill), 1, "An ordinary native refill restores the additional family")
	TEST_ASSERT_EQUAL(product.amount, 5, "Refill retains the source stock cap")
	vendor.update_canister()
	var/obj/item/vending_refill/recovered = locate() in vendor.component_parts
	TEST_ASSERT_EQUAL(recovered.products[/obj/item/clothing/under/gs13_dual_tone/bunny_suit], 5, "Native deconstruction recovers the actual remaining costume stock")
