/datum/game_test/room_test/gs13_native_stomach_item_acid/Run()
	var/list/variants = list(/obj/item/organ/internal/gs13_stomach = 0, /obj/item/organ/internal/gs13_stomach/cybernetic = 0, /obj/item/organ/internal/gs13_stomach/cybernetic/tier2 = 200, /obj/item/organ/internal/gs13_stomach/cybernetic/tier3 = 350)
	for(var/organ_type in variants)
		var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
		subject.notransform = TRUE
		var/obj/item/organ/internal/gs13_stomach/replaced = subject.get_organ_slot(GS13_ORGAN_STOMACH)
		var/obj/item/organ/internal/gs13_stomach/stomach = allocate(organ_type)
		stomach.insert(subject)
		replaced.forceMove(get_turf(subject))
		var/obj/item/coin/silver/coin = allocate(/obj/item/coin/silver)
		TEST_ASSERT(stomach.consume_gs13_item(coin), "A real native stomach retains the actual metal item")
		stomach.process_gs13_stomach_items(2)
		stomach.process_gs13_stomach_items(2)
		TEST_ASSERT_EQUAL(coin.acid_level, 0, "The inherited object scan cannot apply acid before the source six-second cadence")
		stomach.process_gs13_stomach_items(2)
		TEST_ASSERT_EQUAL(coin.acid_level, variants[organ_type], "Actual native acid receives the source prosthesis power and ten-unit volume while ordinary stomachs remain non-corrosive")

/obj/item/coin/silver/gs13_digest_escape/Initialize(mapload)
	. = ..()
	RegisterSignal(src, COMSIG_GS13_STOMACH_DIGEST_ITEM, PROC_REF(escape_gs13_digest))

/obj/item/coin/silver/gs13_digest_escape/proc/escape_gs13_digest(datum/source, obj/item/organ/internal/gs13_stomach/stomach, mob/living/carbon/holder, seconds)
	SIGNAL_HANDLER
	forceMove(get_turf(holder))

/datum/game_test/room_test/gs13_stomach_acid_callback_and_food_gates/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.notransform = TRUE
	var/obj/item/organ/internal/gs13_stomach/replaced = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	var/obj/item/organ/internal/gs13_stomach/cybernetic/tier2/stomach = allocate(/obj/item/organ/internal/gs13_stomach/cybernetic/tier2)
	stomach.insert(subject)
	replaced.forceMove(get_turf(subject))
	var/obj/item/food/food = allocate(/obj/item/food)
	var/obj/item/reagent_containers/pill/pill = allocate(/obj/item/reagent_containers/pill)
	pill.set_gs13_coating(30)
	pill.reagents.add_reagent("gs13_ingestion_probe", 10)
	var/obj/item/coin/silver/gs13_digest_escape/escape = allocate(/obj/item/coin/silver/gs13_digest_escape)
	stomach.consume_gs13_item(food)
	stomach.consume_gs13_item(pill)
	stomach.consume_gs13_item(escape)
	stomach.gs13_item_acid_elapsed = 4
	stomach.process_gs13_stomach_items(2)
	TEST_ASSERT_EQUAL(food.acid_level, 0, "Source edible-food exclusion prevents prosthetic acid from destroying food objects")
	TEST_ASSERT_EQUAL(pill.acid_level, 0, "The source cancellation contract protects a coated pill from generic acid digestion")
	TEST_ASSERT_EQUAL(pill.reagents.total_volume, 10, "Acid processing cannot destroy retained medicine before its coating dissolves")
	TEST_ASSERT_EQUAL(pill.gs13_layers_remaining, 28, "Protected coating still advances using actual elapsed native digestion")
	TEST_ASSERT_EQUAL(escape.loc, get_turf(subject), "A real item callback can move its physical object out of the stomach")
	TEST_ASSERT_EQUAL(escape.acid_level, 0, "Post-callback ownership checks prevent acid from acting on the departed object")
	TEST_ASSERT_NOT(escape in stomach.gs13_stomach_contents, "Native movement immediately releases the departed callback object's tracking")
