/datum/game_test/room_test/proc/gs13_fluid_subject()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/datum/character_save/character = allocate(/datum/character_save)
	character.gs13_preferences = gs13_sanitize_preferences(list("custom_anatomy" = TRUE, "anatomy_breasts" = TRUE, "anatomy_testicles" = TRUE, "anatomy_vagina" = TRUE, "breasts_size" = 2, "fluid_production" = TRUE))
	character.apply_gs13_preferences(subject)
	return subject

/datum/game_test/room_test/gs13_fluid_preferences/Run()
	var/list/defaults = gs13_default_preferences()
	TEST_ASSERT_NOT(defaults["custom_anatomy"] || defaults["fluid_production"] || defaults["anatomy_breasts"] || defaults["anatomy_testicles"] || defaults["anatomy_vagina"], "Existing characters acquire no optional anatomy or production automatically")
	var/list/saved = gs13_sanitize_preferences(json_encode(list("custom_anatomy" = TRUE, "breast_produce" = "starshine neutron", "breasts_type" = "Quadruple", "breasts_size" = 999, "balls_size" = -3)))
	TEST_ASSERT_EQUAL(saved["breast_produce"], "starshine neutron", "Product choices survive the native character JSON field")
	TEST_ASSERT_EQUAL(saved["breasts_type"], "Quadruple", "Arrangement choices survive the native character JSON field")
	TEST_ASSERT_EQUAL(saved["breasts_size"], 80, "Numeric anatomy values are bounded")
	TEST_ASSERT_EQUAL(saved["balls_size"], 0.5, "Negative anatomy values cannot create invalid reservoirs")
	saved = gs13_sanitize_preferences(list("breasts_size" = INFINITY, "breast_produce" = "omnizine"))
	TEST_ASSERT_EQUAL(saved["breasts_size"], 1, "Nonfinite sizes use the compatible default")
	TEST_ASSERT_EQUAL(saved["breast_produce"], "breast milk", "Unsupported chemicals cannot enter a saved production selector")

/datum/game_test/room_test/gs13_fluid_anatomy_creation/Run()
	var/mob/living/carbon/human/plain = allocate(/mob/living/carbon/human)
	TEST_ASSERT_NULL(plain.get_organ_slot(GS13_ORGAN_BREASTS), "Ordinary native anatomy remains unchanged without a character choice")
	var/mob/living/carbon/human/subject = gs13_fluid_subject()
	for(var/slot in list(GS13_ORGAN_BREASTS, GS13_ORGAN_TESTICLES, GS13_ORGAN_VAGINA))
		var/obj/item/organ/internal/gs13_fluid_organ/organ = subject.get_organ_slot(slot)
		TEST_ASSERT_NOTNULL(organ, "Explicit saved choices create each native organ")
		TEST_ASSERT_EQUAL(organ.owner, subject, "The native organ belongs to its physical body")
		TEST_ASSERT(organ.icon_state in icon_states(organ.icon), "Each organ retains its original source object artwork")
		TEST_ASSERT(organ.unremovable, "The source anatomy is not an ordinary surgical extraction option")
		TEST_ASSERT_EQUAL(organ.reagents.my_atom, organ, "Each reservoir is owned by its actual organ")
		TEST_ASSERT_EQUAL(length(organ.actions), 1, "Each installed organ has one native collection action")
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/breasts = subject.get_organ_slot(GS13_ORGAN_BREASTS)
	var/obj/item/organ/internal/gs13_fluid_organ/testicles/testicles = subject.get_organ_slot(GS13_ORGAN_TESTICLES)
	var/obj/item/organ/internal/gs13_fluid_organ/vagina/vagina = subject.get_organ_slot(GS13_ORGAN_VAGINA)
	TEST_ASSERT_EQUAL(breasts.reagents.maximum_volume, 240, "A two-unit pair uses the source size/arrangement capacity")
	TEST_ASSERT_EQUAL(breasts.reagents.total_volume, 0, "The source milk reservoir starts empty")
	TEST_ASSERT_EQUAL(testicles.reagents.get_reagent_amount("cum"), 40, "The source testicular reservoir starts filled at its configured capacity")
	TEST_ASSERT_EQUAL(vagina.reagents.maximum_volume, 10, "The source vaginal reservoir retains its ten-unit capacity")
	TEST_ASSERT_EQUAL(vagina.reagents.total_volume, 0, "The source vaginal reservoir starts empty")

/datum/game_test/room_test/gs13_neutron_persistent_overdose/Run()
	var/mob/living/carbon/human/subject = gs13_fluid_subject()
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/breasts = subject.get_organ_slot(GS13_ORGAN_BREASTS)
	breasts.reagents.add_reagent("breast_milk", 5)
	subject.reagents.add_reagent("starshine_blue", 99)
	subject.reagents.metabolize(subject)
	TEST_ASSERT_EQUAL(breasts.fluid_id(), "breast_milk", "A subthreshold dose cannot trigger the persistent anatomy effect")
	subject.reagents.add_reagent("starshine_blue", 2)
	subject.reagents.metabolize(subject)
	var/datum/reagent/consumable/starshine/blue/neutron = subject.reagents.has_reagent("starshine_blue")
	TEST_ASSERT(neutron.overdosed, "The actual native chemistry path starts the overdose at the source threshold")
	for(var/slot in list(GS13_ORGAN_BREASTS, GS13_ORGAN_TESTICLES, GS13_ORGAN_VAGINA))
		var/obj/item/organ/internal/gs13_fluid_organ/organ = subject.get_organ_slot(slot)
		TEST_ASSERT_EQUAL(organ.fluid_id(), "starshine_blue", "Overdose changes the fluid type on each existing source organ")
	TEST_ASSERT(breasts.lactates, "The source overdose enables milk-organ production")
	TEST_ASSERT_EQUAL(breasts.reagents.get_reagent_amount("breast_milk"), 5, "The effect does not replace fluid already stored in the organ")
	TEST_ASSERT_EQUAL(subject.dna.gs13_anatomy["breast_produce"], "breast milk", "The effect does not rewrite inherited creation defaults")
	TEST_ASSERT_NOT(subject.dna.gs13_anatomy["breasts_lactation"], "The active lactation change is not encoded into DNA")
	subject.reagents.clear_reagents()
	TEST_ASSERT_EQUAL(breasts.fluid_id(), "starshine_blue", "Removing the drink releases temporary effects without reverting the organ")
	TEST_ASSERT_EQUAL(subject.fatness, 0, "The persistent organ effect does not bypass ordinary chemical weight opt-out")

/datum/game_test/room_test/gs13_neutron_absent_anatomy/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.reagents.add_reagent("starshine_blue", 100)
	subject.reagents.metabolize(subject)
	TEST_ASSERT_NULL(subject.get_organ_slot(GS13_ORGAN_BREASTS), "Overdose cannot invent an absent organ")
	TEST_ASSERT_NULL(subject.get_organ_slot(GS13_ORGAN_TESTICLES), "Overdose cannot invent another absent organ")
	TEST_ASSERT_NULL(subject.dna.gs13_anatomy, "Overdose cannot create an anatomy blueprint")

/datum/game_test/room_test/gs13_fluid_production_gates/Run()
	var/mob/living/carbon/human/subject = gs13_fluid_subject()
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/breasts = subject.get_organ_slot(GS13_ORGAN_BREASTS)
	breasts.internal_fluid_datum = /datum/reagent/consumable/starshine/blue
	breasts.lactates = TRUE
	breasts.on_life()
	TEST_ASSERT_EQUAL(breasts.reagents.total_volume, 0, "Offline bodies do not automatically produce fluid")
	TEST_ASSERT_EQUAL(breasts.produce_fluid(24), 24, "The shared production API accepts the source two-second five-percent dose")
	TEST_ASSERT_EQUAL(breasts.reagents.get_reagent_amount("starshine_blue"), 24, "Production uses the organ's changed persistent product")
	subject.gs13_preferences["fluid_production"] = FALSE
	TEST_ASSERT_EQUAL(breasts.produce_fluid(10), 0, "A live production opt-out stops new fluid")
	subject.gs13_preferences["fluid_production"] = TRUE
	subject.death()
	TEST_ASSERT_EQUAL(breasts.produce_fluid(10), 0, "A dead body cannot produce")
	subject.update_revive()
	breasts.status |= ORGAN_DEAD
	TEST_ASSERT_EQUAL(breasts.produce_fluid(10), 0, "A destroyed organ cannot produce")
	breasts.rejuvenate()
	TEST_ASSERT_EQUAL(breasts.fluid_id(), "starshine_blue", "Ordinary tissue repair retains the active product change")
	TEST_ASSERT_EQUAL(breasts.produce_fluid(INFINITY), 0, "An invalid request cannot overflow a native reservoir")

/datum/game_test/room_test/gs13_fluid_reservoir_bounds/Run()
	var/mob/living/carbon/human/subject = gs13_fluid_subject()
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/breasts = subject.get_organ_slot(GS13_ORGAN_BREASTS)
	TEST_ASSERT(breasts.set_fluid_capacity(9999), "Large anatomy still uses a finite source reservoir cap")
	TEST_ASSERT_EQUAL(breasts.reagents.maximum_volume, 3500, "The source 3500-unit maximum is enforced")
	TEST_ASSERT_EQUAL(breasts.produce_fluid(5000), 3500, "Production returns only the actual dose that fits")
	breasts.reagents.clear_reagents()
	breasts.reagents.add_reagent("breast_milk", 40)
	breasts.reagents.add_reagent("water", 40)
	breasts.set_fluid_capacity(25)
	TEST_ASSERT_EQUAL(breasts.reagents.total_volume, 25, "Capacity reduction removes excess mixed fluid without leaving an overfull holder")
	TEST_ASSERT_NOT(breasts.set_fluid_capacity(INFINITY), "An invalid capacity cannot corrupt the holder")
	breasts.set_fluid_capacity(0)
	TEST_ASSERT_EQUAL(breasts.reagents.total_volume, 0, "A zero-capacity reservoir cannot retain liquid")

/datum/game_test/room_test/gs13_fluid_collection/Run()
	var/mob/living/carbon/human/subject = gs13_fluid_subject()
	var/obj/item/organ/internal/gs13_fluid_organ/testicles/organ = subject.get_organ_slot(GS13_ORGAN_TESTICLES)
	var/obj/item/reagent_containers/glass/beaker/beaker = allocate(/obj/item/reagent_containers/glass/beaker)
	subject.put_in_active_hand(beaker)
	TEST_ASSERT_EQUAL(organ.collect_dose(subject, beaker), 10, "The native sample action transfers a bounded ten-unit dose")
	TEST_ASSERT_EQUAL(beaker.reagents.get_reagent_amount("cum"), 10, "The container receives the existing stored product")
	TEST_ASSERT_EQUAL(organ.reagents.total_volume, 30, "Collection conserves the organ's volume")
	beaker.add_lid()
	TEST_ASSERT_EQUAL(organ.collect_dose(subject, beaker), 0, "A closed lid stops collection")
	beaker.remove_lid()
	var/mob/living/carbon/human/other = gs13_fluid_subject()
	TEST_ASSERT_EQUAL(organ.collect_dose(other, beaker), 0, "Another body cannot invoke an owner's sample action")
	subject.drop_item_to_ground(beaker)
	TEST_ASSERT_EQUAL(organ.collect_dose(subject, beaker), 0, "A dropped container cannot continue collecting")

/datum/game_test/room_test/gs13_fluid_real_collection_action/Run()
	var/mob/living/carbon/human/subject = gs13_fluid_subject()
	var/obj/item/organ/internal/gs13_fluid_organ/organ = subject.get_organ_slot(GS13_ORGAN_TESTICLES)
	var/obj/item/reagent_containers/glass/beaker/beaker = allocate(/obj/item/reagent_containers/glass/beaker)
	beaker.reagents.add_reagent("water", beaker.reagents.maximum_volume - 10)
	subject.put_in_active_hand(beaker)
	TEST_ASSERT(organ.ui_action_click(subject, /datum/action/item_action/gs13_collect_fluid), "The actual native UI action completes its interruptible collection delay")
	TEST_ASSERT_EQUAL(beaker.reagents.total_volume, beaker.reagents.maximum_volume, "The action stops exactly when the held container fills")
	TEST_ASSERT_EQUAL(organ.reagents.total_volume, 30, "The timed action transfers only the volume that fits")
	TEST_ASSERT_NOT(organ.collecting, "A completed action releases its in-progress state")

/datum/game_test/room_test/gs13_fluid_organ_transfer/Run()
	var/mob/living/carbon/human/donor = gs13_fluid_subject()
	var/mob/living/carbon/human/recipient = gs13_fluid_subject()
	var/obj/item/organ/internal/gs13_fluid_organ/organ = donor.get_organ_slot(GS13_ORGAN_TESTICLES)
	organ.internal_fluid_datum = /datum/reagent/consumable/starshine/blue
	organ.remove(donor)
	organ.forceMove(get_turf(donor))
	TEST_ASSERT_NOT(organ.production_allowed(), "A removed organ loses its former producer")
	var/obj/item/organ/internal/gs13_fluid_organ/replaced = recipient.get_organ_slot(GS13_ORGAN_TESTICLES)
	organ.insert(recipient)
	replaced.forceMove(get_turf(recipient))
	TEST_ASSERT_EQUAL(organ.owner, recipient, "A forced native transplant changes physical ownership")
	TEST_ASSERT_EQUAL(organ.fluid_id(), "starshine_blue", "The persistent product moves with the organ")
	TEST_ASSERT_EQUAL(organ.reagents.get_reagent_amount("cum"), 40, "A transplant does not replace previously stored fluid")
	recipient.death()
	recipient.update_revive()
	TEST_ASSERT_EQUAL(organ.fluid_id(), "starshine_blue", "Death/revival does not reset the organ to its prototype")
	qdel(organ)
	TEST_ASSERT_NULL(recipient.get_organ_slot(GS13_ORGAN_TESTICLES), "Deleting the organ clears its native slot")

/datum/game_test/room_test/gs13_fluid_dna_ownership/Run()
	var/mob/living/carbon/human/subject = gs13_fluid_subject()
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/breasts = subject.get_organ_slot(GS13_ORGAN_BREASTS)
	breasts.internal_fluid_datum = /datum/reagent/consumable/starshine/blue
	breasts.lactates = TRUE
	var/datum/dna/snapshot = subject.dna.Clone()
	snapshot.gs13_anatomy["breast_produce"] = "water"
	TEST_ASSERT_EQUAL(subject.dna.gs13_anatomy["breast_produce"], "breast milk", "DNA clones have independent anatomy-default lists")
	snapshot.gs13_anatomy["breast_produce"] = "breast milk"
	var/mob/living/carbon/human/recipient = gs13_fluid_subject()
	recipient.change_dna(snapshot, include_species_change = TRUE)
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/created = recipient.get_organ_slot(GS13_ORGAN_BREASTS)
	TEST_ASSERT_EQUAL(created.fluid_id(), "breast_milk", "A DNA body change recreates inherited defaults rather than another organ's active overdose")
	TEST_ASSERT_NOT(created.lactates, "A new body does not inherit the temporary donor's active organ setting")
	subject.UpdateAppearance()
	TEST_ASSERT_EQUAL(subject.get_organ_slot(GS13_ORGAN_BREASTS), breasts, "An ordinary appearance refresh retains the physical organ")
	TEST_ASSERT_EQUAL(breasts.fluid_id(), "starshine_blue", "Appearance refreshes cannot revert persistent chemistry")
	qdel(breasts)
	subject.UpdateAppearance()
	TEST_ASSERT_NULL(subject.get_organ_slot(GS13_ORGAN_BREASTS), "Ordinary appearance refreshes do not regrow a removed organ")
	var/list/serialized = snapshot.serialize()
	var/datum/dna/restored = allocate(/datum/dna)
	restored.deserialize(serialized)
	TEST_ASSERT_EQUAL(restored.gs13_anatomy["custom_anatomy"], TRUE, "Native DNA serialization includes creation defaults")
	serialized -= "gs13_anatomy"
	restored.deserialize(serialized)
	TEST_ASSERT_NOT(restored.gs13_anatomy["custom_anatomy"], "Legacy DNA cannot silently acquire optional anatomy")
	qdel(snapshot)

/datum/game_test/room_test/gs13_fluid_live_preferences/Run()
	var/mob/living/carbon/human/subject = gs13_fluid_subject()
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/breasts = subject.get_organ_slot(GS13_ORGAN_BREASTS)
	breasts.internal_fluid_datum = /datum/reagent/consumable/starshine/blue
	breasts.lactates = TRUE
	var/datum/character_save/character = allocate(/datum/character_save)
	character.gs13_preferences = subject.gs13_preferences.Copy()
	character.gs13_preferences["breast_produce"] = "water"
	character.gs13_preferences["breasts_lactation"] = FALSE
	character.gs13_preferences["fluid_production"] = FALSE
	character.apply_gs13_preferences(subject, FALSE)
	TEST_ASSERT_EQUAL(breasts.fluid_id(), "starshine_blue", "Live next-spawn edits cannot overwrite an organ's persistent product")
	TEST_ASSERT(breasts.lactates, "Live next-spawn edits cannot overwrite the active lactation state")
	TEST_ASSERT_NOT(breasts.production_allowed(), "The independent live production opt-out takes effect immediately")

/datum/game_test/room_test/gs13_fluid_products_and_configuration/Run()
	var/mob/living/carbon/human/subject = gs13_fluid_subject()
	var/obj/item/organ/internal/gs13_fluid_organ/breasts/breasts = subject.get_organ_slot(GS13_ORGAN_BREASTS)
	var/list/blueprint = subject.dna.gs13_anatomy.Copy()
	for(var/product in gs13_breast_products())
		breasts.reagents.clear_reagents()
		blueprint["breast_produce"] = product
		breasts.configure_from_blueprint(blueprint)
		TEST_ASSERT_NOTNULL(GLOB.chemical_reagents_list[breasts.fluid_id()], "Every selectable source product resolves to an actual native reagent")
		TEST_ASSERT_EQUAL(breasts.produce_fluid(1), 1, "Every available product can be produced into the organ's own holder")
	var/was_enabled = GLOB.configuration.gs13.fluid_anatomy_enabled
	GLOB.configuration.gs13.fluid_anatomy_enabled = FALSE
	var/blocked_amount = breasts.produce_fluid(1)
	var/mob/living/carbon/human/disabled_body = gs13_fluid_subject()
	var/disabled_has_organ = !!disabled_body.get_organ_slot(GS13_ORGAN_BREASTS)
	GLOB.configuration.gs13.fluid_anatomy_enabled = was_enabled
	TEST_ASSERT_EQUAL(blocked_amount, 0, "Server disable stops existing production")
	TEST_ASSERT_NOT(disabled_has_organ, "Server disable prevents new optional anatomy")
	var/datum/configuration_section/gs13_configuration/settings = new
	settings.load_data(list("fluid_anatomy_enabled" = FALSE))
	TEST_ASSERT_NOT(settings.fluid_anatomy_enabled, "The native configuration loader accepts the anatomy switch independently of threshold overrides")
	qdel(settings)
