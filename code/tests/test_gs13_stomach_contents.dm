/datum/game_test/room_test/gs13_native_hidden_item_swallow/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.nutrition = 100
	var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	var/obj/item/food/sliceable/meal = allocate(/obj/item/food/sliceable)
	meal.bitesize = 1
	meal.reagents.add_reagent("gs13_ingestion_probe", 2)
	var/obj/item/coin/silver/coin = allocate(/obj/item/coin/silver)
	subject.put_in_active_hand(coin)
	meal.AltClick(subject)
	TEST_ASSERT_EQUAL(coin.loc, meal, "Ordinary native Alt-click insertion hides the real tiny item in food")
	subject.put_in_active_hand(meal)
	meal.interact_with_atom(subject, subject, list())
	TEST_ASSERT_EQUAL(coin.loc, meal, "A partial accepted bite leaves the hidden object inside the remaining food")
	stomach.reagents.maximum_volume = 1
	meal.interact_with_atom(subject, subject, list())
	TEST_ASSERT_EQUAL(coin.loc, meal, "A rejected final bite cannot swallow its hidden object")
	TEST_ASSERT_NOT(coin in stomach.gs13_stomach_contents, "Rejected intake cannot acquire physical stomach contents")
	stomach.reagents.maximum_volume = 20
	meal.interact_with_atom(subject, subject, list())
	TEST_ASSERT(QDELETED(meal), "The actual native final bite finishes and cleans up the food")
	TEST_ASSERT_EQUAL(coin.loc, subject, "An installed physical stomach retains its swallowed item with the native body")
	TEST_ASSERT(coin in stomach.gs13_stomach_contents, "The actual organ tracks the swallowed object independently of reagent contents")
	TEST_ASSERT_EQUAL(length(subject.stomach_contents), 0, "Ordinary hidden items cannot enter native swallowed-mob processing")
	TEST_ASSERT_EQUAL(stomach.reagents.total_volume, 2, "Swallowing an object preserves normal oral reagent routing")
	TEST_ASSERT_EQUAL(stomach.empty_gs13_contents(), 1, "The intact object remains recoverable from the actual stomach")
	TEST_ASSERT_EQUAL(coin.loc, get_turf(subject), "Recovery places the same physical item on the native floor")

/datum/game_test/room_test/gs13_stomach_item_native_transplant/Run()
	var/mob/living/carbon/human/donor = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/gs13_stomach/stomach = donor.get_organ_slot(GS13_ORGAN_STOMACH)
	var/obj/item/coin/silver/coin = allocate(/obj/item/coin/silver)
	donor.put_in_active_hand(coin)
	TEST_ASSERT(stomach.consume_gs13_item(coin), "The physical item API follows actual native inventory transfer")
	TEST_ASSERT_NULL(donor.get_active_hand(), "A swallowed held item cannot remain in a stale native hand slot")
	TEST_ASSERT_NOT(stomach.consume_gs13_item(coin), "Duplicate consumption cannot register duplicate movement callbacks")
	stomach.remove(donor)
	stomach.forceMove(get_turf(donor))
	TEST_ASSERT_EQUAL(coin.loc, stomach, "Actual native organ extraction moves retained objects into the physical organ")
	TEST_ASSERT(coin in stomach.gs13_stomach_contents, "Extraction movement cannot silently discard the organ's contents")
	var/obj/item/organ/internal/gs13_stomach/replaced = recipient.get_organ_slot(GS13_ORGAN_STOMACH)
	stomach.insert(recipient)
	replaced.forceMove(get_turf(recipient))
	TEST_ASSERT_EQUAL(coin.loc, recipient, "Actual native transplantation carries the same object into the receiving body")
	TEST_ASSERT_EQUAL(stomach.owner, recipient, "Retained items remain owned by their actual physical transplant")
	TEST_ASSERT_NULL(donor.get_organ_slot(GS13_ORGAN_STOMACH), "The donor cannot retain a second ownership route to the swallowed object")
	recipient.death()
	recipient.update_revive()
	TEST_ASSERT_EQUAL(coin.loc, recipient, "Native death and revival preserve retained physical items")
	stomach.insert(recipient)
	TEST_ASSERT_EQUAL(length(stomach.gs13_stomach_contents), 1, "Repeated native insertion remains an idempotent ownership operation")
	TEST_ASSERT_EQUAL(stomach.empty_gs13_contents(), 1, "The new owner can recover the transplanted item")

/datum/game_test/room_test/gs13_stomach_item_moves_and_destruction/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	var/obj/item/coin/silver/coin = allocate(/obj/item/coin/silver)
	TEST_ASSERT(stomach.consume_gs13_item(coin), "The real stomach first acquires its physical item")
	coin.forceMove(get_turf(subject))
	TEST_ASSERT_EQUAL(length(stomach.gs13_stomach_contents), 0, "External movement releases tracking immediately")
	TEST_ASSERT_EQUAL(stomach.empty_gs13_contents(), 0, "A recovered object cannot be duplicated by later emptying")
	TEST_ASSERT(stomach.consume_gs13_item(coin), "A physically reacquired item can register fresh ownership")
	qdel(coin)
	TEST_ASSERT_EQUAL(length(stomach.gs13_stomach_contents), 0, "Actual native item deletion releases retained references")
	var/obj/item/coin/gold/retained = allocate(/obj/item/coin/gold)
	retained.flags |= NODROP
	subject.put_in_active_hand(retained)
	TEST_ASSERT_NOT(stomach.consume_gs13_item(retained), "Swallowing cannot bypass a native NODROP hand restriction")
	retained.flags &= ~NODROP
	TEST_ASSERT(stomach.consume_gs13_item(retained), "Normal inventory transfer succeeds after the actual restriction is removed")
	qdel(stomach)
	TEST_ASSERT(QDELETED(retained), "Actual organ destruction owns retained-item cleanup like the pinned source")
	TEST_ASSERT_NULL(subject.get_organ_slot(GS13_ORGAN_STOMACH), "Native organ deletion releases the real slot")

/obj/item/organ/internal/gs13_stomach/gs13_test_vomit
	var/gs13_test_empty_calls = 0
	var/gs13_test_empty_chance
	var/gs13_test_empty_damaging

// Control only the random roll while testing the real native vomiting path.
/obj/item/organ/internal/gs13_stomach/gs13_test_vomit/empty_gs13_contents(chance = 100, damaging = FALSE, min_amount = 0)
	gs13_test_empty_calls++
	gs13_test_empty_chance = chance
	gs13_test_empty_damaging = damaging
	return ..(100, damaging, min_amount)

/datum/game_test/room_test/gs13_stomach_items_vomit_and_recovery/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/gs13_stomach/original = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	var/obj/item/organ/internal/gs13_stomach/gs13_test_vomit/stomach = allocate(/obj/item/organ/internal/gs13_stomach/gs13_test_vomit)
	stomach.insert(subject)
	original.forceMove(get_turf(subject))
	var/obj/item/coin/silver/coin = allocate(/obj/item/coin/silver)
	stomach.consume_gs13_item(coin)
	subject.nutrition = 0
	subject.vomit(should_confuse = FALSE, message = FALSE)
	TEST_ASSERT_EQUAL(stomach.gs13_test_empty_calls, 0, "Native dry heaving cannot emit the accepted-vomiting hook")
	TEST_ASSERT_EQUAL(coin.loc, subject, "Dry heaving cannot eject a retained object")
	subject.nutrition = 200
	var/before_damage = subject.getBruteLoss()
	TEST_ASSERT(subject.vomit(should_confuse = FALSE, message = FALSE), "The fixture invokes actual successful native vomiting")
	TEST_ASSERT_EQUAL(stomach.gs13_test_empty_calls, 1, "Accepted native vomiting reaches the installed physical stomach exactly once")
	TEST_ASSERT_EQUAL(stomach.gs13_test_empty_chance, 60, "Ordinary vomiting uses the pinned source per-item ejection chance")
	TEST_ASSERT(stomach.gs13_test_empty_damaging, "Ordinary ejection retains the source chest-trauma contract")
	TEST_ASSERT_EQUAL(coin.loc, get_turf(subject), "A vomited object is physically recoverable on the floor")
	TEST_ASSERT_EQUAL(subject.getBruteLoss() - before_damage, coin.w_class * 2, "Native ejection damage follows the actual object's weight class")
	stomach.remove(subject)
	stomach.forceMove(get_turf(subject))
	TEST_ASSERT(stomach.consume_gs13_item(coin), "The extracted organ can retain an independently placed item")
	subject.vomit(should_confuse = FALSE, message = FALSE)
	TEST_ASSERT_EQUAL(stomach.gs13_test_empty_calls, 1, "Extraction disconnects the old owner's native vomiting signal")
	TEST_ASSERT_EQUAL(coin.loc, stomach, "The former owner cannot eject items from an extracted organ")
	// Exercise actual unmodified source chance bounds and minimum recovery.
	var/obj/item/organ/internal/gs13_stomach/extracted = allocate(/obj/item/organ/internal/gs13_stomach)
	extracted.consume_gs13_item(coin)
	TEST_ASSERT_EQUAL(extracted.empty_gs13_contents(0), 0, "Zero ejection chance leaves the same real item intact")
	TEST_ASSERT_EQUAL(extracted.empty_gs13_contents(0, FALSE, 1), 1, "A forced source minimum guarantees actual item recovery")
	TEST_ASSERT_EQUAL(coin.loc, get_turf(extracted), "Uninstalled recovery uses the actual organ's floor")
	TEST_ASSERT_NOT(coin in stomach.gs13_stomach_contents, "Cross-organ movement releases the old organ's tracking")
