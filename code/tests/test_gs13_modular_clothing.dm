/datum/game_test/room_test/gs13_dual_tone_loadout/Run()
	var/count = 0
	for(var/gear_path in subtypesof(/datum/gear/uniform/suit/gs13_dual_tone))
		var/datum/gear/gear = GLOB.gear_datums[gear_path]
		TEST_ASSERT_NOTNULL(gear, "All source dual-tone choices reach native character setup")
		var/list/category = GLOB.gear_tgui_info[gear.sort_category]
		TEST_ASSERT_NOTNULL(category["[gear_path]"], "The real loadout interface lists every implemented source choice")
		TEST_ASSERT_EQUAL(gear.cost, 1, "The adaptive family uses ordinary native uniform cost")
		var/obj/item/clothing/under/gs13_dual_tone/uniform = gear.spawn_item(get_turf(bottom_left), list())
		LAZYADD(allocated, uniform)
		TEST_ASSERT(istype(uniform), "Native loadout spawning creates the original two-channel family")
		count++
	TEST_ASSERT_EQUAL(count, 25, "All twenty-five source dual-tone loadout choices are registered")
	var/datum/gear/engineering = GLOB.gear_datums[/datum/gear/uniform/suit/gs13_dual_tone/white/engineering]
	TEST_ASSERT("Station Engineer" in engineering.allowed_roles, "The ordinary native engineering role can acquire its source suit")
	TEST_ASSERT_NOT("Assistant" in engineering.allowed_roles, "An unrelated job cannot acquire the protected department loadout")
	var/datum/gear/chief = GLOB.gear_datums[/datum/gear/uniform/suit/gs13_dual_tone/white/engineering/chief]
	TEST_ASSERT_EQUAL(length(chief.allowed_roles), 1, "Head-role restrictions override inherited department permissions")
	TEST_ASSERT_EQUAL(chief.allowed_roles[1], "Chief Engineer", "The source chief choice retains its specific native role")
	var/datum/gear/white = GLOB.gear_datums[/datum/gear/uniform/suit/gs13_dual_tone/white]
	var/list/metadata = list()
	var/list/color_keys = list()
	for(var/datum/gear_tweak/gs13_uniform_color/tweak in white.gear_tweaks)
		color_keys += "[tweak]"
		metadata["[tweak]"] = tweak.channel == 1 ? "#3366cc" : "#aa2244"
	TEST_ASSERT_EQUAL(length(color_keys), 2, "The native editor exposes two independent color controls")
	TEST_ASSERT_NOT(color_keys[1] == color_keys[2], "Each channel has its own persistent native metadata key")
	var/obj/item/clothing/under/gs13_dual_tone/custom = white.spawn_item(get_turf(bottom_left), json_decode(json_encode(metadata)))
	LAZYADD(allocated, custom)
	TEST_ASSERT_EQUAL(custom.gs13_uniform_colors[1], "#3366cc", "The real native spawn applies saved fabric metadata")
	TEST_ASSERT_EQUAL(custom.gs13_uniform_colors[2], "#aa2244", "The independent stripe metadata survives the same JSON round trip")
	var/icon/item_icon = icon(custom.icon, custom.icon_state)
	TEST_ASSERT_EQUAL(copytext(item_icon.GetPixel(13, 21), 1, 8), "#3366cc", "Source object masks receive the actual chosen fabric color")
	TEST_ASSERT_EQUAL(copytext(item_icon.GetPixel(12, 20), 1, 8), "#aa2244", "Object stripe pixels use the other channel")
	TEST_ASSERT_EQUAL(copytext(custom.worn_icon.GetPixel(12, 21, SOUTH), 1, 8), "#3366cc", "The equipped base icon uses the same fabric palette")
	TEST_ASSERT_EQUAL(copytext(custom.worn_icon.GetPixel(10, 18, SOUTH), 1, 8), "#aa2244", "The equipped base icon preserves the stripe channel")

/datum/game_test/room_test/gs13_dual_tone_live_palette/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/other = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_sanitize_preferences(list("master_wg_pref" = TRUE))
	subject.fatness_real = FATNESS_LEVEL_OBESE
	subject.calculate_fatness()
	var/obj/item/clothing/under/gs13_dual_tone/uniform = allocate(/obj/item/clothing/under/gs13_dual_tone)
	TEST_ASSERT_NOT(uniform.can_customize_gs13_colors(subject), "A suit on the ground cannot open the owned-inventory editor")
	TEST_ASSERT(subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT), "The source item equips through native inventory")
	TEST_ASSERT(uniform.can_customize_gs13_colors(subject), "The current wearer can use the native color editor")
	TEST_ASSERT_NOT(uniform.can_customize_gs13_colors(other), "A different body cannot recolor the wearer's inventory")
	TEST_ASSERT("belly_soft_4-1" in gs13_weight_panel_states(subject), "Native equipment creates the fabric body mask")
	var/old_mask = uniform.gs13_panel_icons["belly_soft_4-1"]
	TEST_ASSERT(uniform.set_gs13_uniform_color(1, "#3366CC"), "A valid live color edit is accepted")
	TEST_ASSERT_NOT(old_mask == uniform.gs13_panel_icons["belly_soft_4-1"], "A real live edit rebuilds the equipped body's cached mask")
	TEST_ASSERT_EQUAL(uniform.gs13_uniform_colors[1], "#3366cc", "The native sanitizer normalizes saved hexadecimal values")
	TEST_ASSERT_EQUAL(uniform.gs13_uniform_colors[2], "#ffffff", "Editing fabric never changes the stripe palette")
	for(var/bad in list("#abc", "#ffffff00", "#gggggg", list("#ffffff"), 1))
		TEST_ASSERT_NOT(uniform.set_gs13_uniform_color(1, bad), "Malformed colors ([json_encode(bad)]) cannot hide, tint, or corrupt the source masks")
	TEST_ASSERT_NOT(uniform.set_gs13_uniform_color(3, "#ffffff"), "Unknown color channels are rejected")
	ADD_TRAIT(subject, TRAIT_HANDS_BLOCKED, "gs13-palette-test")
	TEST_ASSERT_NOT(uniform.can_customize_gs13_colors(subject), "Native blocked hands stop editing")
	REMOVE_TRAIT(subject, TRAIT_HANDS_BLOCKED, "gs13-palette-test")
	subject.drop_item_to_ground(uniform)
	TEST_ASSERT_NOT(uniform.can_customize_gs13_colors(subject), "Dropping the item invalidates an open edit's ownership recheck")
	var/obj/item/clothing/under/gs13_dual_tone/engineering/locked = allocate(/obj/item/clothing/under/gs13_dual_tone/engineering)
	TEST_ASSERT_NOT(locked.set_gs13_uniform_color(1, "#111111"), "Source department palettes remain fixed")
	TEST_ASSERT_EQUAL(locked.gs13_uniform_colors[1], "#ffdd00", "A forbidden edit preserves the source department color")

/datum/game_test/room_test/gs13_dual_tone_persistence/Run()
	var/obj/item/clothing/under/gs13_dual_tone/uniform = allocate(/obj/item/clothing/under/gs13_dual_tone)
	var/obj/item/clothing/under/gs13_dual_tone/other = allocate(/obj/item/clothing/under/gs13_dual_tone)
	uniform.set_gs13_uniform_color(1, "#123456")
	uniform.set_gs13_uniform_color(2, "#abcdef")
	var/list/saved = uniform.serialize()
	TEST_ASSERT_NOT("icon" in saved, "Native item persistence stores source colors instead of ephemeral icon resources")
	var/obj/item/clothing/under/gs13_dual_tone/restored = json_to_object(json_encode(saved), get_turf(bottom_left))
	LAZYADD(allocated, restored)
	TEST_ASSERT_EQUAL(restored.gs13_uniform_colors[1], "#123456", "Actual native item serialization preserves fabric")
	TEST_ASSERT_EQUAL(restored.gs13_uniform_colors[2], "#abcdef", "Actual native item serialization independently preserves stripes")
	var/icon/restored_icon = icon(restored.icon, restored.icon_state)
	TEST_ASSERT_EQUAL(copytext(restored_icon.GetPixel(13, 21), 1, 8), "#123456", "Deserialization rebuilds the usable native object icon")
	TEST_ASSERT_EQUAL(other.gs13_uniform_colors[1], "#ffffff", "Separate actual suits never share a mutable palette")
	restored.set_gs13_uniform_color(1, "#ffffff")
	TEST_ASSERT_EQUAL(saved["gs13_uniform_colors"][1], "#123456", "Later item edits cannot mutate the saved snapshot")
	var/obj/item/clothing/under/gs13_dual_tone/old = allocate(/obj/item/clothing/under/gs13_dual_tone)
	old.deserialize(list("accessories" = list()))
	TEST_ASSERT_EQUAL(old.gs13_uniform_colors[1], "#ffffff", "Older item records retain compatible source defaults")

/datum/game_test/room_test/gs13_dual_tone_appearance/Run()
	var/mob/living/carbon/human/subject = gs13_fluid_subject()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.gs13_preferences["anatomy_body_sprites"] = TRUE
	subject.gs13_preferences["weight_belly_shape"] = "Round"
	subject.fatness_real = FATNESS_LEVEL_OBESE
	subject.calculate_fatness()
	var/obj/item/clothing/under/gs13_dual_tone/uniform = allocate(/obj/item/clothing/under/gs13_dual_tone)
	uniform.set_gs13_uniform_color(1, "#3366cc")
	uniform.set_gs13_uniform_color(2, "#aa2244")
	subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT)
	var/list/states = gs13_weight_panel_states(subject)
	TEST_ASSERT("belly_soft_4-1" in states, "Source dual-tone clothing uses soft panels even over a Round body")
	TEST_ASSERT("belly_soft_4-2" in states, "Both original belly masks participate in native composition")
	TEST_ASSERT("butt_4-1" in states, "The native hip layer receives the same family palette")
	TEST_ASSERT("breasts_6-1" in states, "The actual weight-grown organ receives the matching uniform layer")
	TEST_ASSERT_NOT("m_breasts_pair_gs_smooth_6_FRONT" in states, "Native chest coverage prevents bare anatomy over the uniform")
	for(var/mutable_appearance/part as anything in subject.overlays_standing[GS13_WEIGHT_BODY_LAYER])
		TEST_ASSERT(icon_exists(part.icon, part.icon_state), "Every selected original or colored source state actually exists")
	gs13_render_weight_preview(subject, "dual_tone_custom_4")
	subject.nutrition = FULLNESS_LEVEL_NOMOREPLZ + 1
	subject.update_gs13_weight_appearance(TRUE)
	states = gs13_weight_panel_states(subject)
	TEST_ASSERT("belly_soft_6-1" in states, "Fullness expands this family's soft panels by the source two sizes")
	TEST_ASSERT_NOT("belly_stuffed_6" in states, "The family does not borrow a different sheet's stuffed shape")
	gs13_render_weight_preview(subject, "dual_tone_fullness_6")
	TEST_ASSERT_NOT(uniform.roll_undersuit(subject), "The native action safely refuses the source sheet's absent rolled artwork")
	TEST_ASSERT_NOT(uniform.rolled_down, "A refused roll preserves actual native coverage")
	var/obj/item/clothing/suit/space/cover = allocate(/obj/item/clothing/suit/space)
	subject.equip_to_slot_if_possible(cover, ITEM_SLOT_OUTER_SUIT)
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "A real covering outer suit hides every modular source layer")
	subject.drop_item_to_ground(cover)
	TEST_ASSERT("belly_soft_6-1" in gs13_weight_panel_states(subject), "Removing native coverage restores current masks")
	subject.drop_item_to_ground(uniform)
	TEST_ASSERT_NOT("belly_soft_6-1" in gs13_weight_panel_states(subject), "Dropping the uniform removes all owned mask layers")
	TEST_ASSERT("m_breasts_pair_gs_smooth_6_FRONT" in gs13_weight_panel_states(subject), "The actual uncovered anatomy remains after equipment removal")

/datum/game_test/room_test/gs13_dual_tone_protection_and_sensors/Run()
	for(var/uniform_path in typesof(/obj/item/clothing/under/gs13_dual_tone))
		var/obj/item/clothing/under/gs13_dual_tone/uniform = allocate(uniform_path)
		TEST_ASSERT(icon_exists(uniform.icon, uniform.icon_state), "Every source palette produces a native object icon")
		TEST_ASSERT(icon_exists(uniform.worn_icon, uniform.icon_state), "Every palette supplies the native equipped base sheet")
		if(uniform.gs13_protection_template)
			var/obj/item/clothing/under/native = allocate(uniform.gs13_protection_template)
			TEST_ASSERT_EQUAL(json_encode(uniform.armor.getList()), json_encode(native.armor.getList()), "Source protective families use their corresponding real native uniform ratings")
			TEST_ASSERT_EQUAL(uniform.permeability_coefficient, native.permeability_coefficient, "Native chemical/biological permeability follows the same ordinary role uniform")
	var/obj/item/clothing/under/gs13_dual_tone/security/security = allocate(/obj/item/clothing/under/gs13_dual_tone/security)
	TEST_ASSERT_EQUAL(security.sensor_mode, SENSOR_COORDS, "Source security tracking is deterministic rather than randomized")
	TEST_ASSERT_EQUAL(security.strip_delay, 50, "The source security strip delay uses the native decisecond contract")
	var/obj/item/clothing/under/gs13_dual_tone/prisonner/prison = allocate(/obj/item/clothing/under/gs13_dual_tone/prisonner)
	TEST_ASSERT_EQUAL(prison.has_sensor, 2, "Source prisoner sensor controls use the native lock")
	TEST_ASSERT_EQUAL(prison.sensor_mode, SENSOR_COORDS, "Locked source uniforms retain location tracking")
	TEST_ASSERT_NOT(prison.turn_sensors_off(), "A locked source uniform cannot use native binary-sensor disabling")

/datum/game_test/room_test/gs13_dual_tone_vending/Run()
	var/list/vendors = list(/obj/machinery/economy/vending/clothing, /obj/machinery/economy/vending/secdrobe, /obj/machinery/economy/vending/detdrobe, /obj/machinery/economy/vending/medidrobe, /obj/machinery/economy/vending/virodrobe, /obj/machinery/economy/vending/chemdrobe, /obj/machinery/economy/vending/genedrobe, /obj/machinery/economy/vending/scidrobe, /obj/machinery/economy/vending/robodrobe, /obj/machinery/economy/vending/engidrobe, /obj/machinery/economy/vending/atmosdrobe, /obj/machinery/economy/vending/cargodrobe, /obj/machinery/economy/vending/chefdrobe, /obj/machinery/economy/vending/bardrobe, /obj/machinery/economy/vending/hydrodrobe, /obj/machinery/economy/vending/janidrobe, /obj/machinery/economy/vending/lawdrobe, /obj/machinery/economy/vending/chapdrobe)
	for(var/vendor_path in vendors)
		var/obj/machinery/economy/vending/vendor = allocate(vendor_path)
		for(var/uniform_path in vendor.gs13_dual_tone_stock)
			var/datum/data/vending_product/from_path/found
			for(var/datum/data/vending_product/from_path/record as anything in vendor.product_records)
				if(record.product_path == uniform_path)
					found = record
			TEST_ASSERT_NOTNULL(found, "Every source-matched wardrobe builds the real dual-tone product record")
			TEST_ASSERT_EQUAL(found.amount, vendor.gs13_dual_tone_stock[uniform_path], "Native catalogs retain source three/five-item quantities")
			TEST_ASSERT(found.price > 0, "The ordinary native uniform economy applies to the source family")
	var/obj/machinery/economy/vending/secdrobe/vendor = allocate(/obj/machinery/economy/vending/secdrobe)
	var/datum/data/vending_product/from_path/product
	for(var/datum/data/vending_product/from_path/record as anything in vendor.product_records)
		if(record.product_path == /obj/item/clothing/under/gs13_dual_tone/security)
			product = record
	var/obj/item/clothing/under/gs13_dual_tone/security/suit = product.vend(get_turf(bottom_left))
	LAZYADD(allocated, suit)
	TEST_ASSERT(istype(suit), "Actual native vending supplies the fixed source security palette")
	TEST_ASSERT_EQUAL(suit.gs13_uniform_colors[1], "#00386e", "Vending preserves the reviewed source department color")
	TEST_ASSERT_EQUAL(product.amount, 2, "A real vend consumes exactly one source suit")
	var/obj/item/vending_refill/secdrobe/refill = allocate(/obj/item/vending_refill/secdrobe)
	TEST_ASSERT_EQUAL(vendor.restock(refill), 1, "An ordinary native refill replenishes the additional family")
	TEST_ASSERT_EQUAL(product.amount, 3, "The additional family's source stock cap survives refill")
	vendor.update_canister()
	var/obj/item/vending_refill/secdrobe/recovered = locate() in vendor.component_parts
	TEST_ASSERT_EQUAL(recovered.products[/obj/item/clothing/under/gs13_dual_tone/security], 3, "Native deconstruction recovers current dual-tone stock")
