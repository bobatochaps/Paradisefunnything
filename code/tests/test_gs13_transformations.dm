/datum/game_test/room_test/gs13_transformation_sources/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/datum/first = allocate(/datum)
	var/datum/second = allocate(/datum)
	subject.set_gs13_body_change(first, 150, "#0004ff")
	subject.set_gs13_body_change(second, 300, "#ff0000")
	var/datum/component/gs13_transformation/controller = subject.GetComponent(/datum/component/gs13_transformation)
	TEST_ASSERT_EQUAL(subject.fatness, 450, "Independent transformations add their apparent weight")
	TEST_ASSERT_EQUAL(controller.body_stage, 3, "The state uses native GS13 body-stage boundaries")
	TEST_ASSERT_EQUAL(subject.color, "#ff0000", "The most recently registered colored source has priority")
	subject.set_gs13_body_change(first, 600, "#0004ff")
	TEST_ASSERT_EQUAL(subject.fatness, 900, "Updating a source replaces its contribution instead of stacking it")
	TEST_ASSERT_EQUAL(length(controller.sources), 2, "Repeated updates retain exactly one entry per source")
	qdel(second)
	TEST_ASSERT_EQUAL(subject.fatness, 600, "Deleting a source releases its contribution immediately")
	TEST_ASSERT_EQUAL(subject.color, "#0004ff", "Removing a colored source reveals the previous transformation")
	qdel(first)
	TEST_ASSERT_EQUAL(subject.fatness, 0, "Removing the final source restores the body's stored weight")
	TEST_ASSERT_NULL(subject.GetComponent(/datum/component/gs13_transformation), "The final removal releases the controller")
	TEST_ASSERT_NULL(subject.color, "The final removal releases the transformation color")

/datum/game_test/room_test/gs13_transformation_colour_restoration/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.add_atom_colour("#123456", FIXED_COLOUR_PRIORITY)
	subject.add_atom_colour("#abcdef", WASHABLE_COLOUR_PRIORITY)
	subject.set_gs13_body_change("berry", 150, "#0004ff")
	TEST_ASSERT_EQUAL(subject.color, "#0004ff", "A body transformation covers an ordinary paint tint")
	subject.add_atom_colour("#654321", TEMPORARY_COLOUR_PRIORITY)
	TEST_ASSERT_EQUAL(subject.color, "#654321", "Native temporary effects retain their higher priority")
	subject.remove_gs13_body_change("berry")
	TEST_ASSERT_EQUAL(subject.color, "#654321", "Recovery does not clear another active native effect")
	subject.remove_atom_colour(TEMPORARY_COLOUR_PRIORITY)
	TEST_ASSERT_EQUAL(subject.color, "#abcdef", "Recovery reveals the original paint without a stale snapshot")
	subject.set_gs13_body_change("berry", 150, "#0004ff")
	subject.add_atom_colour("#fedcba", WASHABLE_COLOUR_PRIORITY)
	subject.remove_gs13_body_change("berry")
	TEST_ASSERT_EQUAL(subject.color, "#fedcba", "Paint applied during transformation is preserved on recovery")
	subject.remove_atom_colour(WASHABLE_COLOUR_PRIORITY)
	TEST_ASSERT_EQUAL(subject.color, "#123456", "The body's inherent color is also preserved")

/datum/game_test/room_test/gs13_transformation_bounds/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	TEST_ASSERT_NOT(subject.set_gs13_body_change(1, 150), "Numeric list-index sources are rejected")
	TEST_ASSERT_NOT(subject.set_gs13_body_change("invalid", INFINITY), "Infinite weight is rejected")
	TEST_ASSERT_NOT(subject.set_gs13_body_change("invalid", -1), "Negative transformation weight is rejected")
	TEST_ASSERT_NULL(subject.GetComponent(/datum/component/gs13_transformation), "Invalid updates do not allocate controllers")
	TEST_ASSERT_EQUAL(gs13_volume_to_fatness(INFINITY), 0, "Invalid chemical volumes cannot overflow appearance state")
	TEST_ASSERT_EQUAL(gs13_volume_to_fatness(-10), 0, "Negative chemical volumes have no body contribution")
	TEST_ASSERT(abs(gs13_volume_to_fatness(100) - 1240) < 0.001, "The volume conversion retains the source coefficient")
	subject.set_gs13_body_change("large", SHORT_REAL_LIMIT)
	subject.set_gs13_body_change("also large", SHORT_REAL_LIMIT)
	var/datum/component/gs13_transformation/controller = subject.GetComponent(/datum/component/gs13_transformation)
	TEST_ASSERT_EQUAL(controller.body_fatness, SHORT_REAL_LIMIT, "Aggregate body state stays within finite native bounds")

/datum/game_test/room_test/gs13_blueberry_preferences/Run()
	var/list/settings = gs13_sanitize_preferences(json_encode(list("blueberry_inflation" = TRUE)))
	TEST_ASSERT_EQUAL(settings["blueberry_inflation"], TRUE, "The independent source setting survives character JSON")
	TEST_ASSERT_EQUAL(gs13_default_preferences()["blueberry_inflation"], FALSE, "Old and new characters default to opt-out")
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.reagents.add_reagent("blueberry_juice", 100)
	TEST_ASSERT_NOT(subject.reagents.has_reagent("blueberry_juice"), "An opted-out body immediately discards blueberry juice")
	var/datum/character_save/character = allocate(/datum/character_save)
	character.gs13_preferences = settings
	character.apply_gs13_preferences(subject)
	subject.reagents.add_reagent("blueberry_juice", 100)
	TEST_ASSERT(abs(subject.fatness - 1240) < 0.001, "Blueberry opt-in works independently of ordinary weight gain")
	TEST_ASSERT_NOT(subject.check_weight_prefs(FATTENING_TYPE_CHEM), "Blueberry opt-in does not enable unrelated chemical weight gain")
	TEST_ASSERT_NOTNULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "The opted-in transformation can use the human body adapter")
	character.gs13_preferences["blueberry_inflation"] = FALSE
	character.apply_gs13_preferences(subject, FALSE)
	TEST_ASSERT_NOT(subject.reagents.has_reagent("blueberry_juice"), "A live preference edit discards the existing dose")
	TEST_ASSERT_EQUAL(subject.fatness, 0, "Opt-out immediately restores body size")
	TEST_ASSERT_NULL(subject.color, "Opt-out immediately restores body color")
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "Opt-out clears the owned body overlays")

/datum/game_test/room_test/gs13_blueberry_dose_and_drain/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["blueberry_inflation"] = TRUE
	subject.adjust_fatness(500, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.adjust_perma(30, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.reagents.add_reagent("blueberry_juice", 50)
	TEST_ASSERT(abs(subject.fatness - 840) < 0.001, "Juice adds apparent mass without rewriting regular or permanent fat")
	subject.reagents.add_reagent("blueberry_juice", 50)
	TEST_ASSERT(abs(subject.fatness - 1770) < 0.001, "Merging a dose immediately recomputes the squared-volume contribution")
	TEST_ASSERT_EQUAL(subject.fatness_real, 500, "Transformations preserve underlying ordinary weight")
	TEST_ASSERT_EQUAL(subject.fatness_perma, 30, "Transformations preserve underlying permanent weight")
	var/datum/component/gs13_transformation/controller = subject.GetComponent(/datum/component/gs13_transformation)
	TEST_ASSERT_EQUAL(length(controller.sources), 1, "Dose merges do not create extra sources")
	subject.reagents.remove_reagent("blueberry_juice", 50)
	TEST_ASSERT(abs(subject.fatness - 840) < 0.001, "Partial draining shrinks the body immediately")
	subject.reagents.del_reagent("blueberry_juice")
	TEST_ASSERT_EQUAL(subject.fatness, 530, "Complete drainage reveals the actual regular and permanent weight")
	TEST_ASSERT(QDELETED(controller), "Reagent deletion releases the last source's controller")

/datum/game_test/room_test/gs13_blueberry_concealment/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["blueberry_inflation"] = TRUE
	subject.adjust_fatness(500, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.adjust_perma(30, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.reagents.add_reagent("blueberry_juice", 100)
	var/obj/item/bluespace_belt/belt = allocate(/obj/item/bluespace_belt)
	belt.forceMove(subject)
	belt.equipped(subject, ITEM_SLOT_BELT)
	TEST_ASSERT(abs(subject.fatness - 1270) < 0.001, "Independent concealment still hides ordinary fat during transformation")
	subject.reagents.clear_reagents()
	TEST_ASSERT_EQUAL(subject.fatness, 30, "Draining removes only transformation mass")
	TEST_ASSERT(belt in subject.fat_hiders, "Recovery retains an independently equipped concealment source")
	belt.dropped(subject)
	TEST_ASSERT_EQUAL(subject.fatness, 530, "Removing concealment after recovery restores the original body weight")

/datum/game_test/room_test/gs13_blueberry_species_changes/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["blueberry_inflation"] = TRUE
	subject.reagents.add_reagent("blueberry_juice", 100)
	subject.set_species(/datum/species/grey)
	TEST_ASSERT(abs(subject.fatness - 1240) < 0.001, "An eligible organic species retains the physical body's active dose")
	TEST_ASSERT_EQUAL(subject.color, "#0004ff", "A native species change retains the active transformation tint")
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "Unsupported species do not receive human weight panels")
	subject.set_species(/datum/species/machine)
	TEST_ASSERT_EQUAL(subject.fatness, 0, "A species unable to process juice releases the transformation contribution")
	TEST_ASSERT_NULL(subject.GetComponent(/datum/component/gs13_transformation), "Unsupported chemistry releases the controller")
	subject.set_species(/datum/species/human)
	TEST_ASSERT(abs(subject.fatness - 1240) < 0.001, "Returning to an eligible body rebinds its retained reagent")
	TEST_ASSERT_NOTNULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "The supported human body regains its panels")
	subject.reagents.clear_reagents()
	TEST_ASSERT_NULL(subject.color, "Recovery after species changes restores the current native appearance")

/datum/game_test/room_test/gs13_blueberry_physical_body/Run()
	var/mob/living/carbon/human/original = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human)
	var/datum/character_save/character = allocate(/datum/character_save)
	character.gs13_preferences = list("blueberry_inflation" = TRUE)
	character.apply_gs13_preferences(original)
	character.apply_gs13_preferences(recipient)
	original.reagents.add_reagent("blueberry_juice", 100)
	var/datum/mind/mind = allocate(/datum/mind)
	mind.transfer_to(original)
	mind.transfer_to(recipient)
	TEST_ASSERT(abs(original.fatness - 1240) < 0.001, "A mind transfer leaves chemical volume with its physical body")
	TEST_ASSERT_EQUAL(recipient.fatness, 0, "The recipient does not inherit the previous body's active transformation")
	TEST_ASSERT_NULL(recipient.color, "The recipient does not inherit the previous body's tint")
	original.reagents.trans_id_to(recipient, "blueberry_juice", 50)
	TEST_ASSERT(abs(original.fatness - 310) < 0.001, "A real reagent transfer recomputes the donor's state")
	TEST_ASSERT(abs(recipient.fatness - 310) < 0.001, "A real reagent transfer binds the recipient's independent state")
	character.gs13_preferences["blueberry_inflation"] = FALSE
	TEST_ASSERT(recipient.gs13_preferences["blueberry_inflation"], "Character settings and physical-body snapshots remain independent")

/datum/game_test/room_test/gs13_blueberry_death_and_deletion/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["blueberry_inflation"] = TRUE
	subject.reagents.add_reagent("blueberry_juice", 100)
	subject.death()
	TEST_ASSERT(abs(subject.fatness - 1240) < 0.001, "Death does not erase chemical mass from a corpse")
	subject.reagents.remove_reagent("blueberry_juice", 50)
	TEST_ASSERT(abs(subject.fatness - 310) < 0.001, "A corpse's appearance still follows actual reagent removal")
	subject.update_revive()
	TEST_ASSERT(abs(subject.fatness - 310) < 0.001, "Revival does not duplicate the retained dose")
	var/datum/component/gs13_transformation/controller = subject.GetComponent(/datum/component/gs13_transformation)
	qdel(subject.reagents)
	TEST_ASSERT(QDELETED(controller), "Deleting the reagent holder releases source listeners and transformation state")
	TEST_ASSERT_EQUAL(subject.fatness, 0, "Holder deletion restores stored weight")
	TEST_ASSERT_NULL(subject.color, "Holder deletion restores native color")
	var/datum/component/gs13_transformation/replacement
	subject.set_gs13_body_change("test", 150, "#0004ff")
	replacement = subject.GetComponent(/datum/component/gs13_transformation)
	qdel(subject)
	TEST_ASSERT(QDELETED(replacement), "Body deletion releases the controller even without a reagent holder")

/datum/game_test/room_test/gs13_blueberry_metabolism_and_colourless/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["blueberry_inflation"] = TRUE
	subject.reagents.add_reagent("blueberry_juice", 100)
	var/datum/reagent/blueberry_juice/juice = subject.reagents.has_reagent("blueberry_juice")
	juice.no_mob_color = TRUE
	subject.sync_gs13_transformations()
	TEST_ASSERT_NULL(subject.color, "The inherited colorless-juice option removes only the owned tint")
	TEST_ASSERT(abs(subject.fatness - 1240) < 0.001, "Colorless juice retains its volume-driven body effect")
	juice.on_mob_life(subject)
	var/expected_volume = 100 - juice.metabolization_rate * subject.metabolism_efficiency
	TEST_ASSERT(abs(subject.fatness - gs13_volume_to_fatness(expected_volume)) < 0.001, "Native metabolism updates body state as soon as volume changes")
	TEST_ASSERT_EQUAL(subject.fatness_real, 0, "Metabolizing the transformation does not create ordinary body fat")
