/datum/game_test/room_test/gs13_helplessness_preferences/Run()
	var/list/loaded = gs13_sanitize_preferences(json_encode(list("no_movement" = 500, "clumsy" = -5, "mute" = "invalid", "lisp" = 250.5)))
	TEST_ASSERT_EQUAL(loaded["no_movement"], 500, "Thresholds remain numeric after JSON roundtrip")
	TEST_ASSERT_EQUAL(loaded["clumsy"], 0, "Negative thresholds are disabled")
	TEST_ASSERT_EQUAL(loaded["mute"], 0, "Invalid thresholds fall back to disabled")
	TEST_ASSERT_EQUAL(loaded["lisp"], 250.5, "Thresholds preserve fractional BFI")
	var/datum/character_save/character = allocate(/datum/character_save)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.adjust_fatness(600, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_IMMOBILIZED), "Older saves default to no helplessness")
	character.gs13_preferences = loaded
	character.apply_gs13_preferences(subject, FALSE)
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_IMMOBILIZED, HELPLESSNESS_TRAIT), "Live character edits activate the threshold even with weight gain off")
	TEST_ASSERT_EQUAL(subject.fatness_real, 600, "Live threshold edits preserve body weight")
	character.gs13_preferences["no_movement"] = 0
	character.apply_gs13_preferences(subject, FALSE)
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_IMMOBILIZED), "Zero disables a live threshold immediately")
	TEST_ASSERT(gs13_numeric_preference("no_movement"), "The preference editor must use numeric input")
	TEST_ASSERT_NOT(gs13_numeric_preference("master_wg_pref"), "Ordinary preferences remain toggles")

/datum/game_test/room_test/gs13_helplessness_effective_weight/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["no_movement"] = 500
	subject.gs13_preferences["muscle_gain"] = TRUE
	subject.adjust_fatness(300, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.adjust_perma(200, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_NOT(subject.mobility_flags & MOBILITY_MOVE, "The exact effective-weight boundary blocks native movement")
	subject.adjust_muscle(1, TRUE)
	TEST_ASSERT(subject.mobility_flags & MOBILITY_MOVE, "Muscle relief removes helplessness immediately")
	subject.adjust_muscle(-1, TRUE)
	TEST_ASSERT_NOT(subject.mobility_flags & MOBILITY_MOVE, "Removing muscle reapplies the threshold")
	var/obj/item/bluespace_belt/belt = allocate(/obj/item/bluespace_belt)
	belt.forceMove(subject)
	belt.equipped(subject, ITEM_SLOT_BELT)
	TEST_ASSERT(subject.mobility_flags & MOBILITY_MOVE, "Concealed fat does not count toward helplessness")
	qdel(belt)
	TEST_ASSERT_NOT(subject.mobility_flags & MOBILITY_MOVE, "Revealing weight reapplies helplessness")
	subject.set_gs13_body_size(2)
	TEST_ASSERT_NOT(subject.mobility_flags & MOBILITY_MOVE, "Physical scale does not change the BFI threshold")
	subject.fully_heal_fatness(TRUE, null, null)
	TEST_ASSERT(subject.mobility_flags & MOBILITY_MOVE, "Weight recovery restores native mobility")

/datum/game_test/room_test/gs13_helplessness_native_actions/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/toy/crayon/red/held = allocate(/obj/item/toy/crayon/red)
	subject.put_in_active_hand(held)
	subject.gs13_preferences["immobile_arms"] = 100
	subject.gs13_preferences["clumsy"] = 100
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_NOT(subject.mobility_flags & MOBILITY_USE, "Native hand use is blocked")
	TEST_ASSERT_NOT(subject.mobility_flags & MOBILITY_PICKUP, "Native pickup is blocked")
	TEST_ASSERT_EQUAL(held.loc, subject.loc, "The normal hands-blocked handler drops held items")
	TEST_ASSERT_NOT(subject.put_in_active_hand(held), "Blocked hands cannot pick the item back up")
	var/obj/item/gun/energy/gun/weapon = allocate(/obj/item/gun/energy/gun)
	TEST_ASSERT_NOT(subject.can_use_guns(weapon), "Clumsy fingers use the native trigger guard check")
	ADD_TRAIT(subject, TRAIT_HANDS_BLOCKED, "independent")
	subject.fully_heal_fatness(FALSE, null, null)
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_HANDS_BLOCKED, "independent"), "Recovery preserves independently blocked hands")
	TEST_ASSERT_NOT(HAS_TRAIT_FROM(subject, TRAIT_HANDS_BLOCKED, HELPLESSNESS_TRAIT), "Recovery removes only its own restriction")
	REMOVE_TRAIT(subject, TRAIT_HANDS_BLOCKED, "independent")
	TEST_ASSERT(subject.mobility_flags & MOBILITY_USE, "Normal hand use returns after the final blocker is removed")
	TEST_ASSERT(subject.can_use_guns(weapon), "Trigger use recovers after weight loss")

/datum/game_test/room_test/gs13_helplessness_speech_and_face/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["lisp"] = 100
	subject.gs13_preferences["hidden_face"] = 100
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/datum/multilingual_say_piece/spoken = new(null, "six socks")
	var/datum/multilingual_say_piece/noise = new(GLOB.all_languages["Noise"], "six socks")
	subject.handle_speech_problems(list(spoken, noise), "says")
	TEST_ASSERT_EQUAL(spoken.message, "thith thockth", "Native speech applies the source lisp substitutions")
	TEST_ASSERT_EQUAL(noise.message, "six socks", "Nonspoken/no-stutter language is preserved")
	qdel(spoken)
	qdel(noise)
	TEST_ASSERT_EQUAL(subject.get_face_name(), "Unknown", "Native face recognition respects the temporary effect")
	var/obj/item/organ/external/head/head = subject.get_organ("head")
	TEST_ASSERT_NOT(head.status & ORGAN_DISFIGURED, "Concealing a face does not injure the organ")
	subject.gs13_preferences["mute"] = 100
	subject.handle_gs13_helplessness()
	TEST_ASSERT_NOT(subject.IsVocal(), "Muteness uses the native vocal check")
	ADD_TRAIT(subject, TRAIT_MUTE, "independent")
	head.status |= ORGAN_DISFIGURED
	subject.fully_heal_fatness(FALSE, null, null)
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_GS13_LISP), "The lisp clears after weight loss")
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_GS13_HIDDEN_FACE), "The face effect clears after weight loss")
	TEST_ASSERT_EQUAL(subject.get_face_name(), "Unknown", "Recovery cannot heal unrelated facial injuries")
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_MUTE, "independent"), "Recovery preserves independent muteness")
	head.status &= ~ORGAN_DISFIGURED
	REMOVE_TRAIT(subject, TRAIT_MUTE, "independent")
	TEST_ASSERT_EQUAL(subject.get_face_name(), subject.real_name, "An uninjured face is recognized again")

/datum/game_test/room_test/gs13_helplessness_nearsight/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["nearsighted"] = 100
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_NOTNULL(subject.screens["nearsighted"], "The native vision overlay activates immediately")
	var/obj/item/clothing/glasses/regular/glasses = allocate(/obj/item/clothing/glasses/regular)
	TEST_ASSERT(subject.equip_to_slot_if_possible(glasses, ITEM_SLOT_EYES), "The fixture equips prescription glasses normally")
	TEST_ASSERT_NULL(subject.screens["nearsighted"], "Prescription glasses correct weight-driven nearsightedness")
	subject.drop_item_to_ground(glasses)
	TEST_ASSERT_NOTNULL(subject.screens["nearsighted"], "Removing glasses restores the impairment")
	ADD_TRAIT(subject, TRAIT_NEARSIGHT, "independent")
	subject.fully_heal_fatness(FALSE, null, null)
	TEST_ASSERT_NOTNULL(subject.screens["nearsighted"], "Weight recovery cannot remove an independent vision impairment")
	TEST_ASSERT_NOT(HAS_TRAIT_FROM(subject, TRAIT_NEARSIGHT, HELPLESSNESS_TRAIT), "The weight source has been removed")

/datum/game_test/room_test/gs13_helplessness_quirks/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.adjust_fatness(FATNESS_LEVEL_BARELYMOBILE, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/datum/quirk/gs13_helplessness_immobile/quirk = new
	quirk.apply_quirk_effects(subject)
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_IMMOBILIZED), "The quirk uses the source's normal immobility threshold")
	ADD_TRAIT(subject, TRAIT_WEAKLEGS, "independent")
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_IMMOBILIZED, HELPLESSNESS_TRAIT), "Weak Legs lowers the quirk threshold immediately")
	REMOVE_TRAIT(subject, TRAIT_WEAKLEGS, "independent")
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_IMMOBILIZED), "Removing Weak Legs restores the higher quirk threshold immediately")
	ADD_TRAIT(subject, TRAIT_WEAKLEGS, "independent")
	qdel(quirk)
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_IMMOBILIZED), "Removing the quirk restores the disabled preference")
	TEST_ASSERT(HAS_TRAIT(subject, TRAIT_WEAKLEGS), "Quirk removal preserves unrelated leg traits")
	var/datum/quirk/gs13_helplessness_clumsy/clumsy = new
	clumsy.apply_quirk_effects(subject)
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_CHUNKYFINGERS, HELPLESSNESS_TRAIT), "The clumsy quirk applies at its source threshold")
	qdel(clumsy)
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_CHUNKYFINGERS), "Quirk removal cleans up its effect immediately")

/datum/game_test/room_test/gs13_helplessness_lifecycle/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["no_movement"] = 100
	subject.gs13_preferences["mute"] = 100
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	ADD_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "first")
	ADD_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "second")
	TEST_ASSERT_NOT(HAS_TRAIT_FROM(subject, TRAIT_IMMOBILIZED, HELPLESSNESS_TRAIT), "Immunity clears an existing effect")
	REMOVE_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "first")
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_MUTE), "One remaining immunity source still protects the body")
	REMOVE_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "second")
	TEST_ASSERT(HAS_TRAIT(subject, TRAIT_MUTE), "Removing the last immunity source reevaluates thresholds")
	ADD_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "bulk")
	REMOVE_TRAITS_IN(subject, "bulk")
	TEST_ASSERT(HAS_TRAIT(subject, TRAIT_MUTE), "Bulk source removal without a trait argument also reevaluates thresholds")
	subject.death()
	TEST_ASSERT_NOT(HAS_TRAIT_FROM(subject, TRAIT_MUTE, HELPLESSNESS_TRAIT), "Death clears helplessness effects")
	subject.update_revive()
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_MUTE, HELPLESSNESS_TRAIT), "Revival reapplies the body's thresholds")
	var/datum/component/gs13_helplessness/controller = subject.GetComponent(/datum/component/gs13_helplessness)
	qdel(controller)
	TEST_ASSERT_NOT(HAS_TRAIT_FROM(subject, TRAIT_MUTE, HELPLESSNESS_TRAIT), "Component deletion removes owned effects")
	subject.handle_gs13_helplessness()
	controller = subject.GetComponent(/datum/component/gs13_helplessness)
	qdel(subject)
	TEST_ASSERT(QDELETED(controller), "Body deletion also deletes its controller")

/datum/game_test/room_test/gs13_helplessness_server_thresholds
	var/list/old_forced
	var/turf/allowed_turf
	var/area/original_area
	var/area/allowed_area

/datum/game_test/room_test/gs13_helplessness_server_thresholds/Destroy()
	if(old_forced)
		GLOB.configuration.gs13.forced_helplessness = old_forced
	if(allowed_turf && original_area)
		original_area.contents += allowed_turf
		allowed_turf.change_area(allowed_area, original_area)
	QDEL_NULL(allowed_area)
	return ..()

/datum/game_test/room_test/gs13_helplessness_server_thresholds/Run()
	old_forced = GLOB.configuration.gs13.forced_helplessness
	GLOB.configuration.gs13.forced_helplessness = list()
	GLOB.configuration.gs13.load_data(list("forced_helplessness" = list("mute" = 200, "clumsy" = -5, "lisp" = INFINITY, "unknown" = 1)))
	TEST_ASSERT_EQUAL(GLOB.configuration.gs13.forced_helplessness["clumsy"], 0, "Server thresholds reject negatives")
	TEST_ASSERT_NULL(GLOB.configuration.gs13.forced_helplessness["lisp"], "Nonfinite server thresholds are ignored")
	TEST_ASSERT_NULL(GLOB.configuration.gs13.forced_helplessness["unknown"], "Unknown config keys are ignored")
	var/list/turfs = get_available_turfs()
	allowed_turf = turfs[1]
	var/turf/outside = turfs[2]
	original_area = get_area(allowed_turf)
	allowed_area = new /area/station/public/dorms
	allowed_area.contents += allowed_turf
	allowed_turf.change_area(original_area, allowed_area)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human, outside)
	subject.adjust_fatness(200, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT(HAS_TRAIT(subject, TRAIT_MUTE), "Forcing applies outside the allowed areas even with a disabled character threshold")
	subject.forceMove(allowed_turf)
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_MUTE), "Actual movement into a safe area removes forced helplessness")
	subject.gs13_preferences["mute"] = 200
	subject.handle_gs13_helplessness()
	TEST_ASSERT(HAS_TRAIT(subject, TRAIT_MUTE), "Safe areas do not override a voluntarily enabled threshold")
	subject.gs13_preferences["mute"] = 0
	subject.forceMove(outside)
	ADD_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "independent")
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_MUTE), "Immunity overrides server forcing")

/datum/game_test/room_test/gs13_helplessness_clothing_fit/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/clothing/under/color/red/uniform = allocate(/obj/item/clothing/under/color/red)
	var/obj/item/toy/crayon/red/pocket_item = allocate(/obj/item/toy/crayon/red)
	TEST_ASSERT(subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT), "The ordinary uniform initially fits")
	TEST_ASSERT(subject.equip_to_slot_if_possible(pocket_item, ITEM_SLOT_LEFT_POCKET), "The uniform supports native pocket equipment")
	subject.gs13_preferences["clothing_jumpsuit"] = 100
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_NULL(subject.w_uniform, "The threshold removes an ordinary jumpsuit")
	TEST_ASSERT_EQUAL(uniform.loc, subject.loc, "The uniform is recovered on the ground")
	TEST_ASSERT_EQUAL(pocket_item.loc, subject.loc, "Native uniform removal also drops dependent pocket contents")
	TEST_ASSERT_NOT(subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT), "Normal re-equipping cannot bypass the fit restriction")
	var/obj/item/clothing/under/color/grey/modular = allocate(/obj/item/clothing/under/color/grey)
	TEST_ASSERT(subject.equip_to_slot_if_possible(modular, ITEM_SLOT_JUMPSUIT), "Adapted modular uniforms fit at the same weight")
	subject.handle_weight_gain(0)
	TEST_ASSERT_EQUAL(subject.w_uniform, modular, "A later refresh preserves a compatible modular uniform")
	subject.drop_item_to_ground(modular)
	subject.fully_heal_fatness(FALSE, null, null)
	TEST_ASSERT(subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT), "Normal fit returns after weight loss")

/datum/game_test/room_test/gs13_helplessness_misc_fit/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/list/equipment = list()
	// Slot IDs are numeric bitflags, so use an ordinary indexed list for them.
	var/list/slots = list(ITEM_SLOT_OUTER_SUIT, ITEM_SLOT_GLOVES, ITEM_SLOT_SHOES)
	var/list/paths = list(/obj/item/clothing/suit/jacket/miljacket, /obj/item/clothing/gloves/color/yellow, /obj/item/clothing/shoes/black)
	for(var/i in 1 to length(slots))
		var/obj/item/item = allocate(paths[i])
		equipment += item
		TEST_ASSERT(subject.equip_to_slot_if_possible(item, slots[i]), "Ordinary outerwear fits below the threshold")
	subject.gs13_preferences["clothing_misc"] = 100
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	for(var/i in 1 to length(slots))
		var/obj/item/item = equipment[i]
		TEST_ASSERT_EQUAL(item.loc, subject.loc, "The threshold drops incompatible outerwear")
		TEST_ASSERT_NOT(subject.equip_to_slot_if_possible(item, slots[i]), "The native equip path blocks incompatible outerwear")
	var/obj/item/mod/control/pre_equipped/control = allocate(/obj/item/mod/control/pre_equipped)
	subject.gs13_preferences["clothing_back"] = 100
	subject.handle_gs13_helplessness()
	gs13_activate_test_mod(subject, control)
	TEST_ASSERT(control.active, "A native MOD control deploys despite the back and outerwear restrictions")
	TEST_ASSERT_EQUAL(subject.wear_suit, control.chestplate, "The MOD chestplate remains equipped")
	TEST_ASSERT_EQUAL(subject.gloves, control.gauntlets, "The MOD gauntlets remain equipped")
	TEST_ASSERT_EQUAL(subject.shoes, control.boots, "The MOD boots remain equipped")
	subject.handle_weight_gain(0)
	TEST_ASSERT_EQUAL(subject.back, control, "A later refresh preserves the complete MODsuit")

/datum/game_test/room_test/gs13_helplessness_storage_fit/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey)
	var/obj/item/storage/backpack/bag = allocate(/obj/item/storage/backpack)
	var/obj/item/storage/belt/utility/belt = allocate(/obj/item/storage/belt/utility)
	var/obj/item/clothing/neck/human_petcollar/collar = allocate(/obj/item/clothing/neck/human_petcollar)
	var/obj/item/toy/crayon/red/stored = allocate(/obj/item/toy/crayon/red)
	stored.forceMove(bag)
	TEST_ASSERT(subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT), "The fixture has a uniform for its belt")
	TEST_ASSERT(subject.equip_to_slot_if_possible(bag, ITEM_SLOT_BACK), "The backpack initially fits")
	TEST_ASSERT(subject.equip_to_slot_if_possible(belt, ITEM_SLOT_BELT), "The belt initially fits")
	TEST_ASSERT(subject.equip_to_slot_if_possible(collar, ITEM_SLOT_NECK), "The neckwear initially fits")
	for(var/key in list("clothing_back", "belts", "no_neck"))
		subject.gs13_preferences[key] = 100
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_NULL(subject.back, "Back equipment is removed")
	TEST_ASSERT_NULL(subject.belt, "The ordinary belt is removed")
	TEST_ASSERT_NULL(subject.neck, "Neckwear is removed")
	TEST_ASSERT_EQUAL(stored.loc, bag, "Dropping storage retains its contents")
	TEST_ASSERT_NOT(subject.equip_to_slot_if_possible(bag, ITEM_SLOT_BACK), "New back equipment is blocked")
	TEST_ASSERT_NOT(subject.equip_to_slot_if_possible(belt, ITEM_SLOT_BELT), "New ordinary belts are blocked")
	TEST_ASSERT_NOT(subject.equip_to_slot_if_possible(collar, ITEM_SLOT_NECK), "New neckwear is blocked")
	var/obj/item/bluespace_belt/bluespace = allocate(/obj/item/bluespace_belt)
	TEST_ASSERT(subject.equip_to_slot_if_possible(bluespace, ITEM_SLOT_BELT), "Bluespace concealment belts remain usable")
	TEST_ASSERT_NOT(HAS_TRAIT_FROM(subject, TRAIT_NO_BACKPACK, HELPLESSNESS_TRAIT), "Concealment immediately recalculates other restrictions")
	subject.drop_item_to_ground(bluespace)
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_NO_BACKPACK, HELPLESSNESS_TRAIT), "Removing concealment restores the restriction")

/datum/game_test/room_test/gs13_helplessness_locked_clothing/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/clothing/neck/human_petcollar/locked/collar = allocate(/obj/item/clothing/neck/human_petcollar/locked)
	TEST_ASSERT(subject.equip_to_slot_if_possible(collar, ITEM_SLOT_NECK), "The collar initially fits")
	collar.locked = TRUE
	subject.gs13_preferences["no_neck"] = 100
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_EQUAL(subject.neck, collar, "Weight does not bypass a collar's native lock")
	collar.locked = FALSE
	subject.handle_weight_gain(0)
	TEST_ASSERT_NULL(subject.neck, "An unlocked incompatible collar drops on the next refresh")
	var/obj/item/clothing/shoes/black/shoes = allocate(/obj/item/clothing/shoes/black)
	TEST_ASSERT(subject.equip_to_slot_if_possible(shoes, ITEM_SLOT_SHOES), "Shoes initially fit")
	shoes.flags |= NODROP
	subject.gs13_preferences["clothing_misc"] = 100
	subject.handle_gs13_helplessness()
	TEST_ASSERT_EQUAL(subject.shoes, shoes, "Weight does not bypass native NODROP")
	shoes.flags &= ~NODROP
	subject.handle_gs13_helplessness()
	TEST_ASSERT_NULL(subject.shoes, "Removing NODROP allows normal shedding")

/datum/game_test/room_test/gs13_helplessness_clothing_reentry/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/clothing/neck/necklace/memento_mori/calori/pendant = allocate(/obj/item/clothing/neck/necklace/memento_mori/calori)
	subject.adjust_fatness(200, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT(subject.equip_to_slot_if_possible(pendant, ITEM_SLOT_NECK), "The pendant initially fits")
	TEST_ASSERT(pendant.bind_owner(subject), "The native pendant conceals the fixture's weight")
	subject.gs13_preferences["no_movement"] = 100
	ADD_TRAIT(subject, TRAIT_NO_NECK, "independent")
	subject.handle_gs13_helplessness()
	TEST_ASSERT_NULL(subject.neck, "Independent neck restrictions remove the pendant through normal unequipping")
	TEST_ASSERT_EQUAL(subject.fatness, 200, "Pendant removal reveals the real weight without disabled magic penalties")
	TEST_ASSERT_NOT(subject.mobility_flags & MOBILITY_MOVE, "The same refresh completes the weight recalculation after concealment is removed")
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_NO_NECK, "independent"), "The refresh preserves an independent restriction")

/datum/game_test/room_test/gs13_helplessness_buckling/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/structure/chair/chair = allocate(/obj/structure/chair, subject.loc)
	subject.gs13_preferences["no_buckle"] = 100
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_NOT(chair.buckle_mob(subject), "A normal buckle attempt respects the threshold")
	TEST_ASSERT_NULL(subject.buckled, "A rejected attempt leaves no buckle reference")
	TEST_ASSERT(chair.buckle_mob(subject, force = TRUE), "The native force override remains available")
	chair.unbuckle_mob(subject, force = TRUE)
	ADD_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "independent")
	TEST_ASSERT(chair.buckle_mob(subject), "Helplessness immunity restores normal buckling")
	REMOVE_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "independent")
	TEST_ASSERT_EQUAL(subject.buckled, chair, "Crossing a no-buckle threshold does not forcibly eject an existing occupant")
	chair.unbuckle_mob(subject)
	subject.fully_heal_fatness(FALSE, null, null)
	TEST_ASSERT(chair.buckle_mob(subject), "Weight loss restores normal buckling")

/datum/game_test/room_test/gs13_helplessness_chair_breakage/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/structure/chair/chair = allocate(/obj/structure/chair, subject.loc)
	subject.gs13_preferences["chair_breakage"] = 100
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT(chair.buckle_mob(subject), "A chair survives the exact source threshold")
	subject.gs13_preferences["muscle_gain"] = TRUE
	subject.adjust_muscle(1000, TRUE)
	subject.adjust_fatness(1, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT(QDELETED(chair), "Seated weight gain breaks the chair even with muscle relief")
	TEST_ASSERT_NULL(subject.buckled, "Native destruction releases the occupant")
	TEST_ASSERT_NOT(HAS_TRAIT_FROM(subject, TRAIT_IMMOBILIZED, BUCKLING_TRAIT), "Native destruction clears its buckle movement blocker")
	var/obj/structure/chair/next_chair = allocate(/obj/structure/chair, subject.loc)
	TEST_ASSERT_NOT(next_chair.buckle_mob(subject), "A chair that breaks on entry cannot report a successful buckle")
	TEST_ASSERT(QDELETED(next_chair), "A new chair also breaks above the threshold")
	subject.gs13_preferences["chair_breakage"] = 0
	var/obj/structure/chair/disabled_chair = allocate(/obj/structure/chair, subject.loc)
	TEST_ASSERT(disabled_chair.buckle_mob(subject), "Zero disables chair breakage")
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_NOT(QDELETED(disabled_chair), "Further gain preserves a chair when breakage is disabled")

/datum/game_test/room_test/gs13_helplessness_chair_cleanup/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/structure/chair/chair = allocate(/obj/structure/chair, subject.loc)
	subject.gs13_preferences["chair_breakage"] = 100
	TEST_ASSERT(chair.buckle_mob(subject), "The fixture begins seated")
	chair.unbuckle_mob(subject)
	subject.adjust_fatness(101, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_NOT(QDELETED(chair), "An unbuckled mob cannot break its former chair")
	TEST_ASSERT_NULL(subject.buckled, "Weight gain cannot re-buckle the former occupant")
	var/obj/item/bluespace_belt/belt = allocate(/obj/item/bluespace_belt)
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey)
	subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT)
	subject.equip_to_slot_if_possible(belt, ITEM_SLOT_BELT)
	TEST_ASSERT(chair.buckle_mob(subject), "Concealed weight is compatible with the chair")
	subject.drop_item_to_ground(belt)
	TEST_ASSERT(QDELETED(chair), "Removing concealment reevaluates seated weight immediately")

/datum/game_test/room_test/gs13_helplessness_waddle_lifecycle/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.AddElement(/datum/element/waddling)
	var/datum/element/waddling/native = SSdcs.GetElement(list(/datum/element/waddling))
	var/datum/element/waddling/gs13/owned = SSdcs.GetElement(list(/datum/element/waddling/gs13))
	subject.gs13_preferences["waddle"] = 100
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_NOTNULL(owned.signal_procs?[subject], "The weight effect installs a native movement animation listener")
	ADD_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "independent")
	TEST_ASSERT_NULL(owned.signal_procs?[subject], "Immunity removes the owned listener")
	TEST_ASSERT_NOTNULL(native.signal_procs?[subject], "Immunity preserves a separately installed native waddle")
	REMOVE_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "independent")
	TEST_ASSERT_NOTNULL(owned.signal_procs?[subject], "Removing immunity restores the listener")
	subject.death()
	TEST_ASSERT_NULL(owned.signal_procs?[subject], "Death removes the owned listener")
	subject.update_revive()
	TEST_ASSERT_NOTNULL(owned.signal_procs?[subject], "Revival restores the listener")
	qdel(subject)
	TEST_ASSERT_NULL(owned.signal_procs?[subject], "Body deletion releases the listener reference")

/datum/game_test/room_test/gs13_helplessness_equipment_quirks/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.adjust_fatness(FATNESS_LEVEL_BARELYMOBILE, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/datum/quirk/gs13_helplessness_clothing/clothing = new
	clothing.apply_quirk_effects(subject)
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_NO_MISC, HELPLESSNESS_TRAIT), "Tight Clothes applies the lower outerwear threshold")
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_NO_JUMPSUIT), "Tight Clothes preserves the higher jumpsuit threshold")
	subject.adjust_fatness(FATNESS_LEVEL_IMMOBILE - FATNESS_LEVEL_BARELYMOBILE, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_NO_JUMPSUIT, HELPLESSNESS_TRAIT), "Tight Clothes applies the higher jumpsuit threshold")
	qdel(clothing)
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_NO_MISC), "Quirk removal clears outerwear restrictions")
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_NO_JUMPSUIT), "Quirk removal also clears jumpsuit restrictions")
	var/datum/quirk/gs13_helplessness_chairs/chairs = new
	var/obj/structure/chair/chair = allocate(/obj/structure/chair, subject.loc)
	TEST_ASSERT(chair.buckle_mob(subject), "The disabled breakage preference initially preserves the chair")
	chairs.apply_quirk_effects(subject)
	TEST_ASSERT(QDELETED(chair), "Applying Chair Destroyer reevaluates an existing occupied chair")
	qdel(chairs)
	var/obj/structure/chair/replacement = allocate(/obj/structure/chair, subject.loc)
	TEST_ASSERT(replacement.buckle_mob(subject), "Removing Chair Destroyer restores the disabled preference")
