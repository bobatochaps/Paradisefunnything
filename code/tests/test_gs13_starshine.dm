/datum/game_test/room_test/gs13_starshine_recipes/Run()
	var/list/recipes = list("berryjuice" = "starshine", "lemonjuice" = "starshine_yellow", "orangejuice" = "starshine_orange", "bluespace_dust" = "starshine_blue")
	for(var/ingredient in recipes)
		var/obj/item/reagent_containers/glass/beaker/beaker = allocate(/obj/item/reagent_containers/glass/beaker)
		beaker.reagents.add_reagent(ingredient, 1)
		beaker.reagents.add_reagent("sodawater", 1)
		beaker.reagents.add_reagent("sugar", 1)
		TEST_ASSERT_EQUAL(beaker.reagents.get_reagent_amount(recipes[ingredient]), 3, "Each source recipe mixes through native reagent IDs at its three-unit yield")
		TEST_ASSERT_EQUAL(beaker.reagents.total_volume, 3, "The native reaction consumes exactly its inputs")
	var/obj/machinery/chem_dispenser/soda/fountain = allocate(/obj/machinery/chem_dispenser/soda)
	TEST_ASSERT("starshine" in fountain.dispensable_reagents, "The normal soda fountain supplies Nova")
	var/obj/item/handheld_chem_dispenser/soda/portable = allocate(/obj/item/handheld_chem_dispenser/soda)
	TEST_ASSERT("starshine" in portable.dispensable_reagents, "The native portable soda equivalent supplies Nova")

/datum/game_test/room_test/gs13_starshine_light_and_nutrition/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.set_light(1.5, 0.3, "#ff0000")
	subject.nutrition = 100
	subject.reagents.add_reagent("starshine", 50)
	var/datum/reagent/consumable/starshine/drink = subject.reagents.has_reagent("starshine")
	var/obj/effect/gs13_starshine_light/glow = drink.light_holder
	TEST_ASSERT_NOTNULL(glow, "An ordinary Starshine drink creates a native light source")
	TEST_ASSERT_EQUAL(glow.loc, subject, "The glow is attached to its physical drinker")
	TEST_ASSERT(abs(glow.light_range - 3.35) < 0.001, "The light range follows the original dose formula")
	TEST_ASSERT_EQUAL(glow.light_color, drink.color, "The glow retains the source drink color")
	drink.on_mob_life(subject)
	TEST_ASSERT(subject.nutrition > 100, "Ordinary drink nutrition works with weight gain disabled")
	TEST_ASSERT_EQUAL(subject.fatness_real, 0, "Ordinary nutrition does not bypass disabled GS13 weight preferences")
	subject.reagents.add_reagent("starshine", 50)
	TEST_ASSERT_EQUAL(drink.light_holder, glow, "Merging a dose updates its existing light without allocating a second one")
	TEST_ASSERT(glow.light_range > 3.6, "Additional volume increases the native glow")
	subject.reagents.del_reagent("starshine")
	TEST_ASSERT(QDELETED(glow), "Removing the drink deletes its owned light")
	TEST_ASSERT_EQUAL(subject.light_range, 1.5, "Cleanup preserves an independently applied body light")
	TEST_ASSERT_EQUAL(subject.light_color, "#ff0000", "Cleanup preserves the other light's color")

/datum/game_test/room_test/gs13_starshine_independent_lights/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.reagents.add_reagent("starshine", 25)
	subject.reagents.add_reagent("starshine_yellow", 25)
	var/datum/reagent/consumable/starshine/nova = subject.reagents.has_reagent("starshine")
	var/datum/reagent/consumable/starshine/yellow/yellow = subject.reagents.has_reagent("starshine_yellow")
	var/obj/effect/gs13_starshine_light/nova_glow = nova.light_holder
	var/obj/effect/gs13_starshine_light/yellow_glow = yellow.light_holder
	TEST_ASSERT_NOTEQUAL(nova_glow, yellow_glow, "Different drinks retain independent glow sources")
	subject.reagents.del_reagent("starshine")
	TEST_ASSERT(QDELETED(nova_glow), "Removing one drink releases only its light")
	TEST_ASSERT_NOT(QDELETED(yellow_glow), "The remaining drink's light stays active")
	subject.death()
	TEST_ASSERT(QDELETED(yellow_glow), "Death stops the drink's glow")
	subject.update_revive()
	TEST_ASSERT_NOTNULL(yellow.light_holder, "Revival rebuilds a retained drink's light")
	TEST_ASSERT_NOT(QDELETED(yellow.light_holder), "The revived light is a live native object")
	TEST_ASSERT_EQUAL(yellow.light_holder.loc, subject, "Revival does not bind the glow to an old body")

/datum/game_test/room_test/gs13_starshine_neutron_preferences/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.reagents.add_reagent("starshine_blue", 100)
	var/datum/reagent/consumable/starshine/blue/neutron = subject.reagents.has_reagent("starshine_blue")
	TEST_ASSERT_EQUAL(subject.fatness, 0, "Neutron does not bypass disabled chemical weight preferences")
	TEST_ASSERT_NOTNULL(neutron.light_holder, "Chemical weight opt-out does not remove the ordinary glow")
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.gs13_preferences["weight_gain_chems"] = TRUE
	subject.sync_gs13_transformations()
	TEST_ASSERT(abs(subject.fatness - 1240) < 0.001, "Enabled Neutron uses the source squared-volume mass formula")
	TEST_ASSERT_NULL(subject.color, "Neutron's fluid volume does not recolor the drinker's body")
	subject.gs13_preferences["blueberry_inflation"] = TRUE
	subject.reagents.add_reagent("blueberry_juice", 20)
	TEST_ASSERT(abs(subject.fatness - 1289.6) < 0.01, "Blueberry and Neutron mass remain independently additive")
	subject.gs13_preferences["weight_gain_chems"] = FALSE
	subject.sync_gs13_transformations()
	TEST_ASSERT(abs(subject.fatness - 49.6) < 0.01, "Disabling ordinary chemical effects removes only Neutron's contribution")
	TEST_ASSERT_EQUAL(subject.color, "#0004ff", "Independent blueberry coloring survives Neutron recovery")
	TEST_ASSERT_EQUAL(subject.fatness_real, 0, "Temporary drink volume never rewrites ordinary weight")
	TEST_ASSERT_EQUAL(subject.fatness_perma, 0, "Temporary drink volume never rewrites permanent weight")

/datum/game_test/room_test/gs13_starshine_species_and_transfer/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_sanitize_preferences(list("master_wg_pref" = TRUE, "weight_gain_chems" = TRUE))
	recipient.gs13_preferences = subject.gs13_preferences.Copy()
	subject.reagents.add_reagent("starshine_blue", 100)
	var/datum/reagent/consumable/starshine/blue/neutron = subject.reagents.has_reagent("starshine_blue")
	subject.set_species(/datum/species/machine)
	TEST_ASSERT(subject.can_metabolize(neutron), "Starshine retains its source synthetic processing support")
	TEST_ASSERT(abs(subject.fatness - 1240) < 0.001, "A supported synthetic body retains the fluid contribution")
	TEST_ASSERT_EQUAL(neutron.light_holder.loc, subject, "Species changes retain the body-owned light")
	subject.reagents.trans_id_to(recipient, "starshine_blue", 50)
	TEST_ASSERT(abs(subject.fatness - 310) < 0.001, "A native transfer recomputes the donor's smaller dose")
	TEST_ASSERT(abs(recipient.fatness - 310) < 0.001, "A native transfer binds the recipient's independent dose")
	var/datum/reagent/consumable/starshine/blue/received = recipient.reagents.has_reagent("starshine_blue")
	TEST_ASSERT_NOTEQUAL(neutron.light_holder, received.light_holder, "The two physical bodies do not share a mutable light object")
	TEST_ASSERT_EQUAL(received.light_holder.loc, recipient, "The new light belongs to the receiving body")

/datum/game_test/room_test/gs13_starshine_holder_cleanup/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.reagents.add_reagent("starshine_orange", 50)
	var/datum/reagent/consumable/starshine/orange/drink = subject.reagents.has_reagent("starshine_orange")
	var/obj/effect/gs13_starshine_light/glow = drink.light_holder
	qdel(subject.reagents)
	TEST_ASSERT(QDELETED(drink), "Deleting the holder deletes its drink datum")
	TEST_ASSERT(QDELETED(glow), "Deleting the holder releases the owned light")
	subject.death()
	TEST_ASSERT_NOT(QDELETED(subject), "Queued body events after drink cleanup leave the native body intact")

/datum/game_test/room_test/gs13_starshine_containers/Run()
	for(var/path in list(/obj/item/reagent_containers/drinks/starshine, /obj/item/reagent_containers/drinks/starshine/yellow, /obj/item/reagent_containers/drinks/starshine/orange, /obj/item/reagent_containers/drinks/starshine/blue))
		var/obj/item/reagent_containers/drinks/starshine/bottle = allocate(path)
		var/datum/reagent/main = bottle.reagents.get_master_reagent()
		var/expected_icon = main.drink_icon
		TEST_ASSERT_EQUAL(bottle.reagents.total_volume, 50, "Each source prefab contains fifty units")
		TEST_ASSERT(bottle.icon_state in icon_states(bottle.icon), "Each filled container has its original artwork")
		var/obj/item/reagent_containers/drinks/drinkingglass/glass = allocate(/obj/item/reagent_containers/drinks/drinkingglass)
		bottle.reagents.trans_to(glass, 50)
		TEST_ASSERT_EQUAL(glass.icon, 'modular_gs/icons/obj/starshine.dmi', "A generic native drinking glass also uses the source style")
		TEST_ASSERT_EQUAL(glass.icon_state, expected_icon, "The style follows the actual drink rather than the container subtype")
		TEST_ASSERT(bottle.icon_state in icon_states(bottle.icon), "An empty branded container has a valid source state")
		TEST_ASSERT_EQUAL(bottle.icon_state, "[initial(bottle.icon_state)]-empty", "The empty container retains its source bottle shape")
		glass.reagents.clear_reagents()
		TEST_ASSERT_EQUAL(glass.icon_state, "glass_empty", "Emptying a generic glass restores its ordinary native style")

/datum/game_test/room_test/gs13_starshine_vendor_and_supply/Run()
	var/obj/machinery/economy/vending/starshine/vendor = allocate(/obj/machinery/economy/vending/starshine)
	TEST_ASSERT_EQUAL(length(vendor.product_records), 4, "The native vendor offers all four flavors")
	TEST_ASSERT_EQUAL(vendor.get_vending_overlay_state("starshine", "off"), "starshine-off", "Native off overlays resolve the unchanged TG state names")
	TEST_ASSERT_EQUAL(vendor.get_vending_overlay_state("starshine", "broken"), "starshine-broken", "Native broken overlays resolve the unchanged TG state names")
	var/datum/data/vending_product/from_path/neutron
	for(var/datum/data/vending_product/from_path/record as anything in vendor.product_records)
		if(record.product_path == /obj/item/reagent_containers/drinks/starshine/blue)
			neutron = record
	TEST_ASSERT_NOTNULL(neutron, "Neutron is represented by a native paid product")
	TEST_ASSERT_EQUAL(neutron.amount, 10, "The premium flavor retains the source ten-item stock")
	TEST_ASSERT(neutron.price > 60, "The premium flavor has a higher native price")
	var/obj/item/reagent_containers/drinks/starshine/blue/bottle = neutron.vend(get_turf(vendor))
	TEST_ASSERT_NOTNULL(bottle, "The native product record creates the correct filled container")
	TEST_ASSERT_EQUAL(neutron.amount, 9, "Vending consumes exactly one product")
	var/obj/item/vending_refill/starshine/refill = allocate(/obj/item/vending_refill/starshine)
	TEST_ASSERT_EQUAL(vendor.restock(refill), 1, "A fresh source refill replenishes only missing stock")
	TEST_ASSERT_EQUAL(neutron.amount, 10, "Native restocking restores the depleted flavor")
	var/obj/item/circuitboard/vendor/board = allocate(/obj/item/circuitboard/vendor)
	board.set_type("Starshine Vending Machine")
	TEST_ASSERT_EQUAL(board.build_path, vendor.type, "The normal vendor board selector can construct Starshine machines")
	TEST_ASSERT_EQUAL(board.req_components[/obj/item/vending_refill/starshine], 1, "Construction requires the correct native refill")
	var/datum/supply_packs/vending/starshine/pack = allocate(/datum/supply_packs/vending/starshine)
	TEST_ASSERT(/obj/item/vending_refill/starshine in pack.contains, "Native cargo supplies the refill required for construction and restocking")
	var/obj/machinery/economy/vending/cola/ordinary = allocate(/obj/machinery/economy/vending/cola)
	TEST_ASSERT_EQUAL(ordinary.get_vending_overlay_state("Cola_Machine", "off"), "Cola_Machine_off", "Existing native vendor state names retain precedence")

/datum/game_test/room_test/gs13_cyborg_transformation_palette/Run()
	var/mob/living/silicon/robot/robot = allocate(/mob/living/silicon/robot)
	robot.module = allocate(/obj/item/robot_module/engineering, robot)
	var/obj/item/reagent_containers/borghypo/medical/feeding_tube/tube = allocate(/obj/item/reagent_containers/borghypo/medical/feeding_tube, robot.module)
	TEST_ASSERT(tube.upgrade_hypo(), "The native expansion installs the complete source palette")
	TEST_ASSERT(("blueberry_juice" in tube.get_radial_contents()) && ("starshine_blue" in tube.get_radial_contents()), "Both dependent transformation choices appear in the actual selector")
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human, get_turf(robot))
	subject.gs13_preferences = gs13_default_preferences()
	robot.zone_selected = BODY_ZONE_CHEST
	tube.forceMove(robot)
	tube.reagent_selected = "blueberry_juice"
	tube.interact_with_atom(subject, robot, list())
	TEST_ASSERT_NOT(subject.reagents.has_reagent("blueberry_juice"), "An actual cyborg dose respects blueberry opt-out")
	TEST_ASSERT_EQUAL(tube.reagent_ids["blueberry_juice"], 20, "The cyborg spends the actual attempted dose")
	subject.gs13_preferences["blueberry_inflation"] = TRUE
	tube.interact_with_atom(subject, robot, list())
	TEST_ASSERT_EQUAL(subject.reagents.get_reagent_amount("blueberry_juice"), 5, "An opted-in body receives the selected transformation chemical")
	subject.reagents.del_reagent("blueberry_juice")
	tube.reagent_selected = "starshine_blue"
	tube.interact_with_atom(subject, robot, list())
	TEST_ASSERT_EQUAL(subject.fatness, 0, "The Neutron option does not bypass ordinary chemical weight opt-out")
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.gs13_preferences["weight_gain_chems"] = TRUE
	subject.sync_gs13_transformations()
	TEST_ASSERT(abs(subject.fatness - 3.1) < 0.001, "Enabling chemical effects binds the retained Neutron volume")
	tube.remove_hypo_upgrade()
	TEST_ASSERT_NOT(("blueberry_juice" in tube.reagent_ids) || ("starshine_blue" in tube.reagent_ids), "Removing the expansion removes both dependent choices")
