/datum/game_test/room_test/gs13_moth_stomach_native_traits/Run()
	var/mob/living/carbon/human/donor = allocate(/mob/living/carbon/human)
	donor.set_species(/datum/species/moth)
	var/obj/item/organ/internal/gs13_stomach/moth/stomach = donor.get_organ_slot(GS13_ORGAN_STOMACH)
	TEST_ASSERT(istype(stomach), "Ordinary native Nian creation installs the reviewed moth digestive organ")
	TEST_ASSERT(HAS_TRAIT(donor, TRAIT_GS13_CLOTH_EATER), "The physical organ grants cloth eating through the native trait API")
	TEST_ASSERT(stomach.icon_state in icon_states(stomach.icon), "The moth stomach uses unchanged pinned source art")
	TEST_ASSERT_EQUAL(stomach.gs13_digestive_efficiency, 0.05, "The moth retains the source ordinary stomach coefficient")
	stomach.remove(donor)
	stomach.forceMove(get_turf(donor))
	TEST_ASSERT_NOT(HAS_TRAIT(donor, TRAIT_GS13_CLOTH_EATER), "Native extraction releases the organ-owned trait instead of leaving a racial bypass")
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/gs13_stomach/replaced = recipient.get_organ_slot(GS13_ORGAN_STOMACH)
	stomach.insert(recipient)
	replaced.forceMove(get_turf(recipient))
	TEST_ASSERT(HAS_TRAIT(recipient, TRAIT_GS13_CLOTH_EATER), "Actual native transplantation carries the same physical digestive ability")
	recipient.death()
	recipient.update_revive()
	TEST_ASSERT(HAS_TRAIT(recipient, TRAIT_GS13_CLOTH_EATER), "Native revival retains the installed organ's trait")
	ADD_TRAIT(recipient, TRAIT_GS13_CLOTH_EATER, "gs13_test_independent_cloth")
	qdel(stomach)
	TEST_ASSERT(HAS_TRAIT(recipient, TRAIT_GS13_CLOTH_EATER), "Deleting the physical transplant preserves independent trait sources")
	REMOVE_TRAIT(recipient, TRAIT_GS13_CLOTH_EATER, "gs13_test_independent_cloth")
	TEST_ASSERT_NOT(HAS_TRAIT(recipient, TRAIT_GS13_CLOTH_EATER), "Actual organ deletion releases its own native trait source")
	donor.set_species(/datum/species/human)
	TEST_ASSERT_NOT(HAS_TRAIT(donor, TRAIT_GS13_CLOTH_EATER), "Returning to ordinary native anatomy does not recreate the old ability")

/datum/game_test/room_test/gs13_moth_clothing_actual_bites/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.set_species(/datum/species/moth)
	subject.notransform = TRUE
	subject.nutrition = 100
	var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey)
	subject.put_in_active_hand(uniform)
	var/before = uniform.obj_integrity
	TEST_ASSERT_EQUAL(uniform.interact_with_atom(subject, subject, list()), ITEM_INTERACT_COMPLETE, "The actual native clothing interaction enters cloth feeding")
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount("gs13_cloth_fibers"), 1, "One real bite routes one source unit into actual digestive anatomy")
	TEST_ASSERT_EQUAL(uniform.obj_integrity, before - 15, "An accepted source bite damages the actual garment by fifteen native integrity")
	TEST_ASSERT_EQUAL(uniform.loc, subject, "A cloth bite retains the real native garment and its held-item slot")
	TEST_ASSERT_EQUAL(subject.get_active_hand(), uniform, "The private proxy cannot replace the physical held clothing")
	TEST_ASSERT_NOT(istype(uniform, /obj/item/food), "Ordinary clothing does not become generic food for machines and other consumers")
	var/obj/item/food/gs13_clothing/proxy = uniform.gs13_moth_snack
	TEST_ASSERT_NOTNULL(proxy, "The source private food proxy is created only for an eligible attempt")
	TEST_ASSERT_NULL(proxy.loc, "The private proxy stays out of normal map/inventory acquisition")
	uniform.interact_with_atom(subject, subject, list())
	TEST_ASSERT_EQUAL(uniform.gs13_moth_snack, proxy, "Repeated native bites share the same contextual source proxy")
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount("gs13_cloth_fibers"), 2, "A second actual native bite preserves one-unit source dosing")
	TEST_ASSERT_EQUAL(uniform.obj_integrity, before - 30, "Repeated feeding cannot grant cloth nutrition without consuming physical integrity")
	stomach.reagents.maximum_volume = stomach.reagents.total_volume
	uniform.interact_with_atom(subject, subject, list())
	TEST_ASSERT_EQUAL(uniform.obj_integrity, before - 30, "A full native stomach rejects the bite before clothing damage")
	stomach.reagents.maximum_volume = 1000
	var/obj/item/clothing/mask/muzzle/muzzle = allocate(/obj/item/clothing/mask/muzzle)
	subject.equip_to_slot(muzzle, ITEM_SLOT_MASK)
	uniform.interact_with_atom(subject, subject, list())
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount("gs13_cloth_fibers"), 2, "Actual native mouth coverage blocks contextual cloth feeding")
	subject.transfer_item_to(muzzle, get_turf(subject))
	uniform.obj_integrity = 15
	uniform.interact_with_atom(subject, subject, list())
	TEST_ASSERT(QDELETED(uniform), "Eating the last native garment integrity destroys the real clothing")
	TEST_ASSERT(QDELETED(proxy), "Actual clothing deletion cleans up its private proxy and validator")
	TEST_ASSERT_NULL(subject.get_active_hand(), "Native item destruction cleans its original held slot")

/datum/game_test/room_test/gs13_moth_cloth_native_metabolism/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.notransform = TRUE
	subject.nutrition = 300
	subject.reagents.add_reagent("gs13_cloth_fibers", 3 * REAGENTS_METABOLISM)
	var/datum/reagent/consumable/nutriment/gs13_cloth_fibers/fibers = subject.reagents.has_reagent("gs13_cloth_fibers")
	TEST_ASSERT_EQUAL(fibers.brute_heal, 0, "The source textile reagent cannot heal native brute injury")
	TEST_ASSERT_EQUAL(fibers.burn_heal, 0, "The source textile reagent cannot heal native burns")
	subject.reagents.metabolize(subject)
	TEST_ASSERT(abs(subject.nutrition - (315 + 30 * REAGENTS_METABOLISM)) < 0.01, "Actual native metabolism supplies source-scaled baseline food plus temporary cloth gain")
	TEST_ASSERT_EQUAL(fibers.gs13_delayed_nutrition_drain, 45, "The real reagent retains the matching source temporary-nutrition debt")
	subject.reagents.metabolize(subject)
	subject.reagents.metabolize(subject)
	TEST_ASSERT_NOT(subject.reagents.has_reagent("gs13_cloth_fibers"), "Actual native metabolism consumes the last textile dose")
	TEST_ASSERT(abs(subject.nutrition - (300 + 90 * REAGENTS_METABOLISM - 30)) < 0.01, "Final native deletion repays all temporary gain and the source initial debt without a last-tick escape")
	subject.satiety = GS13_MAX_SATIETY
	var/before = subject.nutrition
	subject.reagents.add_reagent("gs13_cloth_fibers", REAGENTS_METABOLISM)
	subject.reagents.metabolize(subject)
	TEST_ASSERT(abs(subject.nutrition - (before + 30 * REAGENTS_METABOLISM - 30)) < 0.01, "Maximum native satiety prevents temporary gain while preserving source final cleanup")
	subject.satiety = 0
	subject.reagents.add_reagent("gs13_cloth_fibers", 10)
	subject.reagents.metabolize(subject)
	before = subject.nutrition
	subject.reagents.del_reagent("gs13_cloth_fibers")
	TEST_ASSERT_EQUAL(subject.nutrition, before - 45, "Actual native chemical removal also settles the source reagent's accrued debt")

/datum/game_test/room_test/gs13_moth_cloth_feeding_revalidation/Run()
	var/mob/living/carbon/human/feeder = allocate(/mob/living/carbon/human)
	feeder.set_species(/datum/species/moth)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human, get_turf(feeder))
	feeder.nutrition = 100
	subject.nutrition = 100
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey)
	feeder.put_in_active_hand(uniform)
	var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	uniform.interact_with_atom(subject, feeder, list())
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount("gs13_cloth_fibers"), 1, "The actual timed native feeding path can deliver cloth to another human")
	var/obj/item/organ/internal/gs13_stomach/moth/organ = feeder.get_organ_slot(GS13_ORGAN_STOMACH)
	LAZYADD(allocated, organ)
	var/before = uniform.obj_integrity
	addtimer(CALLBACK(organ, TYPE_PROC_REF(/obj/item/organ/internal, remove), feeder), 1 SECONDS)
	uniform.interact_with_atom(subject, feeder, list())
	TEST_ASSERT_NOT(HAS_TRAIT(feeder, TRAIT_GS13_CLOTH_EATER), "Actual extraction during the native feeding delay removes the initiating ability")
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount("gs13_cloth_fibers"), 1, "A delayed bite cannot deliver a stale dose after the physical stomach is extracted")
	TEST_ASSERT_EQUAL(uniform.obj_integrity, before, "An invalidated native feeding action cannot damage its source garment")
	TEST_ASSERT_NOT(uniform.gs13_cloth_feeding, "Interrupted native feeding releases the per-garment action guard")
	organ.insert(feeder)
	var/obj/item/clothing/mask/muzzle/muzzle = allocate(/obj/item/clothing/mask/muzzle)
	feeder.transfer_item_to(uniform, get_turf(feeder))
	feeder.put_in_active_hand(muzzle)
	muzzle.interact_with_atom(feeder, feeder, list())
	TEST_ASSERT_NULL(muzzle.gs13_moth_snack, "The reviewed source muzzle exclusion cannot acquire an edible proxy")
	feeder.transfer_item_to(muzzle, get_turf(feeder))
	feeder.put_in_active_hand(uniform)
	uniform.resistance_flags |= INDESTRUCTIBLE
	uniform.interact_with_atom(feeder, feeder, list())
	TEST_ASSERT_EQUAL(uniform.obj_integrity, before, "Native indestructible clothing cannot be consumed")
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount("gs13_cloth_fibers"), 1, "Blocked clothing cannot produce an unrelated target dose")
