/datum/game_test/room_test/gs13_memento_cleanup/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/obj/item/clothing/neck/necklace/memento_mori/calori/pendant = allocate(/obj/item/clothing/neck/necklace/memento_mori/calori)
	subject.equip_to_slot_if_possible(pendant, ITEM_SLOT_NECK)
	TEST_ASSERT(pendant.bind_owner(subject), "Deletion test starts with a bound pendant")
	qdel(pendant)
	TEST_ASSERT_EQUAL(subject.fatness, 100, "Deleting the pendant restores concealed weight")
	TEST_ASSERT_EQUAL(length(subject.fat_hiders), 0, "Deleting the pendant removes its hider registration")
	pendant = allocate(/obj/item/clothing/neck/necklace/memento_mori/calori)
	subject.equip_to_slot_if_possible(pendant, ITEM_SLOT_NECK)
	TEST_ASSERT(pendant.bind_owner(subject), "Forced-movement test starts with a bound pendant")
	pendant.forceMove(get_turf(subject))
	TEST_ASSERT_NULL(pendant.active_owner, "Forced movement breaks the binding even without a normal drop")
	TEST_ASSERT_EQUAL(subject.fatness, 100, "Forced movement cannot leave weight concealed")
	subject.equip_to_slot_if_possible(pendant, ITEM_SLOT_NECK)
	var/mob/living/carbon/human/other = allocate(/mob/living/carbon/human)
	subject.unequip_to(pendant, get_turf(subject))
	other.equip_to_slot_if_possible(pendant, ITEM_SLOT_NECK)
	TEST_ASSERT(pendant.bind_owner(other), "Owner-deletion test starts with a new bound owner")
	qdel(other)
	TEST_ASSERT_NULL(pendant.active_owner, "Deleting an owner releases the pendant's reference")

/datum/game_test/room_test/gs13_cyborg_feeding/Run()
	var/mob/living/carbon/human/installer = allocate(/mob/living/carbon/human)
	var/mob/living/silicon/robot/robot = allocate(/mob/living/silicon/robot)
	var/obj/item/borg/upgrade/feeding_tube/upgrade = allocate(/obj/item/borg/upgrade/feeding_tube)
	TEST_ASSERT_NOT(upgrade.pre_install_checks(installer, robot), "Feeding tubes require a selected cyborg module")
	robot.module = allocate(/obj/item/robot_module/engineering, robot)
	installer.put_in_active_hand(upgrade)
	TEST_ASSERT(upgrade.action(installer, robot), "The feeding tube installs through the native upgrade mechanism")
	var/obj/item/reagent_containers/borghypo/medical/feeding_tube/tube = locate() in robot.module.modules
	TEST_ASSERT_NOTNULL(tube, "The installed tube appears in the cyborg module list")
	TEST_ASSERT_EQUAL(tube.cyborg, robot, "The synthesizer retains its owning cyborg for recharging")
	TEST_ASSERT_EQUAL(length(tube.get_radial_contents()), 3, "The base tube exposes all three native reagent choices")
	TEST_ASSERT_EQUAL(tube.reagent_ids["cream"], 25, "Source-sized reagent reservoirs start full")
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.forceMove(get_turf(robot))
	robot.zone_selected = "chest"
	tube.forceMove(robot)
	tube.interact_with_atom(subject, robot, list())
	TEST_ASSERT_EQUAL(subject.reagents.get_reagent_amount("cream"), 5, "Native injector interaction delivers the selected food reagent")
	TEST_ASSERT_EQUAL(tube.reagent_ids["cream"], 20, "Injection consumes its stored supply")
	robot.cell.charge = 1000
	for(var/i in 1 to 5)
		tube.process()
	TEST_ASSERT_EQUAL(robot.cell.charge, 1000, "The tube waits for the source refill interval")
	tube.process()
	TEST_ASSERT_EQUAL(tube.reagent_ids["cream"], 25, "Processing replenishes a five-unit source dose")
	TEST_ASSERT_EQUAL(robot.cell.charge, 925, "A refill consumes the scaled source power cost")
	tube.refill_hypo(robot)
	TEST_ASSERT_EQUAL(robot.cell.charge, 925, "Full reservoirs do not consume power")
	tube.interact_with_atom(subject, robot, list())
	robot.cell.charge = 0
	tube.refill_hypo(robot)
	TEST_ASSERT_EQUAL(tube.reagent_ids["cream"], 20, "An empty cell cannot synthesize free reagents")
	tube.reagent_selected = "milk"
	tube.interact_with_atom(subject, robot, list())
	robot.cell.charge = 75
	tube.refill_hypo(robot)
	TEST_ASSERT_EQUAL(tube.reagent_ids["cream"] + tube.reagent_ids["milk"], 45, "Limited charge refills only the reservoir it can pay for")
	TEST_ASSERT_EQUAL(robot.cell.charge, 0, "Power is charged separately for each depleted reservoir")

