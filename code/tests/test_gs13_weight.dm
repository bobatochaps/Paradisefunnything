/datum/game_test/room_test/gs13_exoskeleton_bundle/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.adjust_fatness(FATNESS_LEVEL_BLOB, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/obj/item/mod/control/pre_equipped/exoskeleton/control = allocate(/obj/item/mod/control/pre_equipped/exoskeleton)
	TEST_ASSERT_EQUAL(length(control.modules), 3, "The source bundle contains support, generation, and storage")
	TEST_ASSERT_EQUAL(control.complexity, control.complexity_max, "The bundle fills its five-point complexity budget")
	TEST_ASSERT_NOTNULL(control.bag, "Native storage is installed and available")
	TEST_ASSERT_EQUAL(control.get_charge(), 10000, "The prefab includes a charged native high-capacity cell")
	gs13_activate_test_mod(subject, control)
	TEST_ASSERT_EQUAL(subject.gs13_movement_delay, 3, "The bundled hydraulics assist the wearer")
	TEST_ASSERT_EQUAL(control.slowdown + control.chestplate.slowdown + control.helmet.slowdown + control.gauntlets.slowdown + control.boots.slowdown, 0, "The source exoskeleton adds no equipment slowdown")
	TEST_ASSERT_EQUAL(control.chestplate.armor.melee, 5, "The open frame retains the source's minimal armor")
	TEST_ASSERT_NOT(control.chestplate.flags & STOPSPRESSUREDMAGE, "The frame does not inherit a pressure seal")
	TEST_ASSERT_NOT(control.helmet.flags_cover & HEADCOVERSMOUTH, "The frame leaves the wearer's mouth accessible")
	TEST_ASSERT_EQUAL(subject.get_heat_protection_flags(1000), 0, "The frame provides no high-temperature protection")
	TEST_ASSERT_EQUAL(subject.get_cold_protection_flags(2.7), 0, "The frame provides no space-temperature protection")
	for(var/obj/item/clothing/part as anything in control.mod_parts)
		TEST_ASSERT_EQUAL(part.permeability_coefficient, 1, "Open parts cannot inherit chemical impermeability")
	var/obj/item/mod/module/calovoltaic/generator = locate() in control.modules
	generator.on_select()
	var/weight_before = subject.fatness_real
	control.process()
	TEST_ASSERT(abs(subject.fatness_real - (weight_before - 2.4)) < 0.001, "At full charge, generation replaces only suit and hydraulic upkeep")
	TEST_ASSERT_EQUAL(control.get_charge(), 10000, "The bundled generator can replenish the suit's six-charge upkeep")

/datum/game_test/room_test/gs13_exoskeleton_appearance/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.adjust_fatness(FATNESS_LEVEL_OBESE, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/obj/item/mod/control/pre_equipped/exoskeleton/control = allocate(/obj/item/mod/control/pre_equipped/exoskeleton)
	gs13_activate_test_mod(subject, control)
	TEST_ASSERT_EQUAL(length(gs13_weight_panel_states(subject)), 2, "An open exoskeleton preserves both visible body panels")
	TEST_ASSERT(control.chestplate.body_parts_covered & UPPER_TORSO, "Preserving appearance does not remove armor coverage")
	var/list/all_parts = control.mod_parts + control
	for(var/obj/item/part as anything in all_parts)
		TEST_ASSERT(part.icon_state in icon_states(part.icon), "Every deployed part has its original object state")
		TEST_ASSERT(part.icon_state in icon_states(part.worn_icon), "Every deployed part has its original worn state")
		TEST_ASSERT_EQUAL(length(part.sprite_sheets), 0, "Native species sheets cannot replace the source exoskeleton artwork")
	gs13_render_weight_preview(subject, "exoskeleton_body")
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey)
	subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT)
	TEST_ASSERT("belly_soft_4" in gs13_weight_panel_states(subject), "The open frame preserves modular uniform panels")
	gs13_render_weight_preview(subject, "exoskeleton_uniform")
	subject.drop_item_to_ground(control, force = TRUE)
	control.set_mod_skin("invisible")
	gs13_activate_test_mod(subject, control)
	for(var/obj/item/part as anything in all_parts)
		TEST_ASSERT_EQUAL(part.worn_icon_state, "nothing", "The invisible skin uses an explicit blank worn state")
		TEST_ASSERT(part.worn_icon_state in icon_states(part.worn_icon), "Invisible appearance never relies on missing icon states")
		TEST_ASSERT(part.icon_state in icon_states(part.icon), "Invisible worn parts remain identifiable as inventory objects")
	gs13_render_weight_preview(subject, "exoskeleton_invisible")
	subject.drop_item_to_ground(control, force = TRUE)
	control.set_mod_skin("exoskeleton")
	TEST_ASSERT_NULL(control.chestplate.worn_icon_state, "Returning to the visible skin clears the blank override")
	var/obj/item/mod/control/pre_equipped/standard = allocate(/obj/item/mod/control/pre_equipped)
	TEST_ASSERT_NOT(standard.chestplate.gs13_shows_weight_body, "Ordinary sealed MODsuits retain native body coverage")

/datum/game_test/room_test/gs13_exoskeleton_construction/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/mod/construction/shell/shell = allocate(/obj/item/mod/construction/shell)
	shell.forceMove(get_turf(subject))
	var/obj/item/mod/core/standard/core = allocate(/obj/item/mod/core/standard)
	core.cell = allocate(/obj/item/stock_parts/cell/high)
	subject.put_in_active_hand(core)
	shell.item_interaction(subject, core, list())
	var/obj/item/screwdriver/screwdriver = allocate(/obj/item/screwdriver)
	shell.screwdriver_act(subject, screwdriver)
	for(var/part_type in list(/obj/item/mod/construction/helmet, /obj/item/mod/construction/chestplate, /obj/item/mod/construction/gauntlets, /obj/item/mod/construction/boots))
		var/obj/item/part = allocate(part_type)
		subject.put_in_active_hand(part)
		shell.item_interaction(subject, part, list())
	var/obj/item/wrench/wrench = allocate(/obj/item/wrench)
	shell.wrench_act(subject, wrench)
	shell.screwdriver_act(subject, screwdriver)
	var/obj/item/mod/construction/plating/exoskeleton/plating = allocate(/obj/item/mod/construction/plating/exoskeleton)
	TEST_ASSERT(plating.icon_state in icon_states(plating.icon), "Plating uses the source's actual GS13_exo icon prefix")
	subject.put_in_active_hand(plating)
	shell.item_interaction(subject, plating, list())
	TEST_ASSERT(QDELETED(shell), "Native assembly consumes the construction shell")
	TEST_ASSERT(QDELETED(plating), "Native assembly consumes the external plating")
	var/obj/item/mod/control/control = subject.get_active_hand()
	TEST_ASSERT(istype(control), "Native assembly puts the finished controller in the builder's hand")
	TEST_ASSERT(istype(control.theme, /datum/mod_theme/exoskeleton), "External plating selects the exoskeleton theme")
	TEST_ASSERT_EQUAL(control.core, core, "Assembly transfers the supplied power core")
	TEST_ASSERT_EQUAL(length(control.modules), 3, "Assembled suits receive all theme modules")
	TEST_ASSERT(control.chestplate.gs13_shows_weight_body, "Assembled suits use the same open-frame appearance adapter")

/datum/game_test/room_test/gs13_exoskeleton_locked_and_design/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/pre_equipped/exoskeleton/locked/control = allocate(/obj/item/mod/control/pre_equipped/exoskeleton/locked)
	for(var/obj/item/mod/module/module as anything in control.modules)
		TEST_ASSERT_NOT(module.removable, "The locked prefab fixes all three modules in place")
	control.open = TRUE
	var/obj/item/mod/core/original_core = control.core
	var/obj/item/wrench/wrench = allocate(/obj/item/wrench)
	control.wrench_act(subject, wrench)
	TEST_ASSERT_EQUAL(control.core, original_core, "Pre-built exoskeleton cores cannot be removed with a wrench")
	var/obj/item/mod/core/standard/standard_core = control.core
	standard_core.cell.forceMove(get_turf(subject))
	TEST_ASSERT_NULL(standard_core.cell, "The fixed core still permits ordinary cell replacement")
	var/datum/design/mod_shell/exoskeleton/design = new
	var/obj/item/mod/control/pre_equipped/exoskeleton/product = allocate(design.build_path)
	TEST_ASSERT(design.build_type & MECHFAB, "The complete prefab is available through native MOD research")
	TEST_ASSERT_EQUAL(product.materials[MAT_PLASMA], design.materials[MAT_PLASMA], "Prefab material costs match its design")
	qdel(design)

/datum/game_test/room_test/proc/gs13_grant_gain(mob/living/carbon/human/caster)
	caster.mind_initialize()
	var/datum/spell/touch/fatten_up/spell = allocate(/datum/spell/touch/fatten_up)
	caster.mind.AddSpell(spell)
	spell.charge_hand(caster)
	return spell

/datum/game_test/room_test/gs13_gain_touch/Run()
	var/mob/living/carbon/human/caster = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human)
	victim.forceMove(get_turf(caster))
	victim.gs13_preferences["master_wg_pref"] = TRUE
	victim.gs13_preferences["weight_gain_magic"] = TRUE
	var/datum/spell/touch/fatten_up/spell = gs13_grant_gain(caster)
	var/obj/item/melee/touch_attack/fatten_up/hand = spell.attached_hand
	TEST_ASSERT(istype(hand), "The native spell action creates the Gain hand")
	TEST_ASSERT_EQUAL(hand.loc, caster, "The native touch spell equips its caster's hand")
	TEST_ASSERT(spell.can_cast(caster), "Gain does not require wizard clothing")
	hand.after_attack(victim, caster, TRUE, null)
	TEST_ASSERT_EQUAL(victim.fatness_real, 50, "Gain applies the source's 100 weight request through the target's multiplier")
	TEST_ASSERT(QDELETED(hand), "A successful touch consumes its charged hand")
	TEST_ASSERT_NULL(spell.attached_hand, "Native touch cleanup clears the spell's reference")
	TEST_ASSERT(spell.cooldown_handler.is_on_cooldown(), "A successful hit starts the native spell cooldown")
	TEST_ASSERT_EQUAL(spell.cooldown_handler.recharge_duration, 30 SECONDS, "The initial cooldown is thirty seconds")
	for(var/level in 1 to 4)
		spell.spell_level = level
		spell.on_purchase_upgrade()
		TEST_ASSERT_EQUAL(spell.cooldown_handler.recharge_duration, max((30 - 10 * level) SECONDS, 0.25 SECONDS), "Native upgrades preserve the source's reduction and nonzero floor")

/datum/game_test/room_test/gs13_gain_preferences_and_range/Run()
	var/mob/living/carbon/human/caster = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human)
	victim.forceMove(get_turf(caster))
	var/datum/spell/touch/fatten_up/spell = gs13_grant_gain(caster)
	spell.attached_hand.after_attack(victim, caster, FALSE, null)
	TEST_ASSERT_NOTNULL(spell.attached_hand, "Out-of-reach clicks retain the spell hand")
	ADD_TRAIT(caster, TRAIT_HANDS_BLOCKED, "test")
	spell.attached_hand.after_attack(victim, caster, TRUE, null)
	TEST_ASSERT_NOTNULL(spell.attached_hand, "Blocked hands cannot deliver a touch spell")
	REMOVE_TRAIT(caster, TRAIT_HANDS_BLOCKED, "test")
	spell.attached_hand.after_attack(victim, caster, TRUE, null)
	TEST_ASSERT_EQUAL(victim.fatness_real, 0, "The target's master opt-out blocks Gain")
	victim.gs13_preferences["master_wg_pref"] = TRUE
	spell.charge_hand(caster)
	spell.attached_hand.after_attack(victim, caster, TRUE, null)
	TEST_ASSERT_EQUAL(victim.fatness_real, 0, "Gain independently requires the magic preference")
	victim.gs13_preferences["weight_gain_magic"] = TRUE
	victim.max_weight = 26
	spell.charge_hand(caster)
	spell.attached_hand.after_attack(victim, caster, TRUE, null)
	TEST_ASSERT_EQUAL(victim.fatness_real, 25, "Gain respects the configured body-weight cap")
	victim.status_flags |= GODMODE
	victim.max_weight = 0
	spell.charge_hand(caster)
	spell.attached_hand.after_attack(victim, caster, TRUE, null)
	TEST_ASSERT_EQUAL(victim.fatness_real, 25, "Gain cannot alter a godmode target")

/datum/game_test/room_test/gs13_gain_antimagic_and_cleanup/Run()
	var/mob/living/carbon/human/caster = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human)
	victim.forceMove(get_turf(caster))
	victim.gs13_preferences["master_wg_pref"] = TRUE
	victim.gs13_preferences["weight_gain_magic"] = TRUE
	ADD_TRAIT(victim, TRAIT_ANTIMAGIC, "test")
	var/datum/spell/touch/fatten_up/spell = gs13_grant_gain(caster)
	var/obj/item/melee/touch_attack/blocked_hand = spell.attached_hand
	blocked_hand.after_attack(victim, caster, TRUE, null)
	TEST_ASSERT_EQUAL(victim.fatness_real, 0, "Native antimagic blocks Gain")
	TEST_ASSERT(QDELETED(blocked_hand), "Native antimagic consumes the charged hand")
	TEST_ASSERT_EQUAL(spell.cooldown_handler.recharge_time, world.time + 15 SECONDS, "Antimagic uses the native half-cooldown refund")
	spell.charge_hand(caster)
	var/obj/item/melee/touch_attack/transferred_hand = spell.attached_hand
	TEST_ASSERT(spell.on_mind_transfer(victim), "The learned spell can follow a mind transfer")
	TEST_ASSERT(QDELETED(transferred_hand), "A mind transfer cannot leave a usable hand on the old body")
	spell.charge_hand(caster)
	var/obj/item/melee/touch_attack/deleted_hand = spell.attached_hand
	qdel(spell)
	TEST_ASSERT(QDELETED(deleted_hand), "Deleting the spell removes its active hand even after action deletion")

/datum/game_test/room_test/gs13_gain_book/Run()
	var/mob/living/carbon/human/reader = allocate(/mob/living/carbon/human)
	reader.mind_initialize()
	var/obj/item/book/granter/spell/gain/book = allocate(/obj/item/book/granter/action/spell/gain)
	TEST_ASSERT(istype(book), "The source book path aliases the native spell granter")
	book.reading_time = 0
	book.pages_to_mastery = 0
	reader.put_in_active_hand(book)
	book.activate_self(reader)
	TEST_ASSERT(locate(/datum/spell/touch/fatten_up) in reader.mind.spell_list, "Reading teaches Gain through the native mind/action API")
	TEST_ASSERT_EQUAL(book.uses, 0, "The native reading flow consumes the book's one lesson")
	TEST_ASSERT_NOT(book.can_learn(reader), "Readers cannot learn duplicate copies of Gain")
	reader.drop_item_to_ground(book)
	var/mob/living/carbon/human/next_reader = allocate(/mob/living/carbon/human)
	next_reader.mind_initialize()
	next_reader.gs13_preferences["master_wg_pref"] = TRUE
	next_reader.gs13_preferences["weight_gain_magic"] = TRUE
	next_reader.put_in_active_hand(book)
	book.activate_self(next_reader)
	TEST_ASSERT(QDELETED(book), "Attempting to read a spent tome triggers its source recoil")
	TEST_ASSERT_EQUAL(next_reader.fatness_real, 50, "Book recoil uses the magic source and the reader's multiplier")
	TEST_ASSERT_EQUAL(length(next_reader.mind.spell_list), 0, "A spent book does not teach a second reader")

/datum/game_test/room_test/gs13_food_magic_variety/Run()
	var/obj/projectile/magic/food/bolt = allocate(/obj/projectile/magic/food)
	var/list/foods = bolt.spawnable_foods.Copy()
	var/turf/floor = get_turf(bolt)
	for(var/food_type in foods)
		bolt.spawnable_foods = list(food_type)
		TEST_ASSERT(bolt.on_hit(floor), "Magic creates food on a native turf impact")
		var/obj/item/food/meal = locate(food_type) in floor
		TEST_ASSERT_NOTNULL(meal, "Each source food has a native Paradise counterpart")
		TEST_ASSERT_EQUAL(meal.reagents.get_reagent_amount("lipoifier"), 5, "Every ordinary conjured meal receives the full five-unit dose")
		qdel(meal)
	var/obj/projectile/magic/food/strong/strong = allocate(/obj/projectile/magic/food/strong)
	strong.spawnable_foods = list(/obj/item/food/sliceable/pizza/meatpizza)
	strong.on_hit(floor)
	var/obj/item/food/meal = locate(/obj/item/food/sliceable/pizza/meatpizza) in floor
	TEST_ASSERT_EQUAL(meal.reagents.get_reagent_amount("lipoifier"), 20, "A strong bolt adds the full twenty-unit dose even to a nearly full meal")
	var/mob/living/carbon/human/eater = allocate(/mob/living/carbon/human)
	eater.gs13_preferences["master_wg_pref"] = TRUE
	meal.reagents.trans_to(eater, meal.reagents.total_volume)
	eater.reagents.metabolize(eater)
	TEST_ASSERT_EQUAL(eater.fatness_real, 0, "Conjured lipoifier cannot bypass the chemical preference")
	eater.gs13_preferences["weight_gain_chems"] = TRUE
	eater.reagents.metabolize(eater)
	TEST_ASSERT(eater.fatness_real > 0, "Conjured reagents use ordinary native metabolism once enabled")

/datum/game_test/room_test/gs13_food_wand/Run()
	var/mob/living/carbon/human/caster = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/target = allocate(/mob/living/carbon/human)
	target.forceMove(get_turf(caster))
	var/obj/item/gun/magic/wand/food/wand = allocate(/obj/item/gun/magic/wand/food)
	wand.forceMove(caster)
	var/charges_before = wand.charges
	wand.process_fire(target, caster, FALSE, zone_override = "chest")
	TEST_ASSERT_EQUAL(wand.charges, charges_before - 1, "Firing through the native gun pipeline consumes one charge")
	var/obj/item/food/meal = locate() in get_turf(target)
	TEST_ASSERT_NOTNULL(meal, "A native projectile hit creates a meal at the target's feet")
	TEST_ASSERT_EQUAL(meal.reagents.get_reagent_amount("lipoifier"), 5, "The native wand delivers its configured payload")
	TEST_ASSERT_EQUAL(target.getBruteLoss() + target.getFireLoss() + target.getOxyLoss(), 0, "Food bolts are harmless impacts")
	qdel(meal)
	wand.charges = 1
	TEST_ASSERT(wand.zap_self(caster), "Self-use conjures food through the same projectile type")
	TEST_ASSERT_EQUAL(wand.charges, 0, "Self-use consumes the last charge once")
	TEST_ASSERT_EQUAL(wand.icon_state, "food_wand-drained", "The empty wand displays the original drained sprite")
	TEST_ASSERT(wand.icon_state in icon_states(wand.icon), "The source drained artwork is present")
	TEST_ASSERT_NOT(wand.zap_self(caster), "An empty wand cannot create another free meal")
	var/obj/item/gun/magic/wand/food/overpowered/strong = allocate(/obj/item/gun/magic/wand/food/overpowered)
	TEST_ASSERT(istype(strong.chambered.BB, /obj/projectile/magic/food/strong), "The stronger wand uses the stronger native projectile")
	TEST_ASSERT_NOT(wand.can_charge, "Food wands retain the source's finite, non-regenerating charge supply")

/datum/game_test/room_test/gs13_food_magic_blocking/Run()
	var/mob/living/carbon/human/target = allocate(/mob/living/carbon/human)
	var/obj/projectile/magic/food/bolt = allocate(/obj/projectile/magic/food)
	var/turf/floor = get_turf(target)
	ADD_TRAIT(target, TRAIT_ANTIMAGIC, "test")
	TEST_ASSERT_NOT(bolt.on_hit(target), "Native antimagic blocks conjuration on a living target")
	TEST_ASSERT_NOT(locate(/obj/item/food) in floor, "Blocked magic cannot leave food behind")
	REMOVE_TRAIT(target, TRAIT_ANTIMAGIC, "test")
	TEST_ASSERT_NOT(bolt.on_hit(target, INFINITY), "Complete projectile immunity also blocks conjuration")
	TEST_ASSERT_NOT(bolt.on_hit(null), "A lost impact target cannot create food or cause a runtime")
	var/turf/wall = locate(bottom_left.x, bottom_left.y, bottom_left.z)
	var/original_turf_type = wall.type
	wall = wall.ChangeTurf(/turf/simulated/wall)
	TEST_ASSERT_NOT(bolt.on_hit(wall), "Food cannot be conjured inside a wall")
	wall.ChangeTurf(original_turf_type)

/datum/game_test/room_test/proc/gs13_cross_trap(atom/movable/victim, obj/structure/trap/gs13/trap, rearm = TRUE)
	victim.forceMove(get_step(trap, NORTH))
	if(rearm)
		trap.last_trigger = world.time - trap.time_between_triggers
	victim.forceMove(get_turf(trap))

/datum/game_test/room_test/gs13_fattening_trap/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/structure/trap/fattening/trap = allocate(/obj/structure/trap/fattening)
	trap.forceMove(get_turf(bottom_left))
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.gs13_preferences["weight_gain_magic"] = TRUE
	gs13_cross_trap(subject, trap, FALSE)
	TEST_ASSERT_EQUAL(subject.fatness_real, 75, "A newly placed trap is armed and uses the target's magic gain multiplier")
	gs13_cross_trap(subject, trap, FALSE)
	TEST_ASSERT_EQUAL(subject.fatness_real, 75, "A persistent trap respects its native cooldown")
	gs13_cross_trap(subject, trap)
	TEST_ASSERT_EQUAL(subject.fatness_real, 150, "A persistent trap can trigger after recharging")
	subject.gs13_preferences["weight_gain_magic"] = FALSE
	gs13_cross_trap(subject, trap)
	TEST_ASSERT_EQUAL(subject.fatness_real, 150, "Magic opt-out blocks trap weight gain")
	subject.gs13_preferences["weight_gain_magic"] = TRUE
	subject.gs13_preferences["master_wg_pref"] = FALSE
	gs13_cross_trap(subject, trap)
	TEST_ASSERT_EQUAL(subject.fatness_real, 150, "Master opt-out blocks trap weight gain")
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.status_flags |= GODMODE
	gs13_cross_trap(subject, trap)
	TEST_ASSERT_EQUAL(subject.fatness_real, 150, "Godmode prevents trap weight gain")
	var/mob/living/carbon/alien/humanoid/hunter/nonhuman = allocate(/mob/living/carbon/alien/humanoid/hunter)
	nonhuman.gs13_preferences["master_wg_pref"] = TRUE
	nonhuman.gs13_preferences["weight_gain_magic"] = TRUE
	gs13_cross_trap(nonhuman, trap)
	TEST_ASSERT_EQUAL(nonhuman.fatness_real, 0, "The source fattening trap affects only human bodies")

/datum/game_test/room_test/gs13_trap_lifecycle/Run()
	var/obj/projectile/magic/food/projectile = allocate(/obj/projectile/magic/food)
	var/obj/effect/effect = allocate(/obj/effect)
	var/obj/item/food/donut/item = allocate(/obj/item/food/donut)
	var/obj/structure/trap/fattening/trap = allocate(/obj/structure/trap/fattening)
	var/turf/original_tile = get_turf(bottom_left)
	trap.forceMove(original_tile)
	trap.charges = 2
	gs13_cross_trap(projectile, trap)
	gs13_cross_trap(effect, trap)
	TEST_ASSERT_EQUAL(trap.charges, 2, "Projectiles and effects cannot consume trap charges")
	gs13_cross_trap(item, trap)
	TEST_ASSERT_EQUAL(trap.charges, 1, "Ordinary objects trigger the native trap")
	var/turf/new_tile = get_step(original_tile, EAST)
	trap.forceMove(new_tile)
	trap.last_trigger = world.time - trap.time_between_triggers
	item.forceMove(get_step(original_tile, NORTH))
	item.forceMove(original_tile)
	TEST_ASSERT_EQUAL(trap.charges, 1, "Moving a trap disconnects its former turf")
	item.forceMove(new_tile)
	TEST_ASSERT_EQUAL(trap.charges, 0, "The trap listens on its new turf")
	gs13_cross_trap(item, trap)
	TEST_ASSERT_EQUAL(trap.charges, 0, "An exhausted trap cannot trigger during its fading animation")
	sleep(2 SECONDS)
	TEST_ASSERT(QDELETED(trap), "The native timer removes an exhausted trap")
	item.forceMove(original_tile)
	item.forceMove(new_tile)

/datum/game_test/room_test/gs13_trap_immunity/Run()
	var/mob/living/carbon/human/caster = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human)
	caster.mind_initialize()
	victim.gs13_preferences["master_wg_pref"] = TRUE
	victim.gs13_preferences["weight_gain_magic"] = TRUE
	var/datum/spell/aoe/conjure/gs13_traps/fattening/spell = allocate(/datum/spell/aoe/conjure/gs13_traps/fattening)
	var/list/traps = spell.cast(list(get_turf(bottom_left)), caster)
	var/obj/structure/trap/fattening/trap = traps[1]
	gs13_cross_trap(caster, trap)
	TEST_ASSERT_EQUAL(trap.charges, 1, "A caster cannot trigger their own trap")
	caster.mind.transfer_to(victim)
	gs13_cross_trap(victim, trap)
	TEST_ASSERT_EQUAL(trap.charges, 1, "Trap immunity follows the caster's mind into another body")
	TEST_ASSERT_EQUAL(victim.fatness_real, 0, "The new caster body remains immune")
	caster.gs13_preferences["master_wg_pref"] = TRUE
	caster.gs13_preferences["weight_gain_magic"] = TRUE
	ADD_TRAIT(caster, TRAIT_ANTIMAGIC, "test")
	gs13_cross_trap(caster, trap)
	TEST_ASSERT_EQUAL(trap.charges, 0, "Antimagic consumes a hostile trap's charge")
	TEST_ASSERT_EQUAL(caster.fatness_real, 0, "Native antimagic blocks the trap effect")

/datum/game_test/room_test/gs13_belch_trap/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.nutrition = FULLNESS_LEVEL_BLOATED + 100
	var/obj/structure/trap/belch/trap = allocate(/obj/structure/trap/belch)
	trap.forceMove(get_turf(bottom_left))
	gs13_cross_trap(subject, trap)
	TEST_ASSERT_EQUAL(subject.AmountKnockDown(), 8 SECONDS, "Belch traps retain their native knockdown when weight effects are disabled")
	TEST_ASSERT_EQUAL(subject.fullness_adjustment, 0, "Master opt-out prevents the source emote's fullness effect")
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.gs13_preferences["weight_gain_magic"] = TRUE
	gs13_cross_trap(subject, trap)
	TEST_ASSERT_EQUAL(subject.fullness_adjustment, 0, "The belch effect follows the source's chemical switch rather than the magic switch")
	subject.gs13_preferences["weight_gain_chems"] = TRUE
	subject.gs13_preferences["weight_gain_magic"] = FALSE
	gs13_cross_trap(subject, trap)
	TEST_ASSERT(subject.fullness_adjustment >= -70 && subject.fullness_adjustment <= -50, "The native burp emote relieves fullness through the chemical preference")
	var/relief = subject.fullness_adjustment
	gs13_cross_trap(subject, trap)
	TEST_ASSERT_EQUAL(subject.fullness_adjustment, relief, "Repeated traps cannot bypass the fullness-relief cooldown")
	subject.SetKnockDown(0)
	subject.status_flags |= GODMODE
	gs13_cross_trap(subject, trap)
	TEST_ASSERT_NOT(subject.IsKnockedDown(), "Godmode prevents trap knockdown")

/datum/game_test/room_test/gs13_trap_conjuration/Run()
	var/mob/living/carbon/human/caster = allocate(/mob/living/carbon/human)
	caster.mind_initialize()
	var/list/targets = available_turfs.Copy(1, 7)
	var/turf/dense_tile = targets[6]
	var/original_type = dense_tile.type
	dense_tile = dense_tile.ChangeTurf(/turf/simulated/wall)
	targets[6] = dense_tile
	for(var/spell_type in list(/datum/spell/aoe/conjure/gs13_traps, /datum/spell/aoe/conjure/gs13_traps/fattening, /datum/spell/aoe/conjure/gs13_traps/belch))
		var/datum/spell/aoe/conjure/gs13_traps/spell = allocate(spell_type)
		TEST_ASSERT_EQUAL(spell.summon_lifespan, 5 MINUTES, "Conjured traps retain the source's five-minute lifetime")
		TEST_ASSERT_EQUAL(spell.cooldown_handler.recharge_duration, 25 SECONDS, "Trap spells retain the source's initial cooldown")
		TEST_ASSERT(spell.action_icon_state in icon_states(spell.action_icon), "Each trap spell has valid source action artwork")
		var/list/traps = spell.cast(targets.Copy(), caster)
		TEST_ASSERT_EQUAL(length(traps), 5, "Every spell variant conjures five traps")
		var/list/used_turfs = list()
		for(var/obj/structure/trap/gs13/trap as anything in traps)
			TEST_ASSERT_NOT(get_turf(trap) in used_turfs, "Each trap occupies a distinct tile")
			TEST_ASSERT_NOTEQUAL(get_turf(trap), dense_tile, "Conjuration excludes walls")
			TEST_ASSERT(trap.type in spell.summon_type, "Each variant selects only its declared trap types")
			TEST_ASSERT_EQUAL(trap.charges, 1, "Summoned traps have one charge")
			TEST_ASSERT(caster.mind in trap.immune_minds, "Every summoned trap recognizes the caster's mind")
			TEST_ASSERT(trap.icon_state in icon_states(trap.icon), "Both traps retain valid source artwork")
			used_turfs += get_turf(trap)
			qdel(trap)
	dense_tile.ChangeTurf(original_type)
	var/datum/spell/aoe/conjure/gs13_traps/timed_spell = allocate(/datum/spell/aoe/conjure/gs13_traps)
	timed_spell.summon_lifespan = 1 SECONDS
	var/list/timed_traps = timed_spell.cast(list(get_turf(bottom_left)), caster)
	var/obj/structure/trap/gs13/expiring = timed_traps[1]
	sleep(2 SECONDS)
	TEST_ASSERT(QDELETED(expiring), "Native conjuration timers remove unused traps")

/datum/game_test/room_test/gs13_trap_books/Run()
	var/mob/living/carbon/human/reader = allocate(/mob/living/carbon/human)
	reader.mind_initialize()
	for(var/book_type in list(/obj/item/book/granter/action/spell/traps_fattening, /obj/item/book/granter/action/spell/traps_belch))
		var/obj/item/book/granter/spell/gs13_traps/book = allocate(book_type)
		TEST_ASSERT(istype(book), "Both source tome paths use the native spell-granter adapter")
		TEST_ASSERT(book.icon_state in icon_states(book.icon), "Both trap tomes have valid artwork")
		book.pages_to_mastery = 0
		book.reading_time = 0
		reader.put_in_active_hand(book)
		book.activate_self(reader)
		var/datum/spell/learned_spell = locate(book.granted_spell) in reader.mind.spell_list
		TEST_ASSERT_NOTNULL(learned_spell, "Native reading teaches the corresponding trap spell")
		TEST_ASSERT(learned_spell.can_cast(reader), "Trap spells do not require wizard clothing")
		TEST_ASSERT_EQUAL(book.uses, 0, "Each tome supplies one lesson")
		TEST_ASSERT_NOT(book.can_learn(reader), "Readers cannot learn duplicate copies of a trap spell")
		reader.drop_item_to_ground(book)
	TEST_ASSERT_EQUAL(length(reader.mind.spell_list), 2, "The two tomes teach independent spells")

/datum/game_test/room_test/gs13_calorite_glass_alloy/Run()
	var/mob/living/carbon/human/builder = allocate(/mob/living/carbon/human)
	var/obj/machinery/mineral/ore_redemption/orm = allocate(/obj/machinery/mineral/ore_redemption)
	orm.forceMove(get_turf(bottom_left))
	orm.output_dir = EAST
	orm.scan_id = FALSE
	var/datum/design/design = orm.files.FindDesignByID("calorite_glass")
	TEST_ASSERT_NOTNULL(design, "Calorite glass is initially available in the native ore redemption machine")
	orm.mat_container.insert_amount(4000, MAT_CALORITE)
	orm.mat_container.insert_amount(2500, MAT_GLASS)
	TEST_ASSERT_EQUAL(orm.get_num_smeltable_alloy(design), 2, "The alloy requires one calorite sheet and half a glass sheet")
	var/datum/tgui/ui = allocate(/datum/tgui, builder, orm, "OreRedemption")
	ui.status = UI_INTERACTIVE
	orm.ui_act("alloy", list("id" = "calorite_glass", "amount" = "10"), ui)
	var/obj/item/stack/sheet/calorite_glass/product = locate() in get_step(orm, EAST)
	TEST_ASSERT_NOTNULL(product, "The native alloy control produces calorite glass")
	TEST_ASSERT_EQUAL(product.amount, 2, "Alloy output is limited by available materials")
	TEST_ASSERT_EQUAL(orm.mat_container.amount(MAT_CALORITE), 0, "Smelting consumes the required calorite")
	TEST_ASSERT_EQUAL(orm.mat_container.amount(MAT_GLASS), 500, "Smelting preserves unused glass")
	TEST_ASSERT_EQUAL(orm.mat_container.insert_item(product), 2, "Alloy sheets can be recycled through the native material container")
	TEST_ASSERT_EQUAL(orm.mat_container.amount(MAT_CALORITE), 4000, "Recycling preserves the calorite input")
	TEST_ASSERT_EQUAL(orm.mat_container.amount(MAT_GLASS), 2500, "Recycling preserves the glass input")

/datum/game_test/room_test/gs13_calorite_glass_grinder/Run()
	var/mob/living/carbon/human/operator = allocate(/mob/living/carbon/human)
	var/obj/machinery/reagentgrinder/grinder = allocate(/obj/machinery/reagentgrinder)
	grinder.forceMove(get_turf(operator))
	var/obj/item/stack/sheet/calorite_glass/sheets = allocate(/obj/item/stack/sheet/calorite_glass, null, 2)
	operator.put_in_active_hand(sheets)
	grinder.item_interaction(operator, sheets, list())
	TEST_ASSERT(sheets in grinder.holdingitems, "Native grinder loading accepts the new alloy")
	grinder.grind()
	TEST_ASSERT(QDELETED(sheets), "Grinding consumes the alloy sheets")
	TEST_ASSERT_EQUAL(grinder.beaker.reagents.get_reagent_amount("silicon"), 40, "Two alloy sheets produce forty silicon")
	TEST_ASSERT_EQUAL(grinder.beaker.reagents.get_reagent_amount("lipoifier"), 4, "Grinding retains the source lipoifier yield")

/datum/game_test/room_test/gs13_calorite_glass_construction/Run()
	var/mob/living/carbon/human/builder = allocate(/mob/living/carbon/human)
	builder.forceMove(get_turf(bottom_left))
	builder.setDir(NORTH)
	var/obj/item/stack/sheet/calorite_glass/sheets = allocate(/obj/item/stack/sheet/calorite_glass, builder, 5)
	var/obj/item/wrench/wrench = allocate(/obj/item/wrench)
	var/obj/item/screwdriver/screwdriver = allocate(/obj/item/screwdriver)
	for(var/recipe_index in 1 to 2)
		var/datum/stack_recipe/window/recipe = sheets.recipes[recipe_index]
		var/saved_time = recipe.time
		recipe.time = 0
		var/allowed = recipe.try_build(builder, sheets, 1)
		var/obj/structure/window/calorite/window = allowed ? recipe.do_build(builder, sheets, 1) : null
		recipe.time = saved_time
		TEST_ASSERT_NOTNULL(window, "Native stack recipes construct both window shapes")
		recipe.post_build(builder, sheets, window)
		TEST_ASSERT_NOT(window.anchored, "Freshly constructed windows require fastening")
		TEST_ASSERT(window.CanAtmosPass(NORTH), "Unfastened windows do not seal atmosphere")
		window.construction_speed = 0
		window.decon_speed = 0
		window.screwdriver_act(builder, screwdriver)
		TEST_ASSERT_NOT(window.CanAtmosPass(NORTH), "Fastened windows seal their native MILLA boundary")
		TEST_ASSERT_EQUAL(window.CanAtmosPass(EAST), !window.fulltile, "Full windows seal every side while directional panes seal only their edge")
		window.screwdriver_act(builder, screwdriver)
		window.wrench_act(builder, wrench)
		TEST_ASSERT(QDELETED(window), "Native wrench disassembly removes the unfastened window")
		var/obj/item/stack/sheet/calorite_glass/recovered = locate() in get_turf(builder)
		TEST_ASSERT_NOTNULL(recovered, "Disassembly returns the original alloy")
		TEST_ASSERT_EQUAL(recovered.amount, recipe.req_amount, "Disassembly returns the same number of sheets used to build")
		qdel(recovered)
	TEST_ASSERT_EQUAL(sheets.amount, 2, "Directional and full windows consume one and two sheets respectively")

/datum/game_test/room_test/gs13_calorite_window_optics/Run()
	var/obj/projectile/beam/beam = allocate(/obj/projectile/beam)
	var/turf/floor = get_step(get_turf(bottom_left), NORTH)
	beam.forceMove(get_step(floor, NORTH))
	var/obj/structure/window/calorite/window = allocate(/obj/structure/window/calorite)
	window.forceMove(floor)
	window.setDir(NORTH)
	TEST_ASSERT(window.CanPass(beam, NORTH), "Native laser pass flags permit a calorite pane crossing")
	TEST_ASSERT_EQUAL(beam.fat_added, 0, "Collision probes alone cannot amplify a laser")
	TEST_ASSERT(beam.Move(floor, SOUTH), "The laser moves through the pane using native movement")
	TEST_ASSERT_EQUAL(beam.fat_added, 25, "Entering across the pane adds twenty-five calorite energy")
	beam.Move(get_step(floor, EAST), EAST)
	TEST_ASSERT_EQUAL(beam.fat_added, 25, "Leaving through an unglazed edge does not amplify again")
	beam.Move(floor, WEST)
	TEST_ASSERT_EQUAL(beam.fat_added, 25, "Entering through an unglazed edge does not amplify")
	beam.Move(get_step(floor, NORTH), NORTH)
	TEST_ASSERT_EQUAL(beam.fat_added, 50, "Exiting across the pane also adds energy")
	var/turf/moved_floor = get_step(floor, EAST)
	window.forceMove(moved_floor)
	beam.Move(floor, SOUTH)
	TEST_ASSERT_EQUAL(beam.fat_added, 50, "Moving a pane disconnects its previous turf")
	beam.forceMove(get_step(moved_floor, NORTH))
	beam.Move(moved_floor, SOUTH)
	TEST_ASSERT_EQUAL(beam.fat_added, 75, "A moved pane listens on its new turf")
	qdel(window)
	beam.Move(get_step(moved_floor, NORTH), NORTH)
	TEST_ASSERT_EQUAL(beam.fat_added, 75, "Deleting a pane removes its optical listener")

/datum/game_test/room_test/gs13_calorite_full_window/Run()
	var/obj/projectile/beam/fattening/beam = allocate(/obj/projectile/beam/fattening)
	var/turf/floor = get_step(get_turf(bottom_left), NORTH)
	beam.forceMove(get_step(floor, NORTH))
	var/obj/structure/window/calorite/fulltile/window = allocate(/obj/structure/window/calorite/fulltile)
	window.forceMove(floor)
	beam.Move(floor, SOUTH)
	TEST_ASSERT_EQUAL(beam.fat_added, 225, "Full windows amplify an existing Fatoray payload")
	beam.Move(get_step(floor, EAST), EAST)
	TEST_ASSERT_EQUAL(beam.fat_added, 225, "A full window applies its boost once per traversal")
	beam.fat_added = 1000
	beam.Move(floor, WEST)
	TEST_ASSERT(abs(beam.fat_added - 1100) < 0.001, "Large payloads receive the source's ten-percent increase")
	beam.Move(get_step(floor, NORTH), NORTH)
	beam.fat_added = 5199
	beam.Move(floor, SOUTH)
	TEST_ASSERT_EQUAL(beam.fat_added, 5200, "The amplification cap retains the projectile's initial payload")
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.gs13_preferences["weight_gain_weapons"] = TRUE
	beam.fat_added = 25
	beam.on_hit(subject, 0)
	TEST_ASSERT_EQUAL(subject.fatness_real, 12.5, "An amplified beam uses the native projectile weight integration")
	subject.gs13_preferences["weight_gain_weapons"] = FALSE
	beam.on_hit(subject, 0)
	TEST_ASSERT_EQUAL(subject.fatness_real, 12.5, "Weapon opt-out still blocks amplified payloads")
	var/obj/projectile/bullet/bullet = allocate(/obj/projectile/bullet)
	bullet.forceMove(get_step(floor, NORTH))
	bullet.forceMove(floor)
	TEST_ASSERT_EQUAL(bullet.fat_added, 0, "Non-laser projectiles cannot gain calorite energy")

/datum/game_test/room_test/gs13_calorite_reflector/Run()
	var/mob/living/carbon/human/builder = allocate(/mob/living/carbon/human)
	var/obj/structure/reflector/frame = allocate(/obj/structure/reflector)
	frame.forceMove(get_turf(builder))
	frame.setDir(NORTH)
	var/obj/item/stack/sheet/calorite_glass/sheets = allocate(/obj/item/stack/sheet/calorite_glass, null, 4)
	builder.put_in_active_hand(sheets)
	frame.item_interaction(builder, sheets, list())
	TEST_ASSERT_NOT(QDELETED(frame), "An incomplete stack cannot finish a calorite reflector")
	TEST_ASSERT_EQUAL(sheets.amount, 4, "A failed assembly preserves its materials")
	sheets.add(1)
	frame.item_interaction(builder, sheets, list())
	TEST_ASSERT(QDELETED(frame), "Native reflector assembly consumes its frame")
	TEST_ASSERT(QDELETED(sheets), "Native reflector assembly consumes exactly five alloy sheets")
	var/obj/structure/reflector/single/calorite/reflector = locate() in get_turf(builder)
	TEST_ASSERT_NOTNULL(reflector, "A calorite sheet produces the specialized reflector")
	TEST_ASSERT_EQUAL(reflector.dir, NORTH, "Assembly preserves the frame's orientation")
	reflector.anchored = TRUE
	var/obj/projectile/beam/beam = allocate(/obj/projectile/beam)
	beam.setDir(SOUTH)
	beam.trajectory = new(beam.x, beam.y, beam.z, 0, 0, 180, 32)
	TEST_ASSERT_EQUAL(reflector.bullet_act(beam), -1, "The anchored reflector redirects a native laser")
	TEST_ASSERT_EQUAL(beam.fat_added, 25, "Successful reflection adds calorite energy")
	TEST_ASSERT_EQUAL(beam.original, get_step(reflector, WEST), "The source pane retains the native ninety-degree reflection")
	reflector.anchored = FALSE
	beam.fat_added = 0
	reflector.bullet_act(beam)
	TEST_ASSERT_EQUAL(beam.fat_added, 0, "A failed reflection cannot amplify the projectile")
	var/obj/item/wrench/wrench = allocate(/obj/item/wrench)
	wrench.toolspeed = 0
	reflector.wrench_act(builder, wrench)
	TEST_ASSERT(QDELETED(reflector), "Native dismantling removes the reflector")
	var/obj/item/stack/sheet/calorite_glass/recovered = locate() in get_turf(builder)
	TEST_ASSERT_NOTNULL(recovered, "Reflector dismantling recovers its alloy")
	TEST_ASSERT_EQUAL(recovered.amount, 5, "Reflector dismantling returns five sheets")

/datum/game_test/room_test/gs13_calorite_glass_shards/Run()
	var/mob/living/carbon/human/builder = allocate(/mob/living/carbon/human)
	builder.forceMove(get_turf(bottom_left))
	var/obj/structure/window/calorite/fulltile/window = allocate(/obj/structure/window/calorite/fulltile)
	window.forceMove(get_turf(builder))
	window.deconstruct(FALSE)
	var/list/shards = list()
	for(var/obj/item/shard/calorite_glass/shard in get_turf(builder))
		shards += shard
