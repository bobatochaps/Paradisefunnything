	TEST_ASSERT_EQUAL(barrel.reagents.get_reagent_amount("creme_de_coconut"), 5, "Lipofruit produces its source coconut liqueur")
	TEST_ASSERT_EQUAL(barrel.reagents.get_reagent_amount("lipoifier"), 4, "Fermentation preserves the fruit's chemical payload")
	TEST_ASSERT_EQUAL(barrel.reagents.get_reagent_amount("munchies"), 2, "Fermentation preserves the appetite stimulant")
	var/datum/reagent/consumable/ethanol/wine = barrel.reagents.has_reagent("fruit_wine")
	TEST_ASSERT_NOTNULL(wine, "Munchies weed produces native fruit wine")
	TEST_ASSERT_EQUAL(wine.alcohol_perc, 0.9, "Source wine strength is converted to Paradise's fractional scale")

