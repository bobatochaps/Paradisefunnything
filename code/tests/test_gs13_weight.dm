		TEST_ASSERT(shard.inhand_icon_state in icon_states(shard.lefthand_file), "Shards have original directional in-hand artwork")
		TEST_ASSERT_EQUAL(shard.damtype, FAT, "Shard attacks use the existing weight-damage adapter")
	TEST_ASSERT_EQUAL(length(shards), 2, "Breaking a full window produces two calorite shards")
	var/obj/item/weldingtool/welder = allocate(/obj/item/weldingtool)
	welder.tool_enabled = TRUE
	var/obj/item/shard/calorite_glass/first = shards[1]
	first.welder_act(builder, welder)
	TEST_ASSERT(QDELETED(first), "Native shard welding consumes the shard")
	var/obj/item/stack/sheet/calorite_glass/recovered = locate() in get_turf(builder)
	TEST_ASSERT_NOTNULL(recovered, "Welding recovers calorite glass instead of ordinary glass")
	TEST_ASSERT_EQUAL(recovered.materials[MAT_CALORITE], 2000, "Shard recycling preserves the calorite quantity")
	TEST_ASSERT_EQUAL(recovered.materials[MAT_GLASS], 1000, "Shard recycling preserves the glass quantity")

/datum/game_test/room_test/gs13_autolathe_materials/Run()
	var/mob/living/carbon/human/builder = allocate(/mob/living/carbon/human)
	var/obj/machinery/autolathe/lathe = allocate(/obj/machinery/autolathe)
	lathe.forceMove(get_turf(bottom_left))
	builder.forceMove(get_step(lathe, EAST))
	var/datum/component/material_container/materials = lathe.GetComponent(/datum/component/material_container)
	var/obj/item/stack/sheet/mineral/calorite/sheets = allocate(/obj/item/stack/sheet/mineral/calorite, builder, 5)
	builder.put_in_active_hand(sheets)
	sheets.melee_attack_chain(builder, lathe)
