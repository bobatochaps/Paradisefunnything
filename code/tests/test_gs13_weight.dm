/datum/game_test/room_test/gs13_portable_blender/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/obj/item/portable_blender/blender = allocate(/obj/item/portable_blender)
	user.put_in_inactive_hand(blender)
	var/obj/item/food/food = allocate(/obj/item/food)
	food.reagents.add_reagent("nutriment", 10, list("test meal" = 1))
	food.reagents.add_reagent("sugar", 10)
	user.put_in_active_hand(food)
	var/datum/reagents/beaker_reagents = blender.loaded_reagent_container.reagents
	beaker_reagents.add_reagent("water", 95)
	TEST_ASSERT(blender.insert_food(food, user, TRUE), "An accessible meal can be blended into the installed beaker")
	TEST_ASSERT_NOT(QDELETED(food), "A partial transfer retains the rest of the food")
	TEST_ASSERT_EQUAL(food.reagents.total_volume, 15, "Only the portion that fits is removed from the meal")
	TEST_ASSERT_EQUAL(beaker_reagents.get_reagent_amount("nutriment"), 2.5, "Partial blending preserves the food mixture")
	var/datum/reagent/nutriment = beaker_reagents.get_reagent_by_id("nutriment")
	TEST_ASSERT_EQUAL(nutriment.data["test meal"], 1, "Blending preserves native food taste data")
	TEST_ASSERT_NOT(blender.insert_food(food, user, TRUE), "A full beaker rejects another blend without consuming food")
	TEST_ASSERT_EQUAL(food.reagents.total_volume, 15, "A rejected blend preserves all remaining reagents")
	beaker_reagents.clear_reagents()
	food.flags |= NODROP
	TEST_ASSERT_NOT(blender.insert_food(food, user, TRUE), "An attached item cannot be consumed by the blender")
	food.flags &= ~NODROP
	user.transfer_item_to(food, get_turf(user))
	TEST_ASSERT_NOT(blender.insert_food(food, user, TRUE), "Instant blending still requires held food")
	user.put_in_active_hand(food)
	TEST_ASSERT(blender.insert_food(food, user, TRUE), "The rest of a partially blended meal remains usable")
	TEST_ASSERT(QDELETED(food), "A completely blended meal is deleted")
	TEST_ASSERT_EQUAL(beaker_reagents.total_volume, 15, "Blending does not invent or lose the remaining contents")

