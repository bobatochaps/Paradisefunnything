	var/obj/item/food/grown/lipofruit/fruit = allocate(/obj/item/food/grown/lipofruit)
	var/obj/item/food/grown/cannabis/munchies/leaf = allocate(/obj/item/food/grown/cannabis/munchies)
	for(var/obj/item/food/grown/produce in list(fruit, leaf))
		gardener.put_in_active_hand(produce)
		barrel.item_interaction(gardener, produce, list())
		TEST_ASSERT_EQUAL(produce.loc, barrel, "The native barrel accepts both harvested crops")
