	TEST_ASSERT_EQUAL(core.cell.charge, core.cell.maxcharge, "A partial conversion exactly fills the cell")
	generator.on_active_process()
	TEST_ASSERT_EQUAL(subject.fatness_real, 98, "A full cell does not waste body fat")
	core.cell.charge = 100
	subject.fatness_real = 1
	generator.on_active_process()
	TEST_ASSERT_EQUAL(subject.fatness_real, 0, "The final conversion stops at available ordinary weight")
	TEST_ASSERT_EQUAL(core.cell.charge, 102.5, "The last small amount of fuel only produces its actual charge")

