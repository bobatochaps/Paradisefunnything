/datum/game_test/room_test/gs13_fat_movement_modifiers/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.adjust_fatness(FATNESS_LEVEL_BLOB, FATTENING_TYPE_ALMIGHTY, TRUE)
