/datum/game_test/room_test/gs13_nutriment_turbo/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/cyberimp/chest/nutriment/turbo/pump = allocate(/obj/item/organ/internal/cyberimp/chest/nutriment/turbo)
	pump.insert(subject)
	TEST_ASSERT_EQUAL(subject.get_organ_slot("stomach"), pump, "The turbo pump occupies the native nutriment-implant slot")
	subject.nutrition = NUTRITION_LEVEL_FULL
	pump.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, NUTRITION_LEVEL_FULL + 50, "The pump synthesizes native nutrition even at the full threshold")
	pump.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, NUTRITION_LEVEL_FULL + 50, "The native five-second cooldown prevents double synthesis")
	pump.synth_cool()
	pump.on_life()
	TEST_ASSERT_NOT(pump.synthesizing, "The pump stops above its threshold")
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.handle_weight_gain(2)
	TEST_ASSERT_EQUAL(subject.fatness_real, 0, "Pump nutrition cannot bypass the food source preference")
	subject.gs13_preferences["weight_gain_food"] = TRUE
	subject.handle_weight_gain(2)
	TEST_ASSERT_EQUAL(subject.fatness_real, 10, "Excess pump nutrition converts through normal food metabolism")
	TEST_ASSERT_NOT(pump.send_messages, "The turbo variant suppresses repetitive hunger messages")
	pump.remove(subject)
	pump.forceMove(get_turf(subject))
	subject.nutrition = 100
	pump.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, 100, "A surgically removed pump no longer feeds its former owner")

/datum/game_test/room_test/gs13_nutriment_turbo_inactive/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/cyberimp/chest/nutriment/turbo/pump = allocate(/obj/item/organ/internal/cyberimp/chest/nutriment/turbo)
	pump.insert(subject)
	subject.nutrition = 100
	pump.disabled_by_emp = TRUE
	pump.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, 100, "Native EMP shutdown stops the turbo pump")
	pump.emp_cool()
	pump.status |= ORGAN_DEAD
	pump.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, 100, "A dead implant cannot synthesize nutrition")
	pump.status &= ~ORGAN_DEAD
	subject.stat = DEAD
	pump.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, 100, "A dead wearer cannot trigger synthesis")
	subject.stat = CONSCIOUS
	pump.on_life()
	TEST_ASSERT_EQUAL(subject.nutrition, 150, "A restored implant resumes feeding without requiring weight preferences")
	qdel(pump)
	TEST_ASSERT_NULL(subject.get_organ_slot("stomach"), "Deleting the pump cleans up its native organ slot")

/datum/game_test/room_test/gs13_mobility_implant/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.adjust_fatness(FATNESS_LEVEL_BLOB, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.handle_weight_gain(0)
	TEST_ASSERT_EQUAL(subject.gs13_movement_delay, FATNESS_MAX_MOVE_PENALTY, "The fixture starts with maximum body-fat slowdown")
	var/obj/item/organ/internal/cyberimp/chest/mobility/core = allocate(/obj/item/organ/internal/cyberimp/chest/mobility)
	core.insert(subject)
	TEST_ASSERT_EQUAL(subject.gs13_movement_delay, 0, "Native surgery immediately removes body-fat slowdown")
	TEST_ASSERT_EQUAL(subject.fatness_real, FATNESS_LEVEL_BLOB, "Mobility assistance does not remove weight")
	core.insert(subject)
	core.remove(subject)
	core.forceMove(get_turf(subject))
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_NO_FAT_SLOWDOWN), "Repeated insertion cannot leave a duplicate trait on removal")
	TEST_ASSERT_EQUAL(subject.gs13_movement_delay, FATNESS_MAX_MOVE_PENALTY, "Removing the core immediately restores body-fat slowdown")
	core.insert(subject)
	ADD_TRAIT(subject, TRAIT_NO_FAT_SLOWDOWN, "independent_test_source")
	qdel(core)
	TEST_ASSERT(HAS_TRAIT(subject, TRAIT_NO_FAT_SLOWDOWN), "Deleting the implant preserves unrelated sources of the same trait")
	TEST_ASSERT_EQUAL(subject.gs13_movement_delay, 0, "The remaining independent trait still prevents slowdown")
	REMOVE_TRAIT(subject, TRAIT_NO_FAT_SLOWDOWN, "independent_test_source")
	subject.handle_weight_gain(0)
	TEST_ASSERT_EQUAL(subject.gs13_movement_delay, FATNESS_MAX_MOVE_PENALTY, "No implant effect survives after all trait sources are removed")

/datum/game_test/room_test/gs13_nutritech_implant_replacement/Run()
