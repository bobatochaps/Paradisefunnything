/datum/game_test/room_test/gs13_feeding_machine_flow/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/machinery/iv_drip/feeding_tube/tube = allocate(/obj/machinery/iv_drip/feeding_tube)
	subject.forceMove(get_turf(user))
	tube.forceMove(get_turf(user))
	TEST_ASSERT_EQUAL(tube.reagent_container, tube.our_blender.loaded_reagent_container, "The included blender registers its beaker during initialization")
	var/datum/reagents/supply = tube.get_reagents()
	supply.add_reagent("milk", 40)
	TEST_ASSERT(tube.drag_drop_onto(subject, user), "Native machine dragging connects an accessible recipient")
	TEST_ASSERT(tube.isprocessing, "Connecting starts the machinery processor")
	tube.process(2)
	TEST_ASSERT_EQUAL(subject.reagents.get_reagent_amount("milk"), 10, "Default flow delivers five units per second")
	TEST_ASSERT_EQUAL(supply.total_volume, 30, "Feeding consumes exactly the delivered dose")
	tube.set_transfer_rate(0)
	tube.process(2)
	TEST_ASSERT_EQUAL(supply.total_volume, 30, "Pause retains the connection without transferring reagents")
	TEST_ASSERT_EQUAL(tube.connected_target, subject, "Pausing does not disconnect the recipient")
	tube.set_transfer_rate(0.25)
	tube.process(2)
	TEST_ASSERT_EQUAL(supply.total_volume, 29.5, "Fractional rates scale with the subsystem interval")
	TEST_ASSERT_NOT(tube.set_transfer_rate(INFINITY), "Non-finite rates are rejected")
	TEST_ASSERT_EQUAL(tube.transfer_rate, 0.25, "An invalid setting preserves the previous rate")
	tube.set_transfer_rate(500)
	TEST_ASSERT_EQUAL(tube.transfer_rate, 5, "Flow cannot exceed the source maximum")
	tube.set_transfer_rate(-1)
	TEST_ASSERT_EQUAL(tube.transfer_rate, 0, "Negative rates stop flow instead of extracting reagents")
	var/list/data = tube.ui_data(user)
	TEST_ASSERT_EQUAL(data["volume"], 29.5, "The control panel reports numeric volume without boolean coercion")
	TEST_ASSERT_EQUAL(data["capacity"], 100, "The panel reports the installed container's capacity")
	tube.eject_beaker(user)
	TEST_ASSERT_NULL(tube.connected_target, "Ejecting the blender disconnects its recipient")
	TEST_ASSERT_NOT(tube.isprocessing, "Disconnected machines stop processing")
	TEST_ASSERT_NULL(LAZYACCESS(subject.alerts, "gs13_tube_[tube.UID()]"), "Disconnection removes the recipient's alert")

/datum/game_test/room_test/gs13_feeding_machine_capacity/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/machinery/iv_drip/feeding_tube/tube = allocate(/obj/machinery/iv_drip/feeding_tube)
	subject.forceMove(get_turf(user))
	tube.forceMove(get_turf(user))
	var/datum/reagents/supply = tube.get_reagents()
	supply.add_reagent("milk", 40)
	subject.reagents.maximum_volume = 20
	subject.reagents.add_reagent("water", 17)
	TEST_ASSERT(tube.attach_iv(subject, user), "Partially full recipients can connect")
	tube.process(2)
	TEST_ASSERT_EQUAL(subject.reagents.get_reagent_amount("milk"), 3, "Feeding clamps to the recipient's actual free space")
	TEST_ASSERT_EQUAL(supply.total_volume, 37, "Overflow remains in the machine")
	supply.chem_temp = 400
	tube.process(2)
	TEST_ASSERT_EQUAL(subject.getFireLoss(), 0, "A full recipient cannot receive ingestion effects for an untransferred hot dose")
	TEST_ASSERT_EQUAL(supply.total_volume, 37, "A full recipient does not consume the supply")
	supply.chem_temp = T20C
	supply.clear_reagents()
	subject.reagents.clear_reagents()
	tube.process(2)
	TEST_ASSERT_EQUAL(tube.connected_target, subject, "An empty supply stays connected for refilling")
	var/obj/item/food/food = allocate(/obj/item/food)
	food.reagents.add_reagent("nutriment", 10)
	user.put_in_active_hand(food)
	tube.item_interaction(user, food, list())
	TEST_ASSERT(QDELETED(food), "The installed blender accepts held food through native machine interaction")
	tube.process(2)
	TEST_ASSERT_EQUAL(subject.reagents.get_reagent_amount("nutriment"), 10, "Feeding resumes after blending into an empty machine")

/datum/game_test/room_test/gs13_feeding_machine_preferences/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/machinery/iv_drip/feeding_tube/tube = allocate(/obj/machinery/iv_drip/feeding_tube)
	subject.forceMove(get_turf(user))
	tube.forceMove(get_turf(user))
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	tube.get_reagents().add_reagent("fermi_fat", 20)
	tube.attach_iv(subject, user)
	tube.process(2)
	subject.reagents.metabolize(subject)
	TEST_ASSERT_EQUAL(subject.fatness_real, 0, "Feeding cannot bypass disabled chemical weight effects")
	subject.gs13_preferences["weight_gain_chems"] = TRUE
	subject.reagents.metabolize(subject)
	TEST_ASSERT_EQUAL(subject.fatness_real, 10, "Fed chemicals use normal native metabolism")
	TEST_ASSERT_EQUAL(subject.fatness_perma, 0, "Permanent weight still requires its separate preference")
	subject.reagents.clear_reagents()
	tube.get_reagents().clear_reagents()
	tube.get_reagents().add_reagent("nutriment", 10)
	subject.nutrition = NUTRITION_LEVEL_FULL
	tube.process(2)
	subject.reagents.metabolize(subject)
	TEST_ASSERT(subject.nutrition > NUTRITION_LEVEL_FULL, "Blended nutrients increase nutrition through native metabolism")
	subject.handle_weight_gain(2)
	TEST_ASSERT_EQUAL(subject.fatness_real, 10, "Chemical preferences do not enable food weight gain")
	subject.gs13_preferences["weight_gain_food"] = TRUE
	subject.handle_weight_gain(2)
	TEST_ASSERT(subject.fatness_real > 10, "The food preference enables conversion of fed nutrition")

/datum/game_test/room_test/gs13_feeding_machine_cleanup/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/machinery/iv_drip/feeding_tube/tube = allocate(/obj/machinery/iv_drip/feeding_tube)
	subject.forceMove(get_turf(user))
	tube.forceMove(get_turf(user))
	var/turf/start = get_turf(subject)
	TEST_ASSERT(tube.attach_iv(subject, user), "An empty machine can connect before food is loaded")
	subject.forceMove(locate(start.x + 3, start.y, start.z))
	TEST_ASSERT_NULL(tube.connected_target, "Walking out of reach disconnects immediately")
	subject.forceMove(start)
	tube.attach_iv(subject, user)
	var/obj/structure/closet/crate/crate = allocate(/obj/structure/closet/crate)
	subject.forceMove(crate)
	TEST_ASSERT_NULL(tube.connected_target, "Entering a container breaks the feeding connection")
	subject.forceMove(start)
	var/obj/item/clothing/mask/gas/mask = allocate(/obj/item/clothing/mask/gas)
	subject.equip_to_slot_if_possible(mask, ITEM_SLOT_MASK)
	TEST_ASSERT_NOT(tube.attach_iv(subject, user), "A covered mouth prevents connection")
	subject.unequip_to(mask, start)
	tube.attach_iv(subject, user)
	tube.forceMove(locate(start.x + 3, start.y, start.z))
	TEST_ASSERT_NULL(tube.connected_target, "Moving the machine away also breaks the connection")
	tube.forceMove(start)
	tube.attach_iv(subject, user)
	qdel(tube.reagent_container)
	TEST_ASSERT_NULL(tube.connected_target, "Deleting an installed blender's beaker disconnects immediately")
	TEST_ASSERT_NULL(tube.reagent_container, "Deleted beakers cannot remain in the controller")
	tube.eject_beaker(user)
	var/obj/item/reagent_containers/glass/beaker/beaker = allocate(/obj/item/reagent_containers/glass/beaker)
	user.put_in_active_hand(beaker)
	tube.item_interaction(user, beaker, list())
	TEST_ASSERT_EQUAL(tube.reagent_container, beaker, "The feeder also accepts a standalone open beaker")
	tube.attach_iv(subject, user)
	beaker.forceMove(start)
	TEST_ASSERT_NULL(tube.connected_target, "Externally removing a standalone container disconnects")
	TEST_ASSERT_NULL(tube.reagent_container, "Externally removed containers leave no stale reference")
	user.put_in_active_hand(beaker)
	tube.item_interaction(user, beaker, list())
	tube.attach_iv(subject, user)
	qdel(subject)
	TEST_ASSERT_NULL(tube.connected_target, "Recipient deletion cleans up its connection")
	TEST_ASSERT_NOT(tube.isprocessing, "Recipient deletion stops the machine processor")
	tube.attach_iv(user, user)
	var/alert_category = "gs13_tube_[tube.UID()]"
	qdel(tube)
	TEST_ASSERT_NULL(LAZYACCESS(user.alerts, alert_category), "Machine deletion removes its alert from a surviving recipient")

/// Wire a real cable junction so power tests exercise the native connection path.
/datum/game_test/room_test/proc/gs13_wire_platform(obj/machinery/power/gs13_adipoelectric/platform, turf/location)
	platform.forceMove(location)
	platform.anchored = TRUE
	var/datum/regional_powernet/net = allocate(/datum/regional_powernet)
	var/obj/structure/cable/cable = allocate(/obj/structure/cable, location)
	net.add_cable(cable)
	platform.connect_to_network()
	return net

/datum/game_test/room_test/gs13_adipoelectric_generation/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/machinery/power/adipoelectric_generator/generator = allocate(/obj/machinery/power/adipoelectric_generator)
	var/datum/regional_powernet/net = gs13_wire_platform(generator, get_turf(subject))
	TEST_ASSERT_EQUAL(generator.powernet, net, "The anchored generator connects through a native cable junction")
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.adjust_perma(20, FATTENING_TYPE_ALMIGHTY, TRUE)
	generator.attack_hand(subject)
	TEST_ASSERT_EQUAL(generator.occupant, subject, "Clicking the platform from its tile enters through the native interaction")
	generator.process(2)
	TEST_ASSERT_EQUAL(subject.fatness_real, 100, "Disabled item effects prevent generator weight loss")
	TEST_ASSERT_EQUAL(net.queued_power_production, 0, "Disabled weight loss cannot generate free electricity")
	subject.gs13_preferences["weight_gain_items"] = TRUE
	generator.process(2)
	TEST_ASSERT_EQUAL(subject.fatness_real, 90, "The base matter bin consumes five regular units per second")
	TEST_ASSERT_EQUAL(subject.fatness_perma, 20, "Generating power does not consume permanent weight")
	TEST_ASSERT_EQUAL(net.queued_power_production, 250000, "The base lasers produce 250 kW on the native powernet")
	net.queued_power_production = 0
	generator.process(1)
	TEST_ASSERT_EQUAL(subject.fatness_real, 85, "A one-second process consumes one second of fuel")
	TEST_ASSERT_EQUAL(net.queued_power_production, 250000, "Wattage does not change with the processing interval")
	subject.fatness_real = 3
	net.queued_power_production = 0
	generator.process(2)
	TEST_ASSERT_EQUAL(subject.fatness_real, 0, "Limited fuel cannot produce negative weight")
	TEST_ASSERT_EQUAL(net.queued_power_production, 75000, "Final output scales to actual fuel consumed")
	net.queued_power_production = 0
	generator.process(2)
	TEST_ASSERT_EQUAL(net.queued_power_production, 0, "An empty occupant cannot generate power from permanent weight")
	generator.relaymove(subject)
	TEST_ASSERT_NULL(generator.occupant, "Moving releases a conscious occupant")
	TEST_ASSERT_EQUAL(subject.loc, get_turf(generator), "The released occupant returns to the floor")

/datum/game_test/room_test/gs13_adipoelectric_transformer/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human, get_turf(user))
	var/obj/machinery/power/adipoelectric_transformer/transformer = allocate(/obj/machinery/power/adipoelectric_transformer)
	var/datum/regional_powernet/net = gs13_wire_platform(transformer, get_turf(user))
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	TEST_ASSERT(transformer.close_machine(subject, user), "An anchored transformer accepts an occupant on its tile")
	TEST_ASSERT(transformer.can_release(), "A new transformer has no startup EMP lock")
	TEST_ASSERT(transformer in GLOB.adipoelectric_transformer, "Occupied transformers enter the source tracking list")
	net.available_power = 250000
	transformer.process(2)
	TEST_ASSERT_EQUAL(subject.fatness_real, 0, "Disabled item effects prevent transformer gain")
	TEST_ASSERT_EQUAL(net.power_demand, 250000, "The transformer still sinks its actual electrical load")
	subject.gs13_preferences["weight_gain_items"] = TRUE
	net.power_demand = 0
	transformer.process(2)
	TEST_ASSERT_EQUAL(subject.fatness_real, 2.5, "Below 500 kW the source conversion is linear and respects the gain multiplier")
	net.available_power = 1000000
	net.power_demand = 0
	transformer.process(2)
	TEST_ASSERT(abs(subject.fatness_real - 8) < 0.001, "Above 500 kW the source conversion slows tenfold")
	TEST_ASSERT_EQUAL(net.power_demand, 1000000, "The nonlinear branch consumes the entire surplus, including its first 500 kW")
	var/obj/machinery/power/adipoelectric_transformer/second = allocate(/obj/machinery/power/adipoelectric_transformer, get_turf(user))
	second.anchored = TRUE
	second.connect_to_network()
	var/mob/living/carbon/human/second_subject = allocate(/mob/living/carbon/human, get_turf(user))
	second_subject.gs13_preferences = subject.gs13_preferences.Copy()
	TEST_ASSERT(second.close_machine(second_subject, user), "Another transformer can share the native cable network")
	second.process(2)
	TEST_ASSERT_EQUAL(second_subject.fatness_real, 0, "Already-consumed surplus cannot be spent by a second transformer")
	TEST_ASSERT_NOT(second.active, "A transformer with no remaining surplus idles")
	transformer.open_machine()
	TEST_ASSERT_NOT(transformer in GLOB.adipoelectric_transformer, "Releasing the occupant removes the transformer from tracking")

/datum/game_test/room_test/gs13_adipoelectric_emp/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human, get_turf(user))
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.gs13_preferences["weight_gain_items"] = TRUE
	var/obj/machinery/power/adipoelectric_transformer/transformer = allocate(/obj/machinery/power/adipoelectric_transformer)
	var/datum/regional_powernet/net = gs13_wire_platform(transformer, get_turf(user))
	transformer.close_machine(subject, user)
	transformer.emp_act(1)
	TEST_ASSERT_NOT(transformer.open_machine(), "An EMP temporarily locks the transformer release")
	transformer.container_resist(subject)
	TEST_ASSERT_EQUAL(transformer.occupant, subject, "Resisting cannot bypass the source EMP lock")
	net.available_power = 500000
	transformer.process(2)
	TEST_ASSERT_EQUAL(subject.fatness_real, 25, "EMP overdrive multiplies the source conversion fivefold")
	TEST_ASSERT_EQUAL(transformer.icon_state, "state_overdrive", "Overdrive uses its source appearance")
	transformer.emp_until = world.time
	transformer.container_resist(subject)
	TEST_ASSERT_NULL(transformer.occupant, "The recipient can leave as soon as the EMP lock expires")
	var/obj/machinery/power/adipoelectric_generator/generator = allocate(/obj/machinery/power/adipoelectric_generator, get_turf(user))
	generator.anchored = TRUE
	generator.connect_to_network()
	TEST_ASSERT(generator.close_machine(subject, user), "The released recipient can enter the generator")
	generator.emp_act(1)
	TEST_ASSERT_NULL(generator.occupant, "An EMP ejects a generator occupant immediately")
	generator.close_machine(subject, user)
	generator.process(2)
	TEST_ASSERT_EQUAL(subject.fatness_real, 25, "The disabled generator cannot consume fuel during its EMP cooldown")
	TEST_ASSERT_EQUAL(net.queued_power_production, 0, "EMP-disabled generators do not supply power")
	generator.emp_until = world.time
	generator.process(2)
	TEST_ASSERT_EQUAL(subject.fatness_real, 15, "Generation resumes when its cooldown expires")
	TEST_ASSERT_EQUAL(net.queued_power_production, 250000, "Recovered generators feed the powernet again")

/datum/game_test/room_test/gs13_adipoelectric_cleanup/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/turf/start = get_turf(user)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human, start)
	var/obj/machinery/power/adipoelectric_transformer/transformer = allocate(/obj/machinery/power/adipoelectric_transformer)
	var/datum/regional_powernet/net = gs13_wire_platform(transformer, start)
	transformer.close_machine(subject, user)
	subject.forceMove(start)
	TEST_ASSERT_NULL(transformer.occupant, "External occupant movement clears the machine immediately")
	TEST_ASSERT_NOT(transformer.isprocessing, "An externally emptied platform stops processing")
	TEST_ASSERT_NOT(transformer in GLOB.adipoelectric_transformer, "External removal cannot leave stale tracking entries")
	transformer.close_machine(subject, user)
	qdel(subject)
	TEST_ASSERT_NULL(transformer.occupant, "Deleting an occupant clears all platform references")
	transformer.forceMove(locate(start.x + 3, start.y, start.z))
	TEST_ASSERT_NULL(transformer.powernet, "Moving a platform off its cable disconnects the old powernet")
	TEST_ASSERT_NOT(transformer in net.nodes, "The old powernet drops the moved platform")
	transformer.forceMove(start)
	TEST_ASSERT_EQUAL(transformer.powernet, net, "An anchored platform reconnects when moved back over its junction")
	transformer.close_machine(user, user)
	transformer.emp_act(1)
	qdel(transformer)
	TEST_ASSERT_EQUAL(user.loc, start, "Deleting a locked machine releases its surviving occupant")
	TEST_ASSERT_NOT(transformer in GLOB.adipoelectric_transformer, "Machine deletion removes its tracking entry")

/datum/game_test/room_test/gs13_adipoelectric_construction/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/turf/start = get_turf(user)
	var/obj/item/screwdriver/screwdriver = allocate(/obj/item/screwdriver)
	for(var/board_path in list(/obj/item/circuitboard/machine/power/adipoelectric_generator, /obj/item/circuitboard/machine/adipoelectric_transformer))
		var/obj/structure/machine_frame/frame = allocate(/obj/structure/machine_frame, start)
		frame.state = 2 // Start with an already-wired native frame.
		var/obj/item/circuitboard/board = allocate(board_path)
		user.put_in_active_hand(board)
		frame.item_interaction(user, board, list())
		TEST_ASSERT_EQUAL(frame.circuit, board, "The native machine frame accepts the adipoelectric board")
		for(var/part_path in board.req_components)
			if(ispath(part_path, /obj/item/stack))
				var/obj/item/stack/stack = allocate(part_path, start, board.req_components[part_path])
				user.put_in_active_hand(stack)
				frame.item_interaction(user, stack, list())
			else
				for(var/i in 1 to board.req_components[part_path])
					var/obj/item/part = allocate(part_path)
					user.put_in_active_hand(part)
					frame.item_interaction(user, part, list())
		TEST_ASSERT_EQUAL(frame.get_req_components_amt(), 0, "Native construction accepts every required stock part and material")
		frame.screwdriver_act(user, screwdriver)
		TEST_ASSERT(QDELETED(frame), "Completing the machine replaces its frame")
		var/obj/machinery/power/gs13_adipoelectric/built = locate(board.build_path) in start
		TEST_ASSERT_NOTNULL(built, "Native frame completion creates the expected machine")
		TEST_ASSERT(board in built.component_parts, "The constructed machine retains the supplied board")
		TEST_ASSERT_EQUAL(length(built.component_parts), 8, "Construction uses the supplied components without duplicating factory parts")
		if(istype(built, /obj/machinery/power/adipoelectric_generator))
			var/obj/machinery/power/adipoelectric_generator/generator = built
			var/obj/item/storage/part_replacer/replacer = allocate(/obj/item/storage/part_replacer)
			allocate(/obj/item/stock_parts/micro_laser/quadultra, replacer)
			generator.panel_open = TRUE
			generator.exchange_parts(user, replacer)
			TEST_ASSERT_EQUAL(generator.laser_modifier, 8, "Native part replacement upgrades the generator's conversion efficiency")
			generator.panel_open = FALSE
			var/datum/regional_powernet/net = gs13_wire_platform(generator, start)
			user.gs13_preferences = gs13_default_preferences()
			user.gs13_preferences["master_wg_pref"] = TRUE
			user.gs13_preferences["weight_gain_items"] = TRUE
			user.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
			generator.close_machine(user, user)
			generator.process(2)
			TEST_ASSERT_EQUAL(net.queued_power_production, 400000, "Upgraded parts affect actual power delivered to the network")
			generator.open_machine()
		var/list/recovered = built.component_parts.Copy()
		built.deconstruct()
		for(var/obj/item/part in recovered)
			TEST_ASSERT_NOT(QDELETED(part), "Deconstruction preserves recoverable machine parts")
			TEST_ASSERT_EQUAL(part.loc, start, "Native deconstruction returns its board and parts to the floor")

/// Use fixed, unobstructed room tiles: allocate() otherwise chooses random ones.
/datum/game_test/room_test/proc/gs13_prepare_caloray(mob/living/carbon/human/user, mob/living/carbon/human/subject, gun_type = /obj/item/gun/medbeam/caloray/charged)
	var/turf/start = get_turf(bottom_left)
	user.forceMove(locate(start.x + 1, start.y + 1, start.z))
	subject.forceMove(locate(start.x + 3, start.y + 1, start.z))
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.gs13_preferences["weight_gain_items"] = TRUE
	var/obj/item/gun/medbeam/caloray/gun = allocate(gun_type)
	user.put_in_hands(gun)
	return gun

/datum/game_test/room_test/proc/gs13_tick_caloray(obj/item/gun/medbeam/caloray/gun)
	gun.last_check = world.time - gun.check_delay - 1
	gun.process()

/datum/game_test/room_test/gs13_caloray_conversion/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/gun/medbeam/caloray/gun = gs13_prepare_caloray(user, subject)
	subject.adjustBruteLoss(10)
	var/starting_damage = subject.getBruteLoss()
	subject.adjust_perma(20, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/starting_charge = gun.cell.charge
	gun.afterattack__legacy__attackchain(subject, user, FALSE, null)
	TEST_ASSERT(gun.active, "The native gun attack chain starts a Caloray beam")
	gs13_tick_caloray(gun)
	TEST_ASSERT_EQUAL(subject.fatness_real, 10, "Default intensity converts 500 cell charge to ten weight after the gain multiplier")
	TEST_ASSERT_EQUAL(gun.cell.charge, starting_charge - 500, "Native boolean cell.use must still account for the actual requested energy")
	TEST_ASSERT_EQUAL(subject.fatness_perma, 20, "The Caloray never converts permanent weight")
	TEST_ASSERT(abs(subject.getBruteLoss() - starting_damage) < 0.001, "The Caloray must not inherit medical beam healing")
	gun.cell.charge = 250
	gs13_tick_caloray(gun)
	TEST_ASSERT_EQUAL(subject.fatness_real, 15, "A partially charged cell supplies only its remaining energy")
	TEST_ASSERT_EQUAL(gun.cell.charge, 0, "The last partial charge is consumed")
	TEST_ASSERT_NOT(gun.active, "The beam shuts down when its cell empties")
	qdel(gun)
	var/obj/item/gun/medbeam/caloray/infinite_cell/infinite_gun = allocate(/obj/item/gun/medbeam/caloray/infinite_cell)
	user.put_in_hands(infinite_gun)
	starting_charge = infinite_gun.cell.charge
	TEST_ASSERT(infinite_gun.process_fire(subject, user), "An infinite cell starts the beam")
	gs13_tick_caloray(infinite_gun)
	TEST_ASSERT_EQUAL(subject.fatness_real, 25, "Native infinite cells power conversion even though their charge does not decrease")
	TEST_ASSERT_EQUAL(infinite_gun.cell.charge, starting_charge, "The native infinite cell retains its behavior")

/datum/game_test/room_test/gs13_caloray_recharge/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/gun/medbeam/caloray/gun = gs13_prepare_caloray(user, subject, /obj/item/gun/medbeam/caloray/empty_cell)
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.adjust_perma(30, FATTENING_TYPE_ALMIGHTY, TRUE)
	gun.attack_self__legacy__attackchain(user)
	TEST_ASSERT(gun.process_fire(subject, user), "Thin mode starts with an empty cell")
	gs13_tick_caloray(gun)
	TEST_ASSERT_EQUAL(subject.fatness_real, 75, "Thin mode applies the configured loss multiplier")
	TEST_ASSERT_EQUAL(gun.cell.charge, 625, "Only the 25 weight actually removed can recharge the cell")
	gun.cell.charge = gun.cell.maxcharge - 100
	gs13_tick_caloray(gun)
	TEST_ASSERT_EQUAL(subject.fatness_real, 71, "A nearly full cell removes only the four weight it can store")
	TEST_ASSERT_EQUAL(gun.cell.charge, gun.cell.maxcharge, "Recharging stops exactly at cell capacity")
	TEST_ASSERT_NOT(gun.active, "A full cell shuts down thin mode")
	subject.fatness_real = 3
	subject.weight_loss_rate = 2
	gun.cell.charge = 0
	gun.process_fire(subject, user)
	gs13_tick_caloray(gun)
	TEST_ASSERT_EQUAL(subject.fatness_real, 0, "Accelerated loss cannot remove more regular weight than exists")
	TEST_ASSERT_EQUAL(gun.cell.charge, 75, "The final small weight reserve cannot create excess charge")
	TEST_ASSERT_EQUAL(subject.fatness_perma, 30, "A drained target retains permanent weight")
	gs13_tick_caloray(gun)
	TEST_ASSERT_NOT(gun.active, "A target without convertible weight shuts down thin mode")

/datum/game_test/room_test/gs13_caloray_preferences/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/gun/medbeam/caloray/gun = gs13_prepare_caloray(user, subject, /obj/item/gun/medbeam/caloray/empty_cell)
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	gun.attack_self__legacy__attackchain(user)
	subject.gs13_preferences["weight_gain_items"] = FALSE
	TEST_ASSERT_NOT(gun.process_fire(subject, user), "Item preferences gate the Caloray independently of weapon preferences")
	TEST_ASSERT_EQUAL(gun.cell.charge, 0, "Disabled item effects cannot recharge a cell")
	subject.gs13_preferences["weight_gain_items"] = TRUE
	subject.weight_loss_rate = 0
	gun.process_fire(subject, user)
	gs13_tick_caloray(gun)
	TEST_ASSERT_EQUAL(subject.fatness_real, 100, "Zero loss rate prevents weight removal")
	TEST_ASSERT_EQUAL(gun.cell.charge, 0, "Zero loss rate cannot produce free charge")
	TEST_ASSERT_NOT(gun.active, "A zero conversion stops the beam")
	subject.weight_loss_rate = 0.5
	subject.flip_loss_rate = TRUE
	gun.process_fire(subject, user)
	gs13_tick_caloray(gun)
	TEST_ASSERT_EQUAL(subject.fatness_real, 125, "Inverted loss still applies the target's weight effect")
	TEST_ASSERT_EQUAL(gun.cell.charge, 0, "Inverted loss cannot recharge while adding weight")
	subject.flip_loss_rate = FALSE
	gun.process_fire(subject, user)
	subject.gs13_preferences["master_wg_pref"] = FALSE
	gs13_tick_caloray(gun)
	TEST_ASSERT_EQUAL(subject.fatness_real, 125, "An ongoing beam rechecks changed preferences")
	TEST_ASSERT_EQUAL(gun.cell.charge, 0, "Revoking the preference stops conversion without charging")
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.status_flags |= GODMODE
	TEST_ASSERT_NOT(gun.process_fire(subject, user), "Godmode blocks energy conversion")

/datum/game_test/room_test/gs13_caloray_cell_handling/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/gun/medbeam/caloray/gun = gs13_prepare_caloray(user, subject, /obj/item/gun/medbeam/caloray)
	var/obj/item/stock_parts/cell/high/battery = allocate(/obj/item/stock_parts/cell/high)
	var/obj/item/wrench/wrench = allocate(/obj/item/wrench)
	TEST_ASSERT_NOT(gun.process_fire(subject, user), "Research-built guns require an installed cell")
	user.put_in_hands(battery)
	gun.attackby__legacy__attackchain(battery, user)
	TEST_ASSERT_NULL(gun.cell, "A closed battery compartment cannot accept a cell")
	gun.wrench_act(user, wrench)
	battery.flags |= NODROP
	gun.attackby__legacy__attackchain(battery, user)
	TEST_ASSERT_NULL(gun.cell, "Installing a cell respects native NODROP inventory checks")
	battery.flags &= ~NODROP
	gun.attackby__legacy__attackchain(battery, user)
	TEST_ASSERT_EQUAL(gun.cell, battery, "The held cell installs through the native attack chain")
	TEST_ASSERT_EQUAL(battery.loc, gun, "Installed cells belong to the gun")
	TEST_ASSERT_NOT(gun.process_fire(subject, user), "An open compartment prevents firing")
	gun.wrench_act(user, wrench)
	gun.process_fire(subject, user)
	gun.wrench_act(user, wrench)
	TEST_ASSERT_NOT(gun.active, "Opening a compartment cancels a live beam")
	gun.attack_self__legacy__attackchain(user)
	TEST_ASSERT_NULL(gun.cell, "Activating an open gun ejects its cell")
	TEST_ASSERT_EQUAL(battery.loc, user, "The ejected cell returns to the user's hands")
	user.drop_item_to_ground(battery)
	gun.attackby__legacy__attackchain(battery, user)
	TEST_ASSERT_NULL(gun.cell, "A direct interaction cannot steal a cell the user is not holding")
	user.put_in_hands(battery)
	gun.attackby__legacy__attackchain(battery, user)
	gun.wrench_act(user, wrench)
	gun.process_fire(subject, user)
	battery.forceMove(get_turf(user))
	TEST_ASSERT_NULL(gun.cell, "Forced cell movement clears the installed reference")
	TEST_ASSERT_NOT(gun.active, "Forced cell removal immediately cancels the beam")

/datum/game_test/room_test/gs13_caloray_beam_cleanup/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/gun/medbeam/caloray/gun = gs13_prepare_caloray(user, subject)
	gun.process_fire(subject, user)
	var/datum/beam/beam = locateUID(gun.beam_UID)
	qdel(beam)
	TEST_ASSERT_NOT(gun.active, "External beam deletion immediately stops processing")
	TEST_ASSERT_NULL(gun.current_target, "Deleting the beam clears its target")
	gun.process_fire(subject, user)
	beam = locateUID(gun.beam_UID)
	gun.attack_self__legacy__attackchain(user)
	TEST_ASSERT(QDELETED(beam), "Changing mode deletes the old beam")
	gun.attack_self__legacy__attackchain(user)
	gun.process_fire(subject, user)
	beam = locateUID(gun.beam_UID)
	gun.forceMove(get_turf(user))
	TEST_ASSERT_NOT(gun.active, "Forced gun movement cancels the beam without relying on dropped()")
	TEST_ASSERT(QDELETED(beam), "Moving a gun does not leave an orphan beam")
	user.put_in_hands(gun)
	gun.process_fire(subject, user)
	user.Stun(2 SECONDS)
	gs13_tick_caloray(gun)
	TEST_ASSERT_NOT(gun.active, "Incapacitated operators cannot sustain the beam")
	user.SetStunned(0)
	gun.process_fire(subject, user)
	qdel(subject)
	TEST_ASSERT_NULL(gun.current_target, "Target deletion clears the held reference without recursion")
	var/obj/item/stock_parts/cell/battery = gun.cell
	qdel(gun)
	TEST_ASSERT(QDELETED(battery), "Deleting the gun cleans up its installed cell")

/datum/game_test/room_test/gs13_caloray_line_of_sight/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/gun/medbeam/caloray/gun = gs13_prepare_caloray(user, subject)
	var/turf/middle = get_step(user, EAST)
	var/obj/structure/window/full/basic/window = allocate(/obj/structure/window/full/basic, middle)
	TEST_ASSERT(gun.process_fire(subject, user), "Native beam line of sight passes through glass")
	gs13_tick_caloray(gun)
	TEST_ASSERT_EQUAL(subject.fatness_real, 10, "Conversion works through a native full-tile window")
	var/obj/structure/blocker = allocate(/obj/structure, middle)
	blocker.density = TRUE
	gs13_tick_caloray(gun)
	TEST_ASSERT_NOT(gun.active, "A newly blocked sight line interrupts the beam")
	TEST_ASSERT_EQUAL(subject.fatness_real, 10, "A blocked beam does not apply another conversion")
	TEST_ASSERT_NOT(gun.process_fire(subject, user), "An obstructed shot cannot start a new beam")
	qdel(blocker)
	qdel(window)
	var/datum/beam/medical_beam = user.Beam(subject, "medbeam", time = 10 SECONDS, beam_type = /obj/effect/ebeam/medical)
	TEST_ASSERT(gun.process_fire(subject, user), "Crossing a medical beam is safe for the Caloray")
	TEST_ASSERT_NOT(QDELETED(medical_beam), "The medical beam survives the crossing")
	gs13_tick_caloray(gun)
	TEST_ASSERT_EQUAL(subject.fatness_real, 20, "Crossing beams still permit conversion")
	qdel(medical_beam)
	gun.max_range = 1
	gs13_tick_caloray(gun)
	TEST_ASSERT_NOT(gun.active, "Native process range checking interrupts a distant target")
	TEST_ASSERT_NOT(gun.process_fire(subject, user), "A target beyond range cannot start a beam")

/datum/game_test/room_test/proc/gs13_weight_panel_states(mob/living/carbon/human/subject)
	var/list/states = list()
	for(var/mutable_appearance/panel as anything in subject.overlays_standing[GS13_WEIGHT_BODY_LAYER])
		states += panel.icon_state
	return states

/datum/game_test/room_test/proc/gs13_render_weight_preview(mob/living/carbon/human/subject, label)
	COMPILE_OVERLAYS(subject)
	var/icon/preview = icon('icons/effects/effects.dmi', "nothing")
	preview.Crop(1, 1, 128, 32)
	var/column = 0
	for(var/direction in list(SOUTH, NORTH, EAST, WEST))
		subject.dir = direction
		var/icon/flat = getFlatIcon(subject, defdir = direction, no_anim = TRUE)
		preview.Blend(flat, ICON_OVERLAY, column * 32 + 1, 1)
		column++
	// Retain real BYOND renders in the CI log for visual review, not mockups.
	world.log << "GS13_WEIGHT_PREVIEW [label] [icon2base64(preview)]"

/datum/game_test/room_test/gs13_weight_appearance_stages/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	var/stage = 0
	for(var/threshold in list(FATNESS_LEVEL_FAT, FATNESS_LEVEL_FATTER, FATNESS_LEVEL_VERYFAT, FATNESS_LEVEL_OBESE, FATNESS_LEVEL_MORBIDLY_OBESE, FATNESS_LEVEL_EXTREMELY_OBESE, FATNESS_LEVEL_BARELYMOBILE, FATNESS_LEVEL_IMMOBILE, FATNESS_LEVEL_BLOB))
		stage++
		subject.fatness_real = threshold
		subject.calculate_fatness()
		var/list/states = gs13_weight_panel_states(subject)
		TEST_ASSERT("m_belly_smoothnoarms_[stage]_FRONT" in states, "Each native weight boundary selects the corresponding source belly sprite")
		TEST_ASSERT("m_butt_pair_gs_[stage]_ADJ_primary" in states, "Each native weight boundary selects the corresponding source hip sprite")
		for(var/mutable_appearance/panel as anything in subject.overlays_standing[GS13_WEIGHT_BODY_LAYER])
			TEST_ASSERT(icon_exists(panel.icon, panel.icon_state), "All selected source body sprites exist")
	var/list/cached = subject.overlays_standing[GS13_WEIGHT_BODY_LAYER]
	subject.adjust_fatness(1, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_EQUAL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], cached, "Weight changes within a stage reuse the cached appearance")
	subject.fully_heal_fatness(TRUE, "", "")
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "Losing all added weight removes the body panels")
	subject.adjust_fatness(FATNESS_LEVEL_OBESE, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.gs13_preferences["weight_body_sprites"] = FALSE
	subject.calculate_fatness()
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "The appearance preference removes existing panels without changing weight")
	TEST_ASSERT_EQUAL(subject.fatness_real, FATNESS_LEVEL_OBESE, "Disabling appearance does not discard weight")

/datum/game_test/room_test/gs13_weight_appearance_uniforms/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.adjust_fatness(FATNESS_LEVEL_OBESE, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey)
	TEST_ASSERT(subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT), "The modular grey suit uses native equipment slots")
	var/list/states = gs13_weight_panel_states(subject)
	TEST_ASSERT("belly_soft_4" in states, "Equipping a modular suit covers the current belly stage")
	TEST_ASSERT("butt_4_NORTH" in states, "Directional hip panels are included")
	TEST_ASSERT_EQUAL(length(states), 4, "Clothed bodies do not leak unclothed body panels")
	uniform.roll_undersuit(subject)
	states = gs13_weight_panel_states(subject)
	TEST_ASSERT("belly_soft_4_d" in states, "Native uniform rolling selects the source rolled-down panels")
	TEST_ASSERT("m_belly_smoothnoarms_4_FRONT" in states, "Rolling down a suit exposes the native body overlay")
	uniform.roll_undersuit(subject)
	uniform.dye_item(DYE_RED)
	var/list/red_palette = GLOB.palette_registry[DYE_REGISTRY_UNDER][DYE_RED]
	for(var/mutable_appearance/panel as anything in subject.overlays_standing[GS13_WEIGHT_BODY_LAYER])
		TEST_ASSERT_EQUAL(panel.color, red_palette[length(red_palette)], "Native dyeing updates every modular panel immediately")
	var/obj/item/clothing/suit/space/cover = allocate(/obj/item/clothing/suit/space)
	TEST_ASSERT(subject.equip_to_slot_if_possible(cover, ITEM_SLOT_OUTER_SUIT), "A native spacesuit can cover the modular uniform")
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "HIDEJUMPSUIT suppresses the complete expansion overlay")
	subject.drop_item_to_ground(cover)
	TEST_ASSERT("belly_soft_4" in gs13_weight_panel_states(subject), "Removing the cover restores the modular silhouette")
	subject.drop_item_to_ground(uniform)
	TEST_ASSERT_EQUAL(length(gs13_weight_panel_states(subject)), 2, "Removing the uniform restores body panels and clears clothing panels")

/datum/game_test/room_test/gs13_weight_appearance_concealment/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.adjust_fatness(FATNESS_LEVEL_OBESE, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/obj/item/bluespace_belt/belt = allocate(/obj/item/bluespace_belt)
	belt.forceMove(subject)
	belt.equipped(subject, ITEM_SLOT_BELT)
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "The belt hides regular weight in both measurements and silhouette")
	subject.adjust_perma(FATNESS_LEVEL_FAT, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT("m_belly_smoothnoarms_1_FRONT" in gs13_weight_panel_states(subject), "Unconcealed permanent weight still affects the body stage")
	qdel(belt)
	TEST_ASSERT("m_belly_smoothnoarms_4_FRONT" in gs13_weight_panel_states(subject), "Removing concealment restores the combined weight stage")
	subject.nutrition = FULLNESS_LEVEL_BEEG + 1
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey)
	subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT)
	TEST_ASSERT("belly_stuffed_5" in gs13_weight_panel_states(subject), "Fullness selects stuffed clothing one size up at the source threshold")
	subject.nutrition = NUTRITION_LEVEL_FULL
	subject.handle_weight_gain(0)
	TEST_ASSERT("belly_soft_4" in gs13_weight_panel_states(subject), "Fullness recovery refreshes clothing even when weight stage is unchanged")
	subject.gs13_preferences["master_wg_pref"] = FALSE
	subject.handle_weight_gain(0)
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "Disabling the master switch clears the complete appearance layer")

/datum/game_test/room_test/gs13_weight_appearance_anatomy/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.adjust_fatness(FATNESS_LEVEL_OBESE, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/obj/item/organ/external/leg = subject.get_organ(BODY_ZONE_L_LEG)
	leg.status |= ORGAN_ROBOT
	subject.update_body(TRUE)
	TEST_ASSERT_EQUAL(length(gs13_weight_panel_states(subject)), 1, "Hip panels cannot paint flesh over a prosthetic leg")
	leg.status &= ~ORGAN_ROBOT
	leg.droplimb(clean = TRUE, nodamage = TRUE)
	subject.update_body(TRUE)
	var/list/states = gs13_weight_panel_states(subject)
	TEST_ASSERT("m_belly_smoothnoarms_4_FRONT" in states, "Removing a leg preserves the remaining torso appearance")
	TEST_ASSERT_EQUAL(length(states), 1, "Source hip sprites cannot redraw a missing leg")
	var/obj/item/organ/external/chest = subject.get_organ(BODY_ZONE_CHEST)
	chest.status |= ORGAN_ROBOT
	subject.update_body(TRUE)
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "Organic weight sprites are not painted over a robotic torso")
	chest.status &= ~ORGAN_ROBOT
	ADD_TRAIT(subject, TRAIT_SKELETONIZED, "gs13_render_test")
	subject.update_body(TRUE)
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "Skeletonized bodies do not regain flesh from the adapter")
	REMOVE_TRAIT(subject, TRAIT_SKELETONIZED, "gs13_render_test")
	subject.set_species(/datum/species/unathi)
	TEST_ASSERT_NULL(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER], "Changing to an unadapted species removes the human panels")

/datum/game_test/room_test/gs13_weight_appearance_skin_and_previews/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	var/obj/item/clothing/under/color/grey/uniform = allocate(/obj/item/clothing/under/color/grey)
	subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_JUMPSUIT)
	gs13_render_weight_preview(subject, "uniform_normal")
	for(var/threshold in list(FATNESS_LEVEL_FAT, FATNESS_LEVEL_OBESE, FATNESS_LEVEL_BLOB))
		subject.fatness_real = threshold
		subject.calculate_fatness()
		gs13_render_weight_preview(subject, "uniform_[gs13_weight_stage(threshold)]")
	subject.fatness_real = FATNESS_LEVEL_OBESE
	subject.calculate_fatness()
	subject.drop_item_to_ground(uniform)
	subject.s_tone = 1
	subject.update_body(TRUE)
	var/list/panels = subject.overlays_standing[GS13_WEIGHT_BODY_LAYER]
	var/mutable_appearance/light_skin = panels[1]
	var/light_color = light_skin.color
	gs13_render_weight_preview(subject, "body_light")
	subject.s_tone = 13
	subject.update_body(TRUE)
	panels = subject.overlays_standing[GS13_WEIGHT_BODY_LAYER]
	var/mutable_appearance/dark_skin = panels[1]
	TEST_ASSERT(dark_skin.color != light_color, "Changing native skin tone also updates the body panels")
	gs13_render_weight_preview(subject, "body_dark")
	var/list/cached = subject.overlays_standing[GS13_WEIGHT_BODY_LAYER]
	subject.regenerate_icons()
	TEST_ASSERT_EQUAL(length(subject.overlays_standing[GS13_WEIGHT_BODY_LAYER]), length(cached), "Native icon regeneration preserves exactly one set of body panels")
