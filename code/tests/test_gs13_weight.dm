/datum/game_test/room_test/gs13_crop_harvest/Run()
	var/mob/living/carbon/human/gardener = allocate(/mob/living/carbon/human)
	gardener.forceMove(get_step(get_turf(bottom_left), EAST))
	for(var/seed_path in list(/obj/item/seeds/lipoplant, /obj/item/seeds/cannabis/munchies))
		var/obj/machinery/hydroponics/tray = allocate(/obj/machinery/hydroponics)
		tray.forceMove(get_turf(bottom_left))
		var/obj/item/seeds/seed = allocate(seed_path)
		seed.set_potency(40)
		seed.set_yield(1)
		var/product_path = seed.product
		var/repeated_harvest = seed.get_gene(/datum/plant_gene/trait/repeated_harvest)
		TEST_ASSERT(seed.icon_state in icon_states(seed.icon), "Both seed packets retain their source artwork")
		var/list/growing_states = icon_states(seed.growing_icon)
		for(var/stage in 1 to seed.growthstages)
			TEST_ASSERT("[seed.icon_grow][stage]" in growing_states, "Every native growth stage has a source sprite")
		TEST_ASSERT(seed.icon_dead in growing_states, "The dead plant has a source sprite")
		TEST_ASSERT(seed.icon_harvest in growing_states, "The mature plant has a source sprite")
		gardener.put_in_active_hand(seed)
		tray.item_interaction(gardener, seed, list())
		TEST_ASSERT_EQUAL(tray.myseed, seed, "Native planting installs the new crop")
		tray.harvest = TRUE
		tray.attack_hand(gardener)
		var/obj/item/food/grown/produce = locate(product_path) in get_turf(gardener)
		TEST_ASSERT_NOTNULL(produce, "Native harvesting creates the corresponding produce")
		TEST_ASSERT(produce.icon_state in icon_states(produce.icon), "Harvested produce has valid source artwork")
		TEST_ASSERT_EQUAL(produce.seed.potency, 40, "Harvested produce retains modified seed genetics")
		TEST_ASSERT_NOTEQUAL(produce.seed, seed, "Produce owns a copied seed rather than the planted seed")
		if(repeated_harvest)
			TEST_ASSERT_EQUAL(tray.myseed, seed, "Munchies weed survives harvesting")
			TEST_ASSERT_EQUAL(produce.reagents.get_reagent_amount("munchies"), 4, "Appetite stimulant yield scales with potency")
			TEST_ASSERT_EQUAL(produce.reagents.get_reagent_amount("space_drugs"), 2, "The source narcotic yield is retained")
			TEST_ASSERT_EQUAL(produce.light_color, "#ff9166", "Native gene callbacks apply the orange glow")
			TEST_ASSERT(produce.light_range > 0, "Harvested munchies weed emits light")
			tray.harvest = TRUE
			tray.attack_hand(gardener)
			var/harvest_count = 0
			for(var/obj/item/food/grown/cannabis/munchies/leaf in get_turf(gardener))
				harvest_count++
			TEST_ASSERT_EQUAL(harvest_count, 2, "Repeated harvests produce another leaf")
		else
			TEST_ASSERT(QDELETED(seed), "Adipolipus is consumed by its single harvest")
			TEST_ASSERT_EQUAL(produce.reagents.get_reagent_amount("lipoifier"), 8, "Lipofruit's lipoifier yield scales with potency")
		qdel(tray)
	var/obj/item/seeds/cannabis/base_seed = allocate(/obj/item/seeds/cannabis)
	TEST_ASSERT(/obj/item/seeds/cannabis/munchies in base_seed.mutatelist, "Native cannabis can mutate into munchies weed")
	TEST_ASSERT(/obj/item/seeds/cannabis/rainbow in base_seed.mutatelist, "Existing native cannabis mutations remain available")

/datum/game_test/room_test/gs13_crop_extraction/Run()
	var/mob/living/carbon/human/gardener = allocate(/mob/living/carbon/human)
	gardener.forceMove(get_step(get_turf(bottom_left), EAST))
	var/obj/item/seeds/lipoplant/seed = allocate(/obj/item/seeds/lipoplant, gardener)
	seed.set_potency(70)
	var/obj/item/food/grown/lipofruit/fruit = allocate(/obj/item/food/grown/lipofruit, get_turf(bottom_left), seed)
	TEST_ASSERT(seedify(fruit, 2), "Native extraction accepts lipofruit")
	TEST_ASSERT(QDELETED(fruit), "Seed extraction consumes the harvested fruit")
	var/recovered_count = 0
	var/obj/item/seeds/lipoplant/recovered
	for(var/obj/item/seeds/lipoplant/result in get_turf(bottom_left))
		recovered_count++
		recovered = result
		TEST_ASSERT_EQUAL(result.potency, 70, "Extracted seeds preserve the cultivated potency")
		var/datum/plant_gene/reagent/gene = locate() in result.genes
		TEST_ASSERT_NOTNULL(gene, "Extracted seeds retain their reagent gene")
		TEST_ASSERT_EQUAL(gene.reagent_id, "lipoifier", "The copied gene uses the native reagent ID")
	TEST_ASSERT_EQUAL(recovered_count, 2, "The requested seed count is recovered")
	fruit = allocate(/obj/item/food/grown/lipofruit, get_turf(gardener), recovered)
	var/obj/machinery/reagentgrinder/grinder = allocate(/obj/machinery/reagentgrinder)
	grinder.forceMove(get_turf(gardener))
	gardener.put_in_active_hand(fruit)
	grinder.item_interaction(gardener, fruit, list())
	grinder.grind()
	TEST_ASSERT(QDELETED(fruit), "Native grinding consumes the new fruit")
	TEST_ASSERT_EQUAL(grinder.beaker.reagents.get_reagent_amount("lipoifier"), 14, "Grinding preserves the potency-derived lipoifier yield")

/datum/game_test/room_test/gs13_appetite_stimulant/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.nutrition = 600
	subject.reagents.add_reagent("munchies", 4)
	TEST_ASSERT(subject.reagents.has_reagent("munchies"), "Appetite stimulant is registered in native chemistry")
	subject.reagents.metabolize(subject)
	TEST_ASSERT_EQUAL(subject.fullness_adjustment, 0, "Master opt-out blocks chemical hunger")
	TEST_ASSERT(subject.reagents.get_reagent_amount("munchies") < 4, "Opt-out does not prevent normal reagent depletion")
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.reagents.metabolize(subject)
	TEST_ASSERT_EQUAL(subject.fullness_adjustment, 0, "Chemical effects require their independent preference")
	subject.gs13_preferences["weight_gain_chems"] = TRUE
	subject.reagents.metabolize(subject)
	TEST_ASSERT_EQUAL(subject.fullness_adjustment, -30, "The source hunger request includes normal fullness recovery")
	subject.handle_gs13_fullness(2)
	TEST_ASSERT_EQUAL(subject.get_fullness(), 585, "A native two-second cycle leaves fifteen additional hunger")
	TEST_ASSERT_EQUAL(subject.nutrition, 600, "Appetite stimulant changes fullness without destroying nutrition")
	subject.reagents.clear_reagents()
	subject.handle_gs13_fullness(2)
	TEST_ASSERT_EQUAL(subject.fullness_adjustment, 0, "Temporary chemical hunger recovers after metabolism stops")

/datum/game_test/room_test/gs13_crop_fermentation/Run()
	var/mob/living/carbon/human/gardener = allocate(/mob/living/carbon/human)
	var/obj/structure/fermenting_barrel/barrel = allocate(/obj/structure/fermenting_barrel)
	barrel.forceMove(get_turf(gardener))
