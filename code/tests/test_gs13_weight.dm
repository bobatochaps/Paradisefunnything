/datum/game_test/room_test/gs13_calorite_floor/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	var/turf/original = pick(get_available_turfs())
	var/turf/outside = get_step(original, NORTH)
	subject.forceMove(outside)
	var/turf/simulated/floor/plating/plating = original.ChangeTurf(/turf/simulated/floor/plating)
	var/obj/item/stack/tile/mineral/calorite/tiles = allocate(/obj/item/stack/tile/mineral/calorite, subject, 4)
	var/list/floor_coordinates = list(plating.x, plating.y, plating.z)
	plating.item_interaction(subject, tiles, list())
	var/turf/simulated/floor/mineral/calorite/floor = locate(floor_coordinates[1], floor_coordinates[2], floor_coordinates[3])
	TEST_ASSERT(istype(floor), "Calorite tiles install through native plating interaction")
	TEST_ASSERT_EQUAL(tiles.amount, 3, "Installing flooring consumes one tile")
	subject.forceMove(floor)
	TEST_ASSERT_EQUAL(subject.fatness_real, 0, "Floor entry respects the item preference")
	subject.gs13_preferences["weight_gain_items"] = TRUE
	subject.forceMove(outside)
	subject.forceMove(floor)
	TEST_ASSERT_EQUAL(subject.fatness_real, 5, "Real floor entry applies the calorite effect")
	subject.forceMove(outside)
	var/turf/simulated/floor/plating/recovered = floor.remove_tile(subject, TRUE)
	var/obj/item/stack/tile/mineral/calorite/recovered_tile = locate() in recovered
	TEST_ASSERT_NOTNULL(recovered_tile, "Prying up flooring recovers the correct tile")
	TEST_ASSERT_EQUAL(recovered_tile.amount, 1, "Prying does not duplicate tiles")
	qdel(recovered_tile)
	var/turf/simulated/floor/mineral/calorite/strong/strong = recovered.ChangeTurf(/turf/simulated/floor/mineral/calorite/strong)
	subject.forceMove(strong)
	TEST_ASSERT_EQUAL(subject.fatness_real, 25, "Infused flooring preserves its stronger effect")
	strong.break_tile()
	TEST_ASSERT(strong.current_overlay in icon_states(strong.icon), "Broken calorite variants use an existing damage sprite")
	strong.ChangeTurf(/turf/simulated/floor/plating)

