/datum/game_test/room_test/gs13_autolathe_queue_shortage/Run()
	var/mob/living/carbon/human/builder = allocate(/mob/living/carbon/human)
	var/obj/machinery/autolathe/lathe = allocate(/obj/machinery/autolathe)
	lathe.forceMove(get_turf(bottom_left))
	lathe.BuildTurf = get_turf(lathe)
	var/datum/component/material_container/materials = lathe.GetComponent(/datum/component/material_container)
	materials.insert_amount(2000, MAT_CALORITE)
	materials.insert_amount(2000, MAT_GLASS)
	var/datum/design/design = lathe.files.FindDesignByID("calorite_glass")
	var/datum/tgui/ui = allocate(/datum/tgui, builder, lathe, "Autolathe")
	ui.status = UI_INTERACTIVE
	lathe.ui_act("make", list("make" = design.UID(), "multiplier" = "10"), ui)
	TEST_ASSERT_EQUAL(materials.total_amount, 4000, "An unaffordable batch cannot consume part of its inputs")
	TEST_ASSERT_EQUAL(length(lathe.queue), 0, "The unaffordable batch stops the native queue")
	TEST_ASSERT_NOT(lathe.can_build(design, 0), "Zero-sized batches are rejected")
	TEST_ASSERT_NOT(lathe.can_build(design, -1), "Negative batches cannot create material")
	TEST_ASSERT_NOT(lathe.can_build(design, 0.5), "Fractional stack counts are rejected")
	lathe.add_to_queue(design, 1)
	lathe.add_to_queue(design, 1)
	var/list/data = lathe.queue_data(list())
	var/list/preview = data["queue"]
	var/list/first_order = preview[1]
	var/list/second_order = preview[2]
	TEST_ASSERT(first_order["can_build"], "The first queued alloy has enough of both components")
	TEST_ASSERT_NOT(second_order["can_build"], "Zero remaining calorite is respected by the queue preview")
	lathe.process_queue()
	var/obj/item/stack/sheet/calorite_glass/product = locate() in get_turf(lathe)
	TEST_ASSERT_NOTNULL(product, "The affordable first order completes")
	TEST_ASSERT_EQUAL(product.amount, 1, "The second order cannot print without calorite")
	TEST_ASSERT_EQUAL(materials.amount(MAT_CALORITE), 0, "The first order consumes the last calorite")
	TEST_ASSERT_EQUAL(materials.amount(MAT_GLASS), 1000, "An exhausted calorite supply cannot consume extra glass")
	TEST_ASSERT_EQUAL(length(lathe.queue), 0, "An exhausted material supply clears the remaining queue")

