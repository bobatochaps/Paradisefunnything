/datum/game_test/room_test/gs13_chemical_grenades/Run()
	for(var/grenade_type in list(/obj/item/grenade/chem_grenade/lipoifier, /obj/item/grenade/chem_grenade/galbanic, /obj/item/grenade/chem_grenade/fatmix))
		var/obj/item/grenade/chem_grenade/grenade = allocate(grenade_type)
		TEST_ASSERT_EQUAL(length(grenade.beakers), 2, "[grenade_type] contains both prepared beakers")
		var/turf/location = get_turf(grenade)
		var/mob/living/carbon/human/unprotected = allocate(/mob/living/carbon/human, location)
		var/mob/living/carbon/human/protected = allocate(/mob/living/carbon/human, location)
		var/obj/item/clothing/mask/gas/mask = allocate(/obj/item/clothing/mask/gas)
		protected.equip_to_slot_if_possible(mask, ITEM_SLOT_MASK)
		var/list/previous_processing = SSfastprocess.processing.Copy()
		grenade.prime()
		TEST_ASSERT(QDELETED(grenade), "[grenade_type] detonates through the native grenade mechanism")
		var/datum/effect_system/smoke_spread/chem/smoke
		for(var/datum/effect_system/smoke_spread/chem/candidate in SSfastprocess.processing - previous_processing)
			if(candidate.location == location)
				smoke = candidate
				break
		TEST_ASSERT_NOTNULL(smoke, "[grenade_type] creates native chemical smoke")
		var/payload = grenade_type == /obj/item/grenade/chem_grenade/galbanic ? "fermi_fat" : "lipoifier"
		TEST_ASSERT(smoke.chemholder.reagents.has_reagent(payload), "The smoke retains the grenade's active payload")
		smoke.SmokeEm(1)
		TEST_ASSERT(unprotected.reagents.has_reagent(payload), "An unprotected carbon inhales the payload")
		TEST_ASSERT_NOT(protected.reagents.has_reagent(payload), "A native gas mask blocks payload inhalation")
		unprotected.reagents.metabolize(unprotected)
		TEST_ASSERT_EQUAL(unprotected.fatness_real, 0, "Smoke cannot bypass disabled weight preferences")
		STOP_PROCESSING(SSfastprocess, smoke)
		qdel(smoke)
		qdel(unprotected)
		qdel(protected)

/datum/game_test/room_test/gs13_memento_binding/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.gs13_preferences["weight_gain_magic"] = TRUE
	subject.gs13_preferences["weight_gain_permanent"] = TRUE
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.adjust_perma(30, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/obj/item/clothing/neck/necklace/memento_mori/calori/sprinkled/pendant = allocate(/obj/item/clothing/neck/necklace/memento_mori/calori/sprinkled)
	TEST_ASSERT_NOT(pendant.bind_owner(subject), "A pendant outside the neck slot cannot bind")
	subject.equip_to_slot_if_possible(pendant, ITEM_SLOT_NECK)
	var/datum/action/action = pendant.actions[1]
	TEST_ASSERT_EQUAL(action.owner, subject, "Equipping the pendant grants its native action")
	TEST_ASSERT(pendant.bind_owner(subject), "A worn pendant binds to its first owner")
	TEST_ASSERT_EQUAL(subject.fatness, 0, "The pendant conceals both ordinary and permanent weight")
	TEST_ASSERT_EQUAL(subject.fatness_real, 100, "Concealment preserves underlying ordinary weight")
	TEST_ASSERT_EQUAL(subject.fatness_perma, 30, "Concealment preserves underlying permanent weight")
	TEST_ASSERT_NULL(action.owner, "Binding removes the single-use action")
	TEST_ASSERT(pendant.icon_state in icon_states(pendant.icon), "Active sprinkled pendant has its source sprite")
	TEST_ASSERT(pendant.worn_icon_state in icon_states(pendant.worn_icon), "Active pendant has its source worn sprite")
	subject.adjust_fatness(20, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_EQUAL(subject.fatness, 0, "New weight is concealed while the binding remains active")
	TEST_ASSERT(subject.unequip_to(pendant, get_turf(subject)), "The pendant removes through the native inventory system")
	TEST_ASSERT_EQUAL(subject.fatness_real, 720, "Removal adds the source ordinary-weight penalty without rate scaling")
	TEST_ASSERT_EQUAL(subject.fatness_perma, 630, "Removal adds the source permanent-weight penalty")
	TEST_ASSERT_EQUAL(subject.fatness, 1350, "Removal restores all concealed weight")
	pendant.mori()
	TEST_ASSERT_EQUAL(subject.fatness, 1350, "Repeated cleanup cannot charge the penalty twice")
	subject.equip_to_slot_if_possible(pendant, ITEM_SLOT_NECK)
	TEST_ASSERT_NOT(pendant.bind_owner(subject), "The same body cannot bind to the pendant again")
	subject.unequip_to(pendant, get_turf(subject))
	var/mob/living/carbon/human/next_owner = allocate(/mob/living/carbon/human)
	next_owner.equip_to_slot_if_possible(pendant, ITEM_SLOT_NECK)
	TEST_ASSERT(pendant.bind_owner(next_owner), "Another body can use the same pendant")

/datum/game_test/room_test/gs13_memento_preferences/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
