/datum/game_test/room_test/gs13_fat_stun/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	TEST_ASSERT_NOT(subject.FatStun(5 SECONDS), "Timed weight stuns require the item preference")
	subject.gs13_preferences["weight_gain_items"] = TRUE
	subject.Stun(10 SECONDS)
	var/datum/status_effect/incapacitating/stun/gs13_fat/effect = subject.FatStun(5 SECONDS, fatAmount = 2)
	TEST_ASSERT_NOTNULL(effect, "A permitted weight stun creates a native status effect")
	TEST_ASSERT_EQUAL(subject.AmountFatStunned(), 5 SECONDS, "Weight stun retains its own duration")
	effect.tick()
	TEST_ASSERT_EQUAL(subject.fatness_real, 1, "Weight stun ticks apply the configured amount and rate")
	subject.FatStun(1 SECONDS)
	TEST_ASSERT_EQUAL(subject.AmountFatStunned(), 5 SECONDS, "Reapplying a shorter stun does not shorten it")
	qdel(effect)
	TEST_ASSERT(subject.IsStunned(), "Removing a weight stun preserves an independent ordinary stun")
	TEST_ASSERT(HAS_TRAIT(subject, TRAIT_IMMOBILIZED), "Ordinary stun movement blocking remains active")
	subject.SetStunned(0, TRUE)
	effect = subject.FatStun(5 SECONDS)
	SEND_SIGNAL(subject, COMSIG_LIVING_CLEAR_STUNS)
	TEST_ASSERT_NOT(subject.IsFatStunned(), "Native full-heal stun clearing removes the weight effect")
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_IMMOBILIZED), "Weight effect cleanup releases movement")
	effect = subject.FatStun(5 SECONDS)
	subject.gs13_preferences["weight_gain_items"] = FALSE
	effect.tick()
	TEST_ASSERT_NOT(subject.IsFatStunned(), "Disabling item effects releases an existing weight stun")

/datum/game_test/room_test/gs13_calorite_door/Run()
	var/obj/structure/mineral_door/calorite/door = allocate(/obj/structure/mineral_door/calorite)
	var/turf/doorway = get_turf(door)
	var/turf/outside = get_step(doorway, NORTH)
	TEST_ASSERT(door.state_open && !door.density && !door.opacity, "Calorite doors start fully open")
	TEST_ASSERT(door.icon_state in icon_states(door.icon), "Open door has a valid sprite")
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences = gs13_default_preferences()
	subject.gs13_preferences["master_wg_pref"] = TRUE
	subject.adjust_fatness(1000, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.forceMove(outside)
	subject.forceMove(doorway)
	TEST_ASSERT_NOT(subject.IsFatStunned(), "Doorway trapping respects the item preference")
	subject.gs13_preferences["weight_gain_items"] = TRUE
	subject.forceMove(outside)
	subject.forceMove(doorway)
	TEST_ASSERT_EQUAL(subject.AmountFatStunned(), 5 SECONDS, "Entering the door turf triggers the intermediate-weight delay")
	qdel(subject.IsFatStunned())
	subject.forceMove(outside)
	door.operate_update()
	TEST_ASSERT_NOT(door.CanAtmosPass(NORTH), "A closed calorite door seals its turf")
	TEST_ASSERT(door.density && door.opacity, "Closing updates collision and sight blocking together")
	door.operate_update()
	TEST_ASSERT(door.CanAtmosPass(NORTH), "Reopening the door restores atmospheric passage")
	subject.adjust_fatness(1100, FATTENING_TYPE_ALMIGHTY, TRUE)
	subject.forceMove(doorway)
	TEST_ASSERT_EQUAL(subject.AmountFatStunned(), 12 SECONDS, "The largest body stage uses the longer doorway delay")
	qdel(subject.IsFatStunned())
	subject.forceMove(outside)
	qdel(door)
	subject.forceMove(doorway)
	TEST_ASSERT_NOT(subject.IsFatStunned(), "Deleting the door unregisters its turf entry listener")

/datum/game_test/room_test/gs13_calorite_statue/Run()
