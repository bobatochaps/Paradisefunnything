/datum/game_test/room_test/gs13_skeletal_stomach_native_layouts/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.set_species(/datum/species/skeleton)
	var/obj/item/organ/internal/gs13_stomach/bone/bone = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	TEST_ASSERT(istype(bone), "The actual native skeleton layout supplies the reviewed source bone stomach")
	TEST_ASSERT_EQUAL(bone.gs13_digestive_efficiency, 0.025, "The bone stomach retains the source slow absorption coefficient")
	TEST_ASSERT(HAS_TRAIT(subject, TRAIT_NOHUNGER), "The native skeleton retains its existing hunger immunity")
	TEST_ASSERT_EQUAL(subject.get_gs13_ingestion_target(), bone, "Skeleton oral intake now follows its actual specialized organ")
	TEST_ASSERT(bone.icon_state in icon_states(bone.icon), "The bone organ uses its unchanged pinned source artwork")
	subject.set_species(/datum/species/plasmaman)
	var/obj/item/organ/internal/gs13_stomach/bone/plasmaman/crystal = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	TEST_ASSERT(istype(crystal), "The actual native Plasmaman layout supplies its source digestive crystal")
	TEST_ASSERT_EQUAL(crystal.gs13_digestive_efficiency, 0.06, "The crystal retains its separate source absorption coefficient")
	TEST_ASSERT(HAS_TRAIT(subject, TRAIT_NOHUNGER), "The native Plasmaman keeps species-owned hunger immunity")
	TEST_ASSERT(crystal.icon_state in icon_states(crystal.icon), "The crystal uses its unchanged pinned source artwork")
	subject.set_species(/datum/species/machine)
	TEST_ASSERT_NULL(subject.get_organ_slot(GS13_ORGAN_STOMACH), "An unadapted synthetic layout still cannot acquire an invented bone or organic stomach")
	subject.set_species(/datum/species/human)
	var/obj/item/organ/internal/gs13_stomach/ordinary = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	TEST_ASSERT_EQUAL(ordinary.type, /obj/item/organ/internal/gs13_stomach, "Returning to the ordinary native human restores its own digestive layout")
	TEST_ASSERT_NOT(HAS_TRAIT(subject, TRAIT_NOHUNGER), "Species changes release all former stomach-owned hunger traits")

/datum/game_test/room_test/gs13_skeletal_stomach_actual_absorption/Run()
	var/list/species_rates = list(/datum/species/skeleton = 1, /datum/species/plasmaman = 1.7)
	for(var/species_type in species_rates)
		var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
		subject.set_species(species_type)
		var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
		var/obj/item/reagent_containers/glass/beaker/supply = allocate(/obj/item/reagent_containers/glass/beaker)
		supply.reagents.add_reagent("gs13_ingestion_probe", 10, list("specialized" = TRUE))
		TEST_ASSERT_EQUAL(supply.reagents.gs13_ingest(subject, 10), 10, "The actual native oral route accepts a dose into specialized anatomy")
		TEST_ASSERT_EQUAL(subject.reagents.total_volume, 0, "Specialized species cannot bypass their physical digestive compartment")
		var/transferred = stomach.digest_gs13_reagents(2)
		TEST_ASSERT(abs(transferred - species_rates[species_type]) < 0.001, "Each physical subtype applies its source coefficient through real native transfer")
		TEST_ASSERT(abs(stomach.reagents.total_volume + subject.reagents.total_volume - 10) < 0.001, "Specialized absorption conserves the complete original dose")
		var/datum/reagent/received = subject.reagents.has_reagent("gs13_ingestion_probe")
		TEST_ASSERT(received.data["specialized"], "Specialized absorption retains original reagent data")
		TEST_ASSERT_EQUAL(subject.gs13_test_oral_exposure, 10, "Neither special anatomy nor absorption duplicates oral effects")

/datum/game_test/room_test/gs13_bone_stomach_native_transplant_traits/Run()
	var/mob/living/carbon/human/donor = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human)
	donor.set_species(/datum/species/skeleton)
	var/obj/item/organ/internal/gs13_stomach/bone/bone = donor.get_organ_slot(GS13_ORGAN_STOMACH)
	bone.remove(donor)
	bone.forceMove(get_turf(donor))
	TEST_ASSERT(HAS_TRAIT(donor, TRAIT_NOHUNGER), "Removing a bone stomach preserves the donor's independent native species trait")
	TEST_ASSERT_NOT(HAS_TRAIT(recipient, TRAIT_NOHUNGER), "The ordinary recipient begins without the organ's trait")
	var/obj/item/organ/internal/gs13_stomach/replaced = recipient.get_organ_slot(GS13_ORGAN_STOMACH)
	bone.insert(recipient)
	replaced.forceMove(get_turf(recipient))
	TEST_ASSERT(HAS_TRAIT(recipient, TRAIT_NOHUNGER), "Actual native bone-organ transplantation grants its source hunger trait")
	TEST_ASSERT_EQUAL(bone.gs13_digestive_efficiency, 0.025, "Transplantation preserves the actual donor organ's digestive rate")
	ADD_TRAIT(recipient, TRAIT_NOHUNGER, "gs13_test_independent_hunger")
	qdel(bone)
	TEST_ASSERT(HAS_TRAIT(recipient, TRAIT_NOHUNGER), "Deleting the transplant cannot remove an independently supplied trait")
	REMOVE_TRAIT(recipient, TRAIT_NOHUNGER, "gs13_test_independent_hunger")
	TEST_ASSERT_NOT(HAS_TRAIT(recipient, TRAIT_NOHUNGER), "Actual deletion releases the organ's own trait source")
	var/obj/item/organ/internal/gs13_stomach/bone/plasmaman/crystal = allocate(/obj/item/organ/internal/gs13_stomach/bone/plasmaman)
	crystal.insert(recipient)
	TEST_ASSERT_NOT(HAS_TRAIT(recipient, TRAIT_NOHUNGER), "The source crystal explicitly has no organ-owned hunger trait")
	TEST_ASSERT_EQUAL(crystal.owner, recipient, "The crystal remains a real independently transplantable native organ")
