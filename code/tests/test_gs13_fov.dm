/datum/game_test/room_test/gs13_fov_preferences_and_stages/Run()
	var/list/saved = gs13_sanitize_preferences(json_encode(list("low_fov" = 100.5)))
	TEST_ASSERT_EQUAL(saved["low_fov"], 100.5, "The field-of-view threshold survives the native JSON preference path")
	TEST_ASSERT_EQUAL(gs13_sanitize_preferences(list("low_fov" = -10))["low_fov"], 0, "Negative thresholds are disabled")
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 0, "Old saves default to unrestricted vision")
	var/datum/character_save/character = allocate(/datum/character_save)
	character.gs13_preferences = list("low_fov" = 100)
	character.apply_gs13_preferences(subject, FALSE)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 180, "A live preference edit activates the first stage at its exact threshold")
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_LOW_FOV, HELPLESSNESS_TRAIT), "The first stage is source-scoped")
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 270, "Twice the threshold narrows the clear view to ninety degrees")
	TEST_ASSERT_NOT(HAS_TRAIT_FROM(subject, TRAIT_LOW_FOV, HELPLESSNESS_TRAIT), "Stage-up clears the previous owned trait")
	TEST_ASSERT(HAS_TRAIT_FROM(subject, TRAIT_VERY_LOW_FOV, HELPLESSNESS_TRAIT), "Stage-up installs the stronger owned trait")
	subject.adjust_fatness(-1, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 180, "Losing weight restores the wider first stage")
	character.gs13_preferences["low_fov"] = 0
	character.apply_gs13_preferences(subject, FALSE)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 0, "Disabling the saved threshold immediately restores ordinary vision")
	TEST_ASSERT_NULL(subject.GetComponent(/datum/component/gs13_fov), "Removing the last source releases the controller")

/datum/game_test/room_test/gs13_fov_muscle_and_sources/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["low_fov"] = 100
	subject.gs13_preferences["muscle_gain"] = TRUE
	subject.add_fov_trait("independent", 90)
	subject.adjust_fatness(200, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 270, "The stronger weight restriction wins over an independent source")
	subject.adjust_muscle(1, TRUE)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 180, "Muscle relief immediately recalculates the stage")
	var/obj/item/bluespace_belt/belt = allocate(/obj/item/bluespace_belt)
	belt.forceMove(subject)
	belt.equipped(subject, ITEM_SLOT_BELT)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 90, "Concealment removes only the weight source")
	qdel(belt)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 180, "Removing concealment reinstates the weight source")
	ADD_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "independent")
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 90, "Immunity preserves independent vision restrictions")
	REMOVE_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "independent")
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 180, "Removing immunity restores the saved threshold")
	subject.fully_heal_fatness(TRUE, null, null)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 90, "Weight recovery preserves the independent source")
	subject.remove_fov_trait("independent")
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 0, "Removing the final source restores normal vision")
	TEST_ASSERT_NOT(subject.add_fov_trait(0, 180), "Invalid numeric source keys cannot corrupt a source list")
	TEST_ASSERT_NOT(subject.add_fov_trait("invalid", INFINITY), "Unsupported/nonfinite angles are rejected")

/datum/game_test/room_test/gs13_fov_cheeks_quirk/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.adjust_fatness(FATNESS_LEVEL_BLOB, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/datum/quirk/gs13_helplessness_cheeks/quirk = new
	quirk.apply_quirk_effects(subject)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 180, "Big Cheeks applies the source's first threshold")
	TEST_ASSERT_EQUAL(subject.get_face_name(), "Unknown", "The same source quirk also conceals the face")
	subject.adjust_fatness(FATNESS_LEVEL_BLOB, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 270, "The quirk narrows vision further at twice its source threshold")
	qdel(quirk)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 0, "Quirk removal restores the disabled character threshold")
	TEST_ASSERT_EQUAL(subject.get_face_name(), subject.real_name, "Quirk removal restores native face recognition")

/datum/game_test/room_test/gs13_fov_geometry/Run()
	var/turf/origin = locate(bottom_left.x + 3, bottom_left.y + 1, bottom_left.z)
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human, origin)
	subject.add_fov_trait("test", 180)
	for(var/direction in list(NORTH, SOUTH, EAST, WEST))
		subject.setDir(direction)
		var/turf/front = get_step(get_step(origin, direction), direction)
		var/turf/behind = get_step(get_step(origin, turn(direction, 180)), turn(direction, 180))
		TEST_ASSERT(subject.in_fov(front), "The forward direction is in the clear view")
		TEST_ASSERT_NOT(subject.in_fov(behind), "The rear direction is in the impaired view")
		TEST_ASSERT(subject.in_fov(get_step(origin, turn(direction, 180))), "The source's nearby 3x3 area stays clear")
	subject.setDir(NORTH)
	subject.add_fov_trait("test", 270)
	var/turf/northeast = locate(origin.x + 2, origin.y + 2, origin.z)
	TEST_ASSERT_NOT(subject.in_fov(northeast), "The stronger cone excludes its exact forty-five-degree boundary")
	subject.setDir(NORTHEAST)
	TEST_ASSERT(subject.in_fov(northeast), "Angular checks support a diagonal facing")
	subject.setDir(NORTH)
	subject.add_fov_trait("test", -90)
	TEST_ASSERT(subject.in_fov(get_step(get_step(origin, SOUTH), SOUTH)), "Reverse cones can keep a clear rear view")
	TEST_ASSERT_NOT(subject.in_fov(get_step(get_step(origin, NORTH), NORTH)), "A reverse cone excludes the front")
	subject.remove_fov_trait("test")
	ADD_TRAIT(subject, TRAIT_NEARSIGHT, "independent")
	TEST_ASSERT_NOT(subject.in_fov(northeast), "Uncorrected native nearsightedness is considered by the angular helper")
	var/obj/item/clothing/glasses/regular/glasses = allocate(/obj/item/clothing/glasses/regular)
	subject.equip_to_slot_if_possible(glasses, ITEM_SLOT_EYES)
	TEST_ASSERT(subject.in_fov(northeast), "Native prescription glasses correct nearsightedness for the helper")
	ADD_TRAIT(subject, TRAIT_BLIND, "independent")
	TEST_ASSERT_NOT(subject.in_fov(origin), "Native blindness takes priority")
	TEST_ASSERT(subject.in_fov(subject, ignore_self = TRUE), "The explicit source self exception is retained")
	TEST_ASSERT_NOT(subject.in_fov(null), "A missing target cannot cause a runtime")

/datum/game_test/room_test/gs13_fov_render_pipeline/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.add_fov_trait("test", 180)
	var/datum/component/gs13_fov/controller = subject.GetComponent(/datum/component/gs13_fov)
	var/datum/hud/hud = allocate(/datum/hud, subject)
	var/atom/movable/screen/plane_master/game = hud.plane_masters["[GAME_PLANE]"]
	var/atom/movable/screen/plane_master/emissive = hud.plane_masters["[EMISSIVE_PLANE]"]
	var/original_target = game.render_target
	var/emissive_target = emissive.render_target
	game.add_filter("independent", 1, outline_filter(size = 1))
	TEST_ASSERT(controller.build_pipeline(hud), "The adapter builds against real native HUD plane masters")
	TEST_ASSERT(length(game.render_target), "A visible native plane exports its appearance for composition")
	TEST_ASSERT_NOT(copytext(game.render_target, 1, 2) == "*", "The native plane continues drawing normally")
	TEST_ASSERT_NOTNULL(game.get_filter("independent"), "Native plane filters remain intact")
	TEST_ASSERT_EQUAL(emissive.render_target, emissive_target, "Native emissive render targets remain intact")
	TEST_ASSERT_NOTNULL(controller.peripheral.get_filter("gs13_fov_blur"), "The peripheral copy uses the source blur")
	TEST_ASSERT_NOTNULL(controller.peripheral.get_filter("gs13_fov_color"), "The peripheral copy uses the source color matrix")
	TEST_ASSERT_NOTNULL(controller.peripheral.get_filter("gs13_fov_mask"), "The original mask selects the affected pixels")
	TEST_ASSERT(controller.peripheral.plane > BYOND_LIGHTING_PLANE && controller.peripheral.plane < FULLSCREEN_PLANE, "Peripheral rendering stays above the world and below fullscreens and HUD")
	var/list/owned = controller.render_objects.Copy()
	controller.clear_rendering()
	TEST_ASSERT_EQUAL(game.render_target, original_target, "Cleanup restores the native render target")
	TEST_ASSERT_NOTNULL(game.get_filter("independent"), "Cleanup preserves unrelated native filters")
	for(var/datum/object as anything in owned)
		TEST_ASSERT(QDELETED(object), "Every private render object is deleted")
	TEST_ASSERT_EQUAL(length(controller.render_objects), 0, "Cleanup clears retained render references")
	TEST_ASSERT(controller.build_pipeline(hud), "The same HUD can be rebound after cleanup")
	game.render_target = "independent_replacement"
	controller.clear_rendering()
	TEST_ASSERT_EQUAL(game.render_target, "independent_replacement", "Cleanup does not overwrite a subsequently replaced render target")

/datum/game_test/room_test/gs13_fov_mask_and_hud_lifecycle/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.add_fov_trait("test", 180)
	var/datum/component/gs13_fov/controller = subject.GetComponent(/datum/component/gs13_fov)
	var/datum/hud/hud = allocate(/datum/hud, subject)
	controller.build_pipeline(hud)
	controller.update_mask(SOUTH, "19x15")
	TEST_ASSERT_EQUAL(controller.mask.icon_state, "180", "The first stage selects the original hemisphere mask")
	TEST_ASSERT_EQUAL(controller.mask.dir, SOUTH, "The mask uses native direction frames")
	var/matrix/scale = matrix(controller.mask.transform)
	TEST_ASSERT(abs(scale.a - 19 / 15) < 0.001 && abs(scale.e - 1) < 0.001, "Rectangular viewports retain their independent axis scales")
	TEST_ASSERT_EQUAL(scale.c, 64, "The wider viewport is recentered using the source pixel offset")
	subject.setDir(WEST)
	TEST_ASSERT_EQUAL(controller.mask.dir, WEST, "An actual native direction change updates the mask immediately")
	var/list/owned = controller.render_objects.Copy()
	qdel(hud)
	TEST_ASSERT_NULL(controller.bound_hud, "HUD deletion releases the bound HUD")
	for(var/datum/object as anything in owned)
		TEST_ASSERT(QDELETED(object), "HUD deletion releases all private render objects")
	var/datum/hud/replacement = allocate(/datum/hud, subject)
	TEST_ASSERT(controller.build_pipeline(replacement), "A rebuilt HUD can install a fresh pipeline")
	controller.angle = 270
	controller.update_mask(EAST, 7)
	TEST_ASSERT_EQUAL(controller.mask.icon_state, "270", "The stronger stage selects the original narrow-view mask")
	TEST_ASSERT(controller.mask.icon_state in icon_states(controller.mask.icon), "The source mask artwork is packaged")
	qdel(controller)
	TEST_ASSERT_NULL(subject.GetComponent(/datum/component/gs13_fov), "Controller deletion clears the native component registry")

/datum/game_test/room_test/gs13_fov_perspective_and_death/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.gs13_preferences["low_fov"] = 100
	subject.add_fov_trait("independent", 90)
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	var/datum/component/gs13_fov/controller = subject.GetComponent(/datum/component/gs13_fov)
	TEST_ASSERT(controller.should_mask(subject), "A body-centered view receives its restriction")
	var/obj/structure/closet/container = allocate(/obj/structure/closet, subject.loc)
	subject.forceMove(container)
	TEST_ASSERT(controller.should_mask(container), "The source outermost-container viewpoint receives its restriction")
	var/obj/item/camera/remote = allocate(/obj/item/camera)
	TEST_ASSERT_NOT(controller.should_mask(remote), "A remote camera is not restricted by the body's facing")
	subject.death()
	TEST_ASSERT_NOT(controller.should_mask(container), "The native dead state suppresses the mask")
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 90, "Death clears the weight source while preserving an independent source")
	subject.update_revive()
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 180, "Revival reapplies the body's saved threshold")
	TEST_ASSERT(controller.should_mask(container), "The revived body can receive its mask again")
	var/mob/living/carbon/human/other = allocate(/mob/living/carbon/human)
	other.add_fov_trait("other", 270)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 180, "Separate bodies do not share mutable source lists")
	qdel(subject)
	TEST_ASSERT(QDELETED(controller), "Body deletion releases its controller")
	TEST_ASSERT_EQUAL(other.gs13_fov_angle(), 270, "Deleting one body does not alter another body's source")

/datum/game_test/room_test/gs13_fov_server_threshold
	var/list/old_forced

/datum/game_test/room_test/gs13_fov_server_threshold/Destroy()
	if(old_forced)
		GLOB.configuration.gs13.forced_helplessness = old_forced
	return ..()

/datum/game_test/room_test/gs13_fov_server_threshold/Run()
	old_forced = GLOB.configuration.gs13.forced_helplessness
	GLOB.configuration.gs13.forced_helplessness = old_forced.Copy()
	GLOB.configuration.gs13.load_data(list("forced_helplessness" = list("low_fov" = 100)))
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 180, "A forced threshold with a disabled character setting starts at the first stage")
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 270, "The forced threshold supplies a real second-stage boundary")
	subject.fully_heal_fatness(TRUE, null, null)
	subject.gs13_preferences["low_fov"] = 50
	subject.adjust_fatness(100, FATTENING_TYPE_ALMIGHTY, TRUE)
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 270, "Server forcing cannot weaken a stricter voluntarily selected threshold")
	ADD_TRAIT(subject, TRAIT_NO_HELPLESSNESS, "independent")
	TEST_ASSERT_EQUAL(subject.gs13_fov_angle(), 0, "Hydraulic-style immunity also overrides forced peripheral restriction")
