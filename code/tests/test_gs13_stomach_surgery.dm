/datum/game_test/room_test/gs13_stomach_native_surgical_recovery/Run()
	var/mob/living/carbon/human/surgeon = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/donor = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/gs13_stomach/stomach = donor.get_organ_slot(GS13_ORGAN_STOMACH)
	stomach.remove(donor)
	stomach.forceMove(get_turf(surgeon))
	stomach.receive_damage(10, TRUE)
	var/obj/item/coin/silver/coin = allocate(/obj/item/coin/silver)
	stomach.consume_gs13_item(coin)
	var/obj/item/scalpel/scalpel = allocate(/obj/item/scalpel)
	surgeon.put_in_active_hand(scalpel)
	TEST_ASSERT_EQUAL(stomach.item_interaction(surgeon, scalpel, list()), ITEM_INTERACT_COMPLETE, "The ordinary native scalpel interaction performs the actual timed incision")
	TEST_ASSERT_EQUAL(coin.loc, get_turf(stomach), "Opening the extracted stomach recovers its same physical item")
	TEST_ASSERT_EQUAL(stomach.damage, 60, "The source incision adds half maximum health to preexisting native injury")
	TEST_ASSERT_EQUAL(stomach.gs13_cut_open_damage, 50, "Only the actual incision damage is tracked as cauterizable")
	stomach.item_interaction(surgeon, scalpel, list())
	TEST_ASSERT_EQUAL(stomach.damage, 60, "A second scalpel action cannot duplicate an open incision")
	surgeon.drop_item_to_ground(scalpel)
	var/obj/item/cautery/cautery = allocate(/obj/item/cautery)
	surgeon.put_in_active_hand(cautery)
	TEST_ASSERT_EQUAL(stomach.item_interaction(surgeon, cautery, list()), ITEM_INTERACT_COMPLETE, "The ordinary native cautery follows the actual timed closure path")
	TEST_ASSERT_EQUAL(stomach.gs13_cut_open_damage, 0, "Successful native cautery closes the incision")
	TEST_ASSERT_EQUAL(stomach.damage, 10, "Closing an incision cannot heal unrelated preexisting injury")

/datum/game_test/room_test/gs13_stomach_incision_native_healing/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/gs13_stomach/stomach = subject.get_organ_slot(GS13_ORGAN_STOMACH)
	stomach.receive_damage(70, TRUE)
	stomach.gs13_cut_open_damage = 50
	stomach.heal_internal_damage(20)
	TEST_ASSERT_EQUAL(stomach.damage, 50, "Native organ repair changes actual tissue damage")
	TEST_ASSERT_EQUAL(stomach.gs13_cut_open_damage, 30, "Ordinary native repair prioritizes the source incision")
	subject.satiety = GS13_MAX_SATIETY
	stomach.heal_gs13_tissue(2)
	TEST_ASSERT(abs(stomach.gs13_cut_open_damage - 29.5) < 0.001, "Source passive tissue recovery also closes the actual incision")
	var/obj/item/stack/medical/bruise_pack/advanced/membrane = allocate(/obj/item/stack/medical/bruise_pack/advanced)
	var/datum/surgery_step/internal/manipulate_organs/mend/treatment = allocate(/datum/surgery_step/internal/manipulate_organs/mend)
	treatment.end_step(subject, subject, BODY_ZONE_CHEST, membrane)
	TEST_ASSERT_EQUAL(stomach.damage, 0, "Actual native internal-organ mending still repairs all ordinary damage")
	TEST_ASSERT_EQUAL(stomach.gs13_cut_open_damage, 0, "Native surgery cannot leave a phantom open incision after healing")
	stomach.receive_damage(stomach.max_damage, TRUE)
	stomach.gs13_cut_open_damage = 50
	stomach.heal_internal_damage(50)
	TEST_ASSERT(stomach.status & ORGAN_DEAD, "Incision closure cannot bypass native necrotic-organ treatment")
	stomach.rejuvenate()
	TEST_ASSERT_EQUAL(stomach.gs13_cut_open_damage, 0, "Actual native rejuvenation clears the complete wound state")
	TEST_ASSERT_NOT(stomach.status & ORGAN_DEAD, "Native rejuvenation remains the owner of organ revival")

/datum/game_test/room_test/gs13_stomach_surgery_interruption/Run()
	var/mob/living/carbon/human/surgeon = allocate(/mob/living/carbon/human)
	var/obj/item/organ/internal/gs13_stomach/stomach = allocate(/obj/item/organ/internal/gs13_stomach)
	var/obj/item/coin/silver/coin = allocate(/obj/item/coin/silver)
	stomach.consume_gs13_item(coin)
	var/obj/item/scalpel/scalpel = allocate(/obj/item/scalpel)
	surgeon.put_in_active_hand(scalpel)
	addtimer(CALLBACK(surgeon, TYPE_PROC_REF(/mob, drop_item_to_ground), scalpel), 1 SECONDS)
	stomach.item_interaction(surgeon, scalpel, list())
	TEST_ASSERT_EQUAL(stomach.gs13_cut_open_damage, 0, "A real interrupted timed action cannot complete the incision")
	TEST_ASSERT_EQUAL(stomach.damage, scalpel.force, "Interrupted native surgery retains the source tool-force injury")
	TEST_ASSERT_EQUAL(coin.loc, stomach, "An interrupted opening cannot release its retained object")
	var/obj/item/organ/internal/gs13_stomach/replaced = surgeon.get_organ_slot(GS13_ORGAN_STOMACH)
	stomach.insert(surgeon)
	replaced.forceMove(get_turf(surgeon))
	surgeon.put_in_active_hand(scalpel)
	var/before = stomach.damage
	stomach.item_interaction(surgeon, scalpel, list())
	TEST_ASSERT_EQUAL(stomach.damage, before, "The extracted-organ interaction cannot operate on an installed stomach")
	TEST_ASSERT_EQUAL(coin.loc, surgeon, "The physical transplant still carries its retained contents")
